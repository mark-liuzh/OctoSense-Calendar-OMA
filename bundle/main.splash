        // ══ 周视图（focus 所在那一周，7 行）══════════════════════════
        // 高度 314 = 7 × 44 + 6 × 1，与月视图的 317 只差 3px，切换时几乎看不出位移。
        // ⚠️ 7 行**手写**，不用循环：on_render 里建出来的按钮点击不重绑（踩过），
        //    而周视图每行都要能点（点了切到日视图）。
        cv_week := RoundedView{width: Fill height: 314.0 flow: Down spacing: 1.0
            align: Align{x: 0.0 y: 0.0} draw_bg +: {color: c_line2}
            RoundedView{width: Fill height: 44.0 flow: Right spacing: 6 align: Align{x: 0.0 y: 0.5}
                padding: Inset{left: 6 right: 6} draw_bg +: {color: c_card}
                wk_b0 := ButtonFlat{text: "周一" width: 44.0 height: 28.0 padding: Inset{left: 0 right: 0}
                    on_click: || week_pick(0)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_accent_s color_down: c_accent_s
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_accent color_down: c_accent color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                wk_d0 := Label{text: "" width: 52.0 draw_text.color: c_ink3
                    draw_text.text_style: theme.font_code{font_size: 11}}
                wk_s0 := Label{text: "" width: Fill draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 11}}
                wk_t0 := Label{text: "" width: Fit draw_text.color: c_accent
                    draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            RoundedView{width: Fill height: 44.0 flow: Right spacing: 6 align: Align{x: 0.0 y: 0.5}
                padding: Inset{left: 6 right: 6} draw_bg +: {color: c_card}
                wk_b1 := ButtonFlat{text: "周二" width: 44.0 height: 28.0 padding: Inset{left: 0 right: 0}
                    on_click: || week_pick(1)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_accent_s color_down: c_accent_s
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_accent color_down: c_accent color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                wk_d1 := Label{text: "" width: 52.0 draw_text.color: c_ink3
                    draw_text.text_style: theme.font_code{font_size: 11}}
                wk_s1 := Label{text: "" width: Fill draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 11}}
                wk_t1 := Label{text: "" width: Fit draw_text.color: c_accent
                    draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            RoundedView{width: Fill height: 44.0 flow: Right spacing: 6 align: Align{x: 0.0 y: 0.5}
                padding: Inset{left: 6 right: 6} draw_bg +: {color: c_card}
                wk_b2 := ButtonFlat{text: "周三" width: 44.0 height: 28.0 padding: Inset{left: 0 right: 0}
                    on_click: || week_pick(2)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_accent_s color_down: c_accent_s
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_accent color_down: c_accent color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                wk_d2 := Label{text: "" width: 52.0 draw_text.color: c_ink3
                    draw_text.text_style: theme.font_code{font_size: 11}}
                wk_s2 := Label{text: "" width: Fill draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 11}}
                wk_t2 := Label{text: "" width: Fit draw_text.color: c_accent
                    draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            RoundedView{width: Fill height: 44.0 flow: Right spacing: 6 align: Align{x: 0.0 y: 0.5}
                padding: Inset{left: 6 right: 6} draw_bg +: {color: c_card}
                wk_b3 := ButtonFlat{text: "周四" width: 44.0 height: 28.0 padding: Inset{left: 0 right: 0}
                    on_click: || week_pick(3)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_accent_s color_down: c_accent_s
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_accent color_down: c_accent color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                wk_d3 := Label{text: "" width: 52.0 draw_text.color: c_ink3
                    draw_text.text_style: theme.font_code{font_size: 11}}
                wk_s3 := Label{text: "" width: Fill draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 11}}
                wk_t3 := Label{text: "" width: Fit draw_text.color: c_accent
                    draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            RoundedView{width: Fill height: 44.0 flow: Right spacing: 6 align: Align{x: 0.0 y: 0.5}
                padding: Inset{left: 6 right: 6} draw_bg +: {color: c_card}
                wk_b4 := ButtonFlat{text: "周五" width: 44.0 height: 28.0 padding: Inset{left: 0 right: 0}
                    on_click: || week_pick(4)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_accent_s color_down: c_accent_s
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_accent color_down: c_accent color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                wk_d4 := Label{text: "" width: 52.0 draw_text.color: c_ink3
                    draw_text.text_style: theme.font_code{font_size: 11}}
                wk_s4 := Label{text: "" width: Fill draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 11}}
                wk_t4 := Label{text: "" width: Fit draw_text.color: c_accent
                    draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            RoundedView{width: Fill height: 44.0 flow: Right spacing: 6 align: Align{x: 0.0 y: 0.5}
                padding: Inset{left: 6 right: 6} draw_bg +: {color: c_card}
                wk_b5 := ButtonFlat{text: "周六" width: 44.0 height: 28.0 padding: Inset{left: 0 right: 0}
                    on_click: || week_pick(5)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_accent_s color_down: c_accent_s
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_accent color_down: c_accent color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                wk_d5 := Label{text: "" width: 52.0 draw_text.color: c_ink3
                    draw_text.text_style: theme.font_code{font_size: 11}}
                wk_s5 := Label{text: "" width: Fill draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 11}}
                wk_t5 := Label{text: "" width: Fit draw_text.color: c_accent
                    draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            RoundedView{width: Fill height: 44.0 flow: Right spacing: 6 align: Align{x: 0.0 y: 0.5}
                padding: Inset{left: 6 right: 6} draw_bg +: {color: c_card}
                wk_b6 := ButtonFlat{text: "周日" width: 44.0 height: 28.0 padding: Inset{left: 0 right: 0}
                    on_click: || week_pick(6)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_accent_s color_down: c_accent_s
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_accent color_down: c_accent color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                wk_d6 := Label{text: "" width: 52.0 draw_text.color: c_ink3
                    draw_text.text_style: theme.font_code{font_size: 11}}
                wk_s6 := Label{text: "" width: Fill draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 11}}
                wk_t6 := Label{text: "" width: Fit draw_text.color: c_accent
                    draw_text.text_style: theme.font_regular{font_size: 10}}
            }
        }

        // ══ 日视图（focus 那一天的详情）══════════════════════════════
        cv_day := RoundedView{width: Fill height: 317.0 flow: Down align: Align{x: 0.0 y: 0.0}
            padding: Inset{left: 4 right: 4 top: 8} draw_bg +: {color: c_card}
            RoundedView{width: Fill height: Fit flow: Right spacing: 8 draw_bg +: {color: c_card}
                day_title := Label{text: "" draw_text.color: c_ink
                    draw_text.text_style: theme.font_bold{font_size: 18}}
                day_sub := Label{width: Fill text: "" align: Align{x: 0.0 y: 0.5} draw_text.color: c_ink3
                    draw_text.text_style: theme.font_regular{font_size: 11}}
            }
            day_stat := Label{width: Fill text: "" draw_text.color: c_ink2
                draw_text.text_style: theme.font_regular{font_size: 11}}
            Hr{draw_bg +: {color: c_line border_size: 0.0 height: 1.0}}
            day_ev0 := Label{width: Fill text: "" draw_text.color: c_ink
                draw_text.text_style: theme.font_regular{font_size: 12}}
            day_ev1 := Label{width: Fill text: "" draw_text.color: c_ink
                draw_text.text_style: theme.font_regular{font_size: 12}}
            day_ev2 := Label{width: Fill text: "" draw_text.color: c_ink
                draw_text.text_style: theme.font_regular{font_size: 12}}
            day_ev3 := Label{width: Fill text: "" draw_text.color: c_ink
                draw_text.text_style: theme.font_regular{font_size: 12}}
            day_more := Label{width: Fill text: "" draw_text.color: c_ink3
                draw_text.text_style: theme.font_regular{font_size: 10}}
            RoundedView{width: Fill height: Fit flow: Right spacing: 8 padding: Inset{top: 8}
                draw_bg +: {color: c_card}
                ButtonFlat{text: "写日程" height: 28.0 padding: Inset{left: 12 right: 12} on_click: || new_here()
                    draw_bg +: {border_radius: 7.0 color: c_ink color_hover: #x000000 color_down: #x333333
                        color_focus: c_ink border_size: 1.0 border_color: c_ink border_color_focus: c_ink}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff
                        text_style: theme.font_regular{font_size: 11}}}
                ButtonFlat{text: "记待办" height: 28.0 padding: Inset{left: 12 right: 12} on_click: || set_tab(1)
                    draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                ButtonFlat{text: "记心情" height: 28.0 padding: Inset{left: 12 right: 12} on_click: || set_tab(2)
                    draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                Label{width: Fill text: "" draw_text.color: c_ink3}
            }
        }

        // ══ 节假日说明行 ═══════════════════════════════════════
        // 设计稿没有这一行，补它是因为「中国日历看不到放假安排」是硬伤：
        // 格子上只有绿点/「班」字，说不出「放几天、哪天要补班、是什么节」。
        //
        // ⚠️⚠️ 血泪（2026-09-30）：最初这是**单行 on_render**，把「节日 + 放假安排」
        //    拼成一条 Label。切到「全部」时整串变成
        //    「国庆 10/1 · 万圣节 10/31 · 放假 7 天 · 10/10 上班」≈ 452px，
        //    可用宽度只有 ≈359px → Label 自己折行，而容器是**固定 42px**，
        //    第二行的「班」字被直接裁掉（截图可见半个字）。
        //    改成**静态两行**：节日一行、放假安排一行，各自都放得下；
        //    第二行没有内容时用 set_visible(false) 整行让位（隐藏的 widget 不占空间）。
        //    顺带丢掉 on_render —— 少一处「必须记得 render()」的坑。
        fest_bar := RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 2 bottom: 2}
            draw_bg +: {color: c_card}
            // ── 第一行：当月节日 ──
            RoundedView{width: Fill height: 22.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                // 小绿点与格子里的「放假」标记同色同形，起图例作用
                CircleView{width: 5.0 height: 5.0 margin: Inset{top: 8}
                    draw_bg +: {color: c_ok border_radius: 0.0}}
                fest_line := Label{width: Fill text: "" align: Align{x: 0.0 y: 0.5}
                    draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 11}}
            }
            // ── 第二行：放假 / 调休安排（无内容时整行让位）──
            fest_row2 := RoundedView{width: Fill height: 22.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                CircleView{width: 5.0 height: 5.0 margin: Inset{top: 8}
                    draw_bg +: {color: c_warn border_radius: 0.0}}
                fest_line2 := Label{width: Fill text: "" align: Align{x: 0.0 y: 0.5}
                    draw_text.color: c_ink2 draw_text.text_style: theme.font_regular{font_size: 11}}
            }
        }
    }

    // ══ 工具条 .tools{padding:12px 20px gap:8} ═══════════════
    // 设计稿只有：导入(主) + 导出(ghost) + 计数(右)
    // ★ 2026-10-01：加 id 是为了「只在『日程』分区显示」——
    //   导入/导出是日程的数据出入口，切到待办/心情/目标/彩蛋时它不该在。
    tools := RoundedView{width: Fill height: Fit flow: Right spacing: 8 padding: Inset{left: 20 right: 20 top: 12 bottom: 12}
        draw_bg +: {color: c_paper}
        // ★ 2026-09-30 新增：最左「+ 新建」用主色。
        //   为什么把主位从「导入」让给它：「在这天写我要做什么」是现在最高频的动作，
        //   而导入是**一次性**的外部数据入口（导入完就不再用）。
        //   三个按钮的总宽 ≈ 72+72+82 + 16 间距 = 242，可用宽 372，装得下。
        ButtonFlat{text: "+ 新建" height: H_TAP padding: Inset{left: 14 right: 14} on_click: || toggle_new()
            draw_bg +: {border_radius: 8.0 color: c_ink color_hover: #x000000 color_down: #x333333
                color_focus: c_ink border_size: 1.0 border_color: c_ink border_color_focus: c_ink}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
        // .btn-primary{background:ink;color:#fff;border-color:ink}  .btn .ic{mono 11px;opacity .75}
        ButtonFlat{text: "↑ 导入" height: H_TAP padding: Inset{left: 14 right: 14} on_click: || toggle_import()
            draw_bg +: {border_radius: 8.0 color: c_card color_hover: c_paper color_down: c_paper
                color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
            draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3}}
        // .btn-ghost{background:card;color:ink2;border-color:line2}
        ButtonFlat{text: "↓ 导出" height: H_TAP padding: Inset{left: 14 right: 14} on_click: || export_to_entry()
            draw_bg +: {border_radius: 8.0 color: c_card color_hover: c_paper color_down: c_paper
                color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
            draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3}}
        Label{width: Fill text: "" draw_text.color: c_ink3}
        // .tool-count{11px mono ink3}
        cnt := RoundedView{width: Fit height: H_TAP flow: Right align: Align{x: 1.0 y: 0.5}
            draw_bg +: {color: c_paper}
            on_render: || {
                Label{text: "" + display_list().len() + " / " + ("" + events.len())
                    draw_text.color: c_ink3 draw_text.text_style: theme.font_code{font_size: 11}}
            }
        }
    }

    // ══ 待办分区（2026-10-01 新增）══════════════════════════════
    // ⚠️ 6 个槽位**静态声明**（on_render 里建出来的按钮点击不重绑，本项目踩过两次），
    //    槽位不够时用 set_visible(false) 整行让位 —— 隐藏的 widget 不占空间。
    //    溢出条数写在 todo_more_l 里，不让用户以为「只有 6 条」。
    sec_todo := RoundedView{width: Fill height: Fit flow: Down
        draw_bg +: {color: c_paper}
        RoundedView{width: Fill height: Fit flow: Down spacing: 6
            padding: Inset{left: 20 right: 20 top: 4 bottom: 10} draw_bg +: {color: c_card}
            RoundedView{width: Fill height: Fit flow: Right spacing: 8 draw_bg +: {color: c_card}
                Label{text: "待办清单" draw_text.color: c_ink
                    draw_text.text_style: theme.font_bold{font_size: 15}}
                Label{width: Fill text: "" draw_text.color: c_ink3}
                todo_where := Label{text: "" draw_text.color: c_accent
                    draw_text.text_style: theme.font_regular{font_size: 11}}
            }
            todo_stat := Label{width: Fill text: "" draw_text.color: c_ink2
                draw_text.text_style: theme.font_regular{font_size: 11}}
            RoundedView{width: Fill height: 38.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                todo_in := TextInput{width: Fill height: 34 empty_text: "要做什么？例如「交作品集」"
                    draw_bg +: {color: c_card color_hover: c_card color_focus: c_card color_empty: c_card
                        border_radius: 8.0 border_size: 1.0 border_color: c_line2}
                    draw_text +: {color: c_ink color_hover: c_ink color_focus: c_ink
                        color_empty: c_ink3 color_empty_hover: c_ink3}}
                ButtonFlat{text: "添加" height: 30.0 padding: Inset{left: 14 right: 14} on_click: || todo_add()
                    draw_bg +: {border_radius: 7.0 color: c_ink color_hover: #x000000 color_down: #x333333
                        color_focus: c_ink border_size: 1.0 border_color: c_ink border_color_focus: c_ink}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff
                        text_style: theme.font_regular{font_size: 12}}}
            }
            RoundedView{width: Fill height: 26.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                todo_filter := ButtonFlat{text: "全部" height: 24.0 padding: Inset{left: 10 right: 10}
                    on_click: || toggle_only_open()
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                todo_more_l := Label{width: Fill text: "" draw_text.color: c_ink3
                    draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            todo_row0 := RoundedView{width: Fill height: 32.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                td_b0 := ButtonFlat{text: "[ ]" width: 38.0 height: 26.0 padding: Inset{left: 0 right: 0}
                    on_click: || todo_toggle(0)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink3 color_hover: c_accent color_down: c_accent color_focus: c_ink3
                        text_style: theme.font_code{font_size: 12}}}
                td_t0 := Label{width: Fill text: "" draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 12}}
                td_x0 := ButtonFlat{text: "删除" height: 26.0 padding: Inset{left: 10 right: 10}
                    on_click: || todo_del(0)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: #xfdecec color_down: #xfdecec
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: #xb91c1c color_hover: #xb91c1c color_down: #xb91c1c color_focus: #xb91c1c
                        text_style: theme.font_regular{font_size: 11}}}
            }
            todo_row1 := RoundedView{width: Fill height: 32.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                td_b1 := ButtonFlat{text: "[ ]" width: 38.0 height: 26.0 padding: Inset{left: 0 right: 0}
                    on_click: || todo_toggle(1)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink3 color_hover: c_accent color_down: c_accent color_focus: c_ink3
                        text_style: theme.font_code{font_size: 12}}}
                td_t1 := Label{width: Fill text: "" draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 12}}
                td_x1 := ButtonFlat{text: "删除" height: 26.0 padding: Inset{left: 10 right: 10}
                    on_click: || todo_del(1)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: #xfdecec color_down: #xfdecec
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: #xb91c1c color_hover: #xb91c1c color_down: #xb91c1c color_focus: #xb91c1c
                        text_style: theme.font_regular{font_size: 11}}}
            }
            todo_row2 := RoundedView{width: Fill height: 32.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                td_b2 := ButtonFlat{text: "[ ]" width: 38.0 height: 26.0 padding: Inset{left: 0 right: 0}
                    on_click: || todo_toggle(2)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink3 color_hover: c_accent color_down: c_accent color_focus: c_ink3
                        text_style: theme.font_code{font_size: 12}}}
                td_t2 := Label{width: Fill text: "" draw_text.color: c_ink
                    draw_text.text_style: theme.font_regular{font_size: 12}}
                td_x2 := ButtonFlat{text: "删除" height: 26.0 padding: Inset{left: 10 right: 10}
                    on_click: || todo_del(2)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: #xfdecec color_down: #xfdecec
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: #xb91c1c color_hover: #xb91c1c color_down: #xb91c1c color_focus: #xb91c1c
                        text_style: theme.font_regular{font_size: 11}}}
            }
            todo_row3 := RoundedView{width: Fill height: 32.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                td_b3 := ButtonFlat{text: "[ ]" width: 38.0 height: 26.0 padding: Inset{left: 0 right: 0}
                    on_click: || todo_toggle(3)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink3 color_hover: c_accent color_down: c_accent color_focus: c_ink3
                        text_style: theme.font_code{font_size: 12}}}
                td_t3 := Label{width: Fill text: "" draw_text.color: c_ink
