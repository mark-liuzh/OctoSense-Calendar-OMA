// OctoSense 日历 · ICS 导入 / 导出 · 队伍 OMA
//
// 功能：把其他日历（Google / Apple / Outlook / 飞书）导出的 .ics 粘进来，
//       解析 → 预览 → 合并进本地事件库；也能把本地事件导出成 .ics 带走。
//
// 设计要点（详见 docs/ics-import-export-design.md）：
//   - 只申请 storage 一个能力，全程离线，不联网
//   - 解析分块续跑：单 handler 200000 指令 / 64ms 是双限，大文件不能一口气解析
//   - UID + SEQUENCE 去重：重复导入幂等；SEQUENCE 变大视为改期
//
// ⚠️ API 用法逐条核对过源码（makepad/platform/script/{src/string.rs,test/src/main.rs}）：
//   - 全局替换是 s.replace(regex(p,"g"), r)，**不是** regex(p,"g").replace_all(s,r)
//   - 没有字符串切片，取子串用 to_chars()
//   - to_f64 失败返回 NaN（不是 nil），必须 `if v >= 0` 正面守卫
//   - 单数无 sort/map/filter/join/slice，全部手写 for
//
// ⚠️⚠️ 画背景**必须**用 RoundedView / CircleView / SolidView，**不能用 View**
//     （血泪，2026-09-30 才发现，此前全项目所有「用 View 画背景」的地方都是白干）：
//       makepad 里 `View = ViewBase {}`（widgets/src/view_ui.rs:5），
//       **既没有 `show_bg: true`，也没有带 `pixel` 的 `draw_bg`**。
//       所以 `View{... draw_bg +: {color: c_ok}}` 只是往一个永远不绘制的 shader
//       上写了个颜色 —— 一个像素都不画，且**不报错、布局树里照样有尺寸**，
//       极难发现。之前没被发现是因为这个设计几乎单色（大量 c_card/c_paper
//       白底画在白纸上，画不出来也看不出来）。
//     正确选择：
//       · `RoundedView`  —— 通用（color / border_radius / border_size /
//                           border_color 全支持，无阴影）
//       · `CircleView`   —— 圆点。**border_radius 必须归 0**，
//                           radius<=0 才会自动取 min(w,h)/2；写 2.0/2.5
//                           会让半径 ≥ 半边长，圆角矩形直接退化消失。
//       · `SolidView`    —— 纯色方块（只有 color 一个字段）
//       · `Hr`           —— 分隔线（自带 show_bg + pixel）
//     `ScrollYView` 同样没有 show_bg，页面底色由窗口给，别再给它写 draw_bg。
//     `tools/paintfix.py` 会把违反这条规则的写法全部列出来，**当作门禁跑**。
//
// ⚠️⚠️ **Label 的 height 只当最小值，压不下去**（血泪，2026-09-30，同一天第二坑）：
//     `Label{height: 19}` 放进 `flow: Down` 时，makepad 取 **max(显式高度, 自然行盒)**。
//     font_size 12 的中文/等宽数字，自然行盒 ≈ 26px —— 也就是**写 19、21、23 都一样占 26**。
//     后果：容器高度按「我写了多少」估算，实际会超支，**把后面的兄弟节点挤扁**。
//     被挤扁的文字（尤其 CJK）会只剩中间几条横，看上去就是「一个小点」，
//     极难和「没画出来」区分。日历格子的「班」字就栽在这上面：
//       单元格 34 → 标记行实得 8~13px → 「班」= 2px 残片（像个点）
//       单元格 46 → 标记行实得 17px    → 依旧是残片
//       单元格 52 → 标记行实得 23px    → 「班」完整清晰
//     结论：给**文字**留空间时，按 `≈ 2.2 × font_size` 估行盒；容器给足，
//     别指望把 Label 的 height 写小来省地方。
//     验证手段：改完布局后用 `/d` dump 布局树，**看兄弟节点的实测 r 高度**，
//     而不是看自己写了多少（`tools/e2e.py dump` + `zoom.py` 截图回读像素）。
//
// ⚠️⚠️ **ButtonFlat 必须显式写 color_focus，否则点一下按钮就「消失」**（血泪，2026-09-30，第三个坑）：
//     现象：点一下「节日 中国」，它整块变白（看着像凭空消失），鼠标移上去又出现；
//           黑底的「导入」按钮点一下会变成白色。用户报的就是这个。
//     根因（读 makepad 源码 widgets/src/button.rs 确认）：
//       ① `handle_event` 的 `Hit::FingerDown` 会 `cx.set_key_focus(...)`
//          （受 `self.grab_key_focus` 控制，那是 Rust 私有字段，脚本改不了）；
//       ② shader 的填充色是**四个状态混色**出来的：
//            fill = color.mix(color_focus, focus)
//                        .mix(color_hover, hover)
//                        .mix(color_down,  down)
//                        .mix(color_disabled, disabled)
//       ③ 我们只写了 color / color_hover / color_down，**没写 color_focus**
//          → 按钮一被点就带上键盘焦点（focus=1），填充色落到主题默认的
//            `theme.color_outset_focus`（浅色）—— 浅底按钮看着「消失」，
//            深底按钮看着「变白」。描边与文字同理
//            （`border_color_focus` / `draw_text.color_focus`）。
//     结论：**每个 ButtonFlat 都要写 color_focus（取和 color 同值）
//           + border_color_focus + draw_text.color_focus**，让「获得焦点」不改变外观。
//           全项目 16 个按钮已于 2026-09-30 补齐，新增按钮必须照做。
//     验证手段：点一下按钮 → 用 `/m?k=move` 把指针移到别处 → `/g?raw=1` 截图 →
//               `tools/zoom.py` 回读按钮中心像素，应**仍等于 color** 而不是 #ffffff。

// 设计语言色板（集中一处，方便整体调色）
// ⚠️ 必须在文件最前面声明：Splash 是顺序执行，函数体内引用全局变量是运行时求值，
//    声明早了任何函数都能安全引用。
let c_paper    = #xfaf9f7   // 纸底
let c_card     = #xffffff   // 卡片
let c_ink      = #x191714   // 暖黑墨
let c_ink2     = #x6b6560   // 次级文字
let c_ink3     = #x9c9590   // 三级/提示
let c_line     = #xe7e3de   // 分隔线
let c_line2    = #xd5cfc8   // 强一点的分隔线/描边
let c_accent   = #xb4531f   // 赤陶
let c_accent_s = #xfdf0e9   // 赤陶浅底
// ★ 2026-09-30 新增：格子交互的两个底纹色（见下面 click_layer 的说明）
//   c_hover_bg —— 悬停底：**半透明**赤陶（基色 #xe4b28e @ alpha 30%）
//   c_down_bg  —— 按下底：同一基色加深到 48%
//   c_sel_bg   —— 选中底：**不透明**，但它是**画进画布**的（在数字**下面**），
//                 所以不透明是安全的，而且这样才能与「悬停」一眼区分开。
//   ⚠️⚠️ 悬停/按下必须带 alpha！这两个色是画在**画布之上**的按钮填充，
//      一旦不透明，就会把画布画出来的日期数字 / 事件点 / 节日名整块擦掉
//      （用户实测报回来的 bug：鼠标一移上去，日期只剩空白）。
//      八位色值格式是 #xRRGGBBAA（**末字节 = alpha**）。
//      测法见 .runtime/diag15.sh；门禁见 tools/cellhover.py。
//   ⚠️ 为什么选中还要额外画进画布：实测 card-host 里 ButtonFlat 的 hover/down
//      状态色在**合成鼠标输入**下画不出来（真机有效），所以「选中」这层必须由
//      画布自己画 —— 不经过任何动画器，一定看得见。
let c_hover_bg = #xe4b28e4d   // 悬停底：赤陶 30% alpha（**必须半透明**，见下）
let c_down_bg  = #xe4b28e7a   // 按下底：赤陶 48% alpha
let c_sel_bg   = #xf6dcc7   // 选中底（比悬停重一档）
let c_ok       = #x15803d
let c_ok_s     = #xe9f6ed
let c_warn     = #xb45309
let c_warn_s   = #xfdf6e7
let c_work     = #x2f6f8f   // 工作类事件色条（唯一允许的副色）

// ★★ 2026-10-01 新增：事件热度分级（月视图格子底色，0 → 4 档）
//   用户要求「以月/周/日为单位的这些事件的图，可以把它看成图表」。
//   做法不是另开一块图表区（那要多占 ~60px 竖向空间，会把面板底部的按钮
//   挤出 892px 视口 —— 见 sync_panels 的血泪），而是**把热度画进格子本身**：
//   事件越多，格子底色越暖。零额外高度、一眼看出哪几天最忙。
//   ⚠️ 全部是不透明浅色 —— 它们是画布的一部分（在数字**下面**），
//      不是叠在画布之上的按钮填充，所以不涉及「擦掉数字」的问题。
//      但**必须足够浅**（亮度 ≥ 240），否则 c_ink2 的日期数字对比度不够。
let c_heat1    = #xfef8f4
let c_heat2    = #xfcecdf
let c_heat3    = #xf9ddc8
let c_heat4    = #xf4cbb0
// 心情五档（色点 + 文字标签；宿主字体没有 emoji 字形，所以一律用色点表达）
let c_mood1    = #x2f9e6f   // 开心
let c_mood2    = #x4a7fa5   // 平静
let c_mood3    = #x8d8a85   // 一般
let c_mood4    = #xd08a2e   // 疲惫
let c_mood5    = #xa8453a   // 低落

// ── 中国法定节假日 / 调休数据（内置） ────────────────────────────────
// 为什么内置而不是联网拉取：本应用只申请了 `storage` 能力、`hosts` 为空，
//   运行时没有任何网络出口，假日数据只能随 bundle 一起离线携带。
// 数据来源（均为国务院办公厅通知，多源交叉核对一致）：
//   2025：《关于 2025 年部分节假日安排的通知》（2024-11-12）
//   2026：《关于 2026 年部分节假日安排的通知》
// 格式说明：`|YYYYMMDD|YYYYMMDD|…`，两端补竖线，查询时用 `search("|日期|")`
//   做**精确**匹配 —— 若不加竖线，"2025010" 会误命中 "20250101"。
let HOLIDAYS = ""
    + "|20250101|"                                            // 元旦（不调休）
    + "|20250128|20250129|20250130|20250131|20250201|20250202|20250203|20250204|"  // 春节 8 天
    + "|20250404|20250405|20250406|"                          // 清明（不调休）
    + "|20250501|20250502|20250503|20250504|20250505|"        // 劳动节 5 天
    + "|20250531|20250601|20250602|"                          // 端午（不调休）
    + "|20251001|20251002|20251003|20251004|20251005|20251006|20251007|20251008|"  // 国庆+中秋 8 天
    + "|20260101|20260102|20260103|"                          // 元旦 3 天
    + "|20260215|20260216|20260217|20260218|20260219|20260220|20260221|20260222|20260223|"  // 春节 9 天
    + "|20260404|20260405|20260406|"                          // 清明（不调休）
    + "|20260501|20260502|20260503|20260504|20260505|"        // 劳动节 5 天
    + "|20260619|20260620|20260621|"                          // 端午（不调休）
    + "|20260925|20260926|20260927|"                          // 中秋（不调休）
    + "|20261001|20261002|20261003|20261004|20261005|20261006|20261007|"  // 国庆 7 天

// 调休上班日：本该休息的周末被调来上班，日历里必须和普通工作日区分开 ——
// 用户最容易记错的就是这几天。
let WORKDAYS = "|20250126|20250208|20250427|20250928|20251011|"
    + "|20260104|20260214|20260228|20260509|20260920|20261010|"

// 中国节日「起止 + 名称」，每 3 项一组：起始日 | 结束日 | 名称。
// HOLIDAYS 只有日期没有名字，说明行要写出「国庆」这类名称就得靠这张表。
// 春节/端午/中秋是农历，公历日期逐年不同，所以按年显式列出而不是算出来。
// ⚠️⚠️ 血泪（2026-09-30）：**不要在每行首尾都写竖线**。`+ "|a|b|c|" + "|d|e|f|"`
//    拼出来是 `|a|b|c||d|e|f|`，中间多一个空字段 → split 后步长变成 **4** 不是 3，
//    `parts[1 + k*3]` 只有 k=0 命中，其余全落到空串上，整张表的节日名都取不到。
//    **正确写法**：整表只有一个前导 `|` 和组间单竖线，首行不带竖线、末行不留尾竖线。
let CN_SPANS = ""
    + "20250101|20250101|元旦"
    + "|20250128|20250204|春节"
    + "|20250404|20250406|清明"
    + "|20250501|20250505|劳动节"
    + "|20250531|20250602|端午"
    + "|20251001|20251008|国庆中秋"
    + "|20260101|20260103|元旦"
    + "|20260215|20260223|春节"
    + "|20260404|20260406|清明"
    + "|20260501|20260505|劳动节"
    + "|20260619|20260621|端午"
    + "|20260925|20260927|中秋"
    + "|20261001|20261007|国庆"

// 国际节日（固定公历日期），每 2 项一组：MMDD | 名称。
// 只收固定日期的 —— 感恩节/母亲节这类「某月第 N 个周日」需要额外的星期推算，
// 宁可先不做，也不写一个可能算错的日期出来。放假性质与国内无关，只作提示。
// 分隔符约定同 CN_SPANS：首项不带竖线，组间单竖线，末尾不留竖线。
let INTL_FIXED = "0101|元旦|0214|情人节|0308|妇女节|0401|愚人节"
    + "|0501|劳动节|0601|儿童节|1031|万圣节|1224|平安夜|1225|圣诞节"

// ── 中国特别日（对中国有特定意义的日子，置顶显示）────────────────
// 与 INTL_FIXED 同款格式：MMDD | 名称 | 简介（简介可空）。
// ⚠️ 取舍：这是**日历界面上必须置顶显示**的日子（九一八、南京大屠杀等），
//    「历史上的今天」表刻意不收战争/政治，所以这些日子单建一张表，
//    在 egg_today_pick() 里**优先于**国际节日、节气、一般的历史条目被挑出。
//    选编的边界：相对公认、意义跨越地域、纪念性高于娱乐性。
let CHINA_FIXED = ""
    + "|0504|五四运动|1919 年 5 月 4 日"
    + "|0701|建党节|1921 年中共一大召开"
    + "|0707|七七事变|1937 年 7 月 7 日，卢沟桥"
    + "|0801|八一建军节|1927 年 8 月 1 日，南昌起义"
    + "|0903|抗战胜利纪念日|1945 年 9 月 3 日，日本签署投降书"
    + "|0918|九一八事变|1931 年 9 月 18 日，日军炮轰北大营"
    + "|1001|国庆节|1949 年 10 月 1 日，中华人民共和国成立"
    + "|1022|红军长征胜利|1936 年 10 月，三大主力会师"
    + "|1213|南京大屠杀|1937 年 12 月 13 日，日军攻陷南京"

// ── 24 节气（内置精确表，2025–2030）────────────────────────────────
// 覆盖范围外（2031 起）自动退回**公式推算**并在界面上标「≈」，见 solar_term()。
// ★ 为什么内置表而不是纯公式：节气用「通用寿星公式」[Y×0.2422+C]-L 会有 ±1 天误差，
//   实测 2026 年雨水公式给 02-19、真实是 02-18（23:46 北京，差 14 分钟就跨日）。
//   这张表是用 Meeus 太阳视黄经算法（误差 < 0.01°，时刻精度约十几分钟）
//   逐项解算出来的，不是抄现成表格 —— 生成脚本见 .runtime/calc_terms.py。
// ⚠️ 格式与 HOLIDAYS 同款：**整串以 `|` 开头**，查询用 `search("|YYYYMMDD|")`。
//    （不能沿用 CN_SPANS 那种「首项不带竖线」的写法 —— 那样第一项永远查不到，
//      典型表现是每年 1 月 5 日的小寒莫名其妙消失，很难发现。）
