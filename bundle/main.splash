    // ══ 心情分区（2026-10-01 新增）══════════════════════════════
    // ⚠️ 心情只用**色点 + 中文标签**表达，不用 emoji：宿主字体没有 emoji 字形，
    //    打出来就是豆腐块（本项目在 ✓ ✕ ◌ 三个字符上已经踩过）。
    sec_mood := RoundedView{width: Fill height: Fit flow: Down
        draw_bg +: {color: c_paper}
        RoundedView{width: Fill height: Fit flow: Down spacing: 8
            padding: Inset{left: 20 right: 20 top: 4 bottom: 10} draw_bg +: {color: c_card}
            RoundedView{width: Fill height: Fit flow: Right spacing: 8 draw_bg +: {color: c_card}
                Label{text: "心情日记" draw_text.color: c_ink
                    draw_text.text_style: theme.font_bold{font_size: 15}}
                Label{width: Fill text: "" draw_text.color: c_ink3}
                mood_where := Label{text: "" draw_text.color: c_accent
                    draw_text.text_style: theme.font_regular{font_size: 11}}
            }
            mood_month := Label{width: Fill text: "" draw_text.color: c_ink2
                draw_text.text_style: theme.font_regular{font_size: 11}}
            Label{width: Fill text: "这一天过得怎么样？点一个 —— 同一天再点就是改。" draw_text.color: c_ink3
                draw_text.text_style: theme.font_regular{font_size: 11}}
            RoundedView{width: Fill height: 34.0 flow: Right spacing: 6 draw_bg +: {color: c_card}
                mood_b0 := ButtonFlat{text: "开心" width: Fill height: 30.0 padding: Inset{left: 0 right: 0}
                    on_click: || mood_pick(0)
                    draw_bg +: {border_radius: 7.0 color: c_mood1 color_hover: c_mood1 color_down: c_mood1
                        color_focus: c_mood1 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff
                        text_style: theme.font_regular{font_size: 11}}}
                mood_b1 := ButtonFlat{text: "平静" width: Fill height: 30.0 padding: Inset{left: 0 right: 0}
                    on_click: || mood_pick(1)
                    draw_bg +: {border_radius: 7.0 color: c_mood2 color_hover: c_mood2 color_down: c_mood2
                        color_focus: c_mood2 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff
                        text_style: theme.font_regular{font_size: 11}}}
                mood_b2 := ButtonFlat{text: "一般" width: Fill height: 30.0 padding: Inset{left: 0 right: 0}
                    on_click: || mood_pick(2)
                    draw_bg +: {border_radius: 7.0 color: c_mood3 color_hover: c_mood3 color_down: c_mood3
                        color_focus: c_mood3 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff
                        text_style: theme.font_regular{font_size: 11}}}
                mood_b3 := ButtonFlat{text: "疲惫" width: Fill height: 30.0 padding: Inset{left: 0 right: 0}
                    on_click: || mood_pick(3)
                    draw_bg +: {border_radius: 7.0 color: c_mood4 color_hover: c_mood4 color_down: c_mood4
                        color_focus: c_mood4 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff
                        text_style: theme.font_regular{font_size: 11}}}
                mood_b4 := ButtonFlat{text: "低落" width: Fill height: 30.0 padding: Inset{left: 0 right: 0}
                    on_click: || mood_pick(4)
                    draw_bg +: {border_radius: 7.0 color: c_mood5 color_hover: c_mood5 color_down: c_mood5
                        color_focus: c_mood5 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff
                        text_style: theme.font_regular{font_size: 11}}}
            }
            mood_sum := Label{width: Fill text: "" draw_text.color: c_ink
                draw_text.text_style: theme.font_regular{font_size: 12}}
            RoundedView{width: Fill height: 38.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                mood_in := TextInput{width: Fill height: 34 empty_text: "想写点什么？例如「答辩过了」"
                    draw_bg +: {color: c_card color_hover: c_card color_focus: c_card color_empty: c_card
                        border_radius: 8.0 border_size: 1.0 border_color: c_line2}
                    draw_text +: {color: c_ink color_hover: c_ink color_focus: c_ink
                        color_empty: c_ink3 color_empty_hover: c_ink3}}
