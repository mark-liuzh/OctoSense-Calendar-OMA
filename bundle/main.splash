//   做**精确**匹配 —— 若不加竖线，"2025010" 会误命中 "20250101"。
let HOLIDAYS = ""
    + "|20250101|"                                            // 元旦（不调休）
    + "|20250128|20250129|20250130|20250131|20250201|20250202|20250203|20250204|"  // 春节 8 天
    + "|20250404|20250405|20250406|"                          // 清明（不调休）
    + "|20250501|20250502|20250503|20250504|20250505|"        // 劳动节 5 天
    + "|20250531|20250601|20250602|"                          // 端午（不调休）
    + "|20251001|20251002|20251003|20251004|20251005|20251006|20251007|20251008|"  // 国庆+中秋 8 天
    + "|20260101|20260102|20260103|"                          // 元旦 3 天
    + "|20260215|20260216|20260217|20260218|20260219|20260220|20260221|20260222|20260223|"  // 春节 9 天
    + "|20260404|20260405|20260406|"                          // 清明（不调休）
    + "|20260501|20260502|20260503|20260504|20260505|"        // 劳动节 5 天
    + "|20260619|20260620|20260621|"                          // 端午（不调休）
    + "|20260925|20260926|20260927|"                          // 中秋（不调休）
    + "|20261001|20261002|20261003|20261004|20261005|20261006|20261007|"  // 国庆 7 天

// 调休上班日：本该休息的周末被调来上班，日历里必须和普通工作日区分开 ——
// 用户最容易记错的就是这几天。
let WORKDAYS = "|20250126|20250208|20250427|20250928|20251011|"
    + "|20260104|20260214|20260228|20260509|20260920|20261010|"

// 中国节日「起止 + 名称」，每 3 项一组：起始日 | 结束日 | 名称。
// HOLIDAYS 只有日期没有名字，说明行要写出「国庆」这类名称就得靠这张表。
// 春节/端午/中秋是农历，公历日期逐年不同，所以按年显式列出而不是算出来。
// ⚠️⚠️ 血泪（2026-09-30）：**不要在每行首尾都写竖线**。`+ "|a|b|c|" + "|d|e|f|"`
//    拼出来是 `|a|b|c||d|e|f|`，中间多一个空字段 → split 后步长变成 **4** 不是 3，
//    `parts[1 + k*3]` 只有 k=0 命中，其余全落到空串上，整张表的节日名都取不到。
//    **正确写法**：整表只有一个前导 `|` 和组间单竖线，首行不带竖线、末行不留尾竖线。
let CN_SPANS = ""
    + "20250101|20250101|元旦"
    + "|20250128|20250204|春节"
    + "|20250404|20250406|清明"
    + "|20250501|20250505|劳动节"
    + "|20250531|20250602|端午"
    + "|20251001|20251008|国庆中秋"
    + "|20260101|20260103|元旦"
    + "|20260215|20260223|春节"
    + "|20260404|20260406|清明"
    + "|20260501|20260505|劳动节"
    + "|20260619|20260621|端午"
    + "|20260925|20260927|中秋"
    + "|20261001|20261007|国庆"

