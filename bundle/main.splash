// ---------------------------------------------------------------- 规范化 / 反折叠 / 转义

fn normalize_newlines(text) {
    let t = text.replace(regex("\r\n", "g"), "\n")
    return t.replace(regex("\r", "g"), "\n")
}


// RFC 5545 §3.1：折行的续行以单个空格或 Tab 开头。必须在 split 之前做。
fn unfold_lines(text) {
    return text.replace(regex("\n[ \t]", "g"), "")
}


// ⚠️ 顺序：先 \n \N，再 \, \;，最后 \\。
fn unescape_value(v) {
    let s = v.replace(regex("\\\\[nN]", "g"), "\n")
    s = s.replace(regex("\\\\,", "g"), ",")
    s = s.replace(regex("\\\\;", "g"), ";")
    s = s.replace(regex("\\\\\\\\", "g"), "\\")
    return s
}


fn escape_value(v) {
    let s = v.replace(regex("\\\\", "g"), "\\\\")
    s = s.replace(regex("\n", "g"), "\\n")
    s = s.replace(regex(",", "g"), "\\,")
    s = s.replace(regex(";", "g"), "\\;")
    return s
}


// ---------------------------------------------------------------- 子串（无切片 API）
//
// ⚠️⚠️ 大坑一：`s.to_chars()` 返回的是 **U32 码点数组**，不是字符串数组。
//   源码：platform/script/src/string_heap.rs:596
//       for c in str.chars() { v.push(c as u32) }
//   所以 `out + cs[i]` 拼出来的是 "66 69 71..." 这样的数字串，不是 "BEG..."。
//   实测 "BEGIN:VCALENDAR".to_chars() 的 [0..5] 拼起来 = "6669717378"。
//
// ⚠️⚠️ 大坑二：**不能遍历重建数组**。
//   `to_string()` 的编解码依赖数组的**存储类型**：U32 存储才按码点还原，
//   用 push 新建的普通数组会被当成数字数组，拼出来的还是 "6669717378"。
//   必须**就地裁剪**（retain / remove），保留 U32 存储。
//
// 正解：用 `retain` 就地保留区间，再 `.to_string()`。
// 证据：官方测试 platform/script/test/src/main.rs:524
//       assert("hi".to_chars().to_string() == "hi")
// 实测（含中文）："黑客松初赛截止".substr(0,3) -> "黑客松" ✅
//
// 注意 retain 的回调**只收到 value，收不到下标**（见 array.rs:738
// `vm.call(fnptr, &[value])`），所以下标要靠闭包自增变量自己数。

fn substr(s, from, to) {
    let cs = s.to_chars()
    let n = cs.len()
    if from < 0 { from = 0 }
    if to > n { to = n }
    if from >= to { return "" }
    let idx = -1
    cs.retain(|| {
        idx = idx + 1
        return idx >= from && idx < to
    })
    return cs.to_string()
}


// ---------------------------------------------------------------- 时间解析

// → {minutes, is_utc, is_date_only}；minutes = 当日第几分钟，失败 -1
fn parse_ics_datetime(raw) {
    let out = { minutes: -1, is_utc: false, is_date_only: false }
    if raw == nil { return out }
    if raw == "" { return out }

    let is_utc = raw.strip_suffix("Z") != raw
    let body = raw
    if is_utc { body = raw.strip_suffix("Z") }
    out.is_utc = is_utc

    // ⚠️ 这里用 split 而不是 `search("T")` + substr：`search` 给的是**字节**下标，
    //    而 substr 按**字符**切（见 table_field 的血泪）。日期时间串眼下是纯 ASCII，
    //    两种下标恰好相等，但这种「恰好」不该留在代码里 —— 它哪天被别处复用就炸。
    let tp = body.split("T")
    if tp.len() < 2 {
        out.is_date_only = true
        return out
    }

    let time_part = tp[1]
    while time_part.len() < 6 { time_part = time_part + "0" }
    time_part = substr(time_part, 0, 6)

    let hh = substr(time_part, 0, 2).to_f64()
    let mm = substr(time_part, 2, 4).to_f64()
    // ⚠️ to_f64 失败 → NaN，NaN 与任何值比较为 false → 必须正面守卫
    if !(hh >= 0) { return out }
    if !(mm >= 0) { return out }

    out.minutes = hh * 60 + mm
    return out
}


// 从 ISO 日期串取「YYYY-MM-DD」，用于分组显示
fn date_of(raw) {
    if raw == nil { return "" }
    let body = raw
    if body.strip_suffix("Z") != body { body = body.strip_suffix("Z") }
    return substr(body, 0, 8)
}


// 20261004 → 2026-10-04
fn pretty_date(raw) {
    let d = date_of(raw)
    if d.len() < 8 { return d }
    return substr(d, 0, 4) + "-" + substr(d, 4, 6) + "-" + substr(d, 6, 8)
}


// 630 → 10:30
// ⚠️ Splash 的 `/` 是**浮点除法**，没有整数除法，也没有 floor/round/trunc。
//    实测 "870/60" → 14.5（不是 14）。取整只能 `x - (x % 1)`。
fn ipart(x) {
    return x - (x % 1)
}


fn pretty_time(minutes) {
    if minutes < 0 { return "全天" }
    let h = ipart(minutes / 60)
    let m = minutes - h * 60
    let hs = "" + h
    if h < 10 { hs = "0" + hs }
    let ms = "" + m
    if m < 10 { ms = "0" + ms }
    return hs + ":" + ms
}


// ---------------------------------------------------------------- 拆属性行

// ⚠️ Splash **没有大小写转换 API**（string.rs 只注册了 to_bytes / to_chars /
//    to_f64 / len / parse_json / trim / strip_prefix / strip_suffix / split /
//    search / match_str / match_all / replace / url_decode / url_encode）。
//    只能按码点自己翻。幸好 ICS 的属性名/参数名都是 ASCII。
//    'a'(97)..'z'(122) → 减 32
fn upper_ascii(s) {
    let cs = s.to_chars()
    let idx = -1
    cs.retain(|| {
        idx = idx + 1
        let c = cs[idx]
        if c >= 97 && c <= 122 { cs[idx] = c - 32 }
        return true
    })
    return cs.to_string()
}


// ⚠️ 原设计用 params map 存任意属性，但 Splash 对象不能写未声明的键。
//    我们真正需要的只有 TZID 和 VALUE=DATE 两个，直接摊成显式字段。
fn split_property(line) {
    let out = { key: "", value: "", tzid: "", value_kind: "" }
    let colon = line.search(":")
    if colon < 0 {
        out.key = upper_ascii(line.trim())
        return out
    }
    let keypart = substr(line, 0, colon)
    out.value = substr(line, colon + 1, line.len())

    let segs = keypart.split(";")
    out.key = upper_ascii(segs[0].trim())
    for i in segs.len() {
        if i == 0 { continue }
        let s = segs[i]
        let eq = s.search("=")
        if eq < 0 { continue }
        let pname = upper_ascii(substr(s, 0, eq).trim())
        let pval = substr(s, eq + 1, s.len()).trim()
        if pname == "TZID" { out.tzid = pval }
        if pname == "VALUE" { out.value_kind = upper_ascii(pval) }
    }
    return out
}


fn new_event() {
    return { uid: "", summary: "", dtstart: "", dtend: "", location: "",
             description: "", organizer: "", status: "", sequence: 0,
             all_day: false, start_utc: false, timezone: "",
             // 原始 RRULE 文本。本应用**不展开**重复规则（展开要处理
             // EXDATE/RDATE/COUNT/UNTIL 和跨时区夏令时，超出原型范围），
             // 但也**绝不丢弃** —— 原样留在事件里、原样写回导出，
             // 这样「导出再导入」仍然字段级无损。
             rrule: "",
             // 重复规则的配套日期（可能多行）。单值字段存不下，用 "|" 串起来，
             // 导出时再拆回多行。只保留 RRULE 而丢掉 EXDATE，
             // 会把用户明确排除掉的那几次会议又变回来。
             exdate: "", rdate: "",
             // RFC 5545 要求每个 VEVENT 带 DTSTAMP（创建时间戳）。
             // ⚠️ 没有获取「当前时间」的能力，所以**不编造**：输入里有就原样写回，
             //    没有就不写 —— 凭空造一个时刻比缺字段更糟。
             dtstamp: "",
             start_minutes: -1, end_minutes: -1 }
}


// ---------------------------------------------------------------- 分块解析

// 处理 lines[start..end)。cur / in_vevent / begin_line 跨块传递。
fn parse_lines(lines, start, end, carry) {
    let cur = carry.cur
    let in_vevent = carry.in_vevent
    let evs = carry.events
    let errs = carry.errors
    // 当前 VEVENT 的**起始行号**（1 起）。报错要说「第 4 行起的事件缺 UID」，
    // 而不是指向 END:VEVENT 那一行 —— 后者是对的但没意义，用户拿着行号回文件里
    // 找，看到的是 END，只会更困惑。
    let begin_line = carry.begin_line

    for idx in start..end {
        if idx >= lines.len() { break }
        let line = lines[idx]
        if line.trim() == "" { continue }

        let p = split_property(line)
        let key = p.key
        let value = p.value

        if key == "BEGIN" {
            if value.trim() == "VEVENT" {
                in_vevent = true
                cur = new_event()
                begin_line = idx + 1
            }
            continue
        }
        if key == "END" {
            if value.trim() == "VEVENT" {
                in_vevent = false
                if cur != nil {
                    if cur.uid == "" {
                        errs.push("第 " + ("" + begin_line) + " 行起的事件缺 UID")
                    } else if cur.dtstart == "" {
                        errs.push("第 " + ("" + begin_line) + " 行起的事件缺 DTSTART")
                    } else if !ics_date_ok(cur.dtstart) {
                        // 日期不是真实存在的那一天（2 月 30 日 / 平年 2 月 29 日 /
                        // 年份越界 / 串里有非数字）。见 ics_date_ok 的注释：
                        // **收下一个「日历上永远不出现」的事件，比明确跳过它糟得多**。
                        errs.push("第 " + ("" + begin_line) + " 行起的事件日期 "
                            + pretty_date(cur.dtstart) + " 不存在，已跳过")
                    } else {
                        evs.push(cur)
                    }
                }
                cur = nil
            }
            continue
        }

        if !in_vevent || cur == nil { continue }

        if key == "UID" {
            cur.uid = value.trim()
        } else if key == "SUMMARY" {
            cur.summary = unescape_value(value)
        } else if key == "DTSTART" {
            cur.dtstart = value.trim()
            let d = parse_ics_datetime(cur.dtstart)
            cur.start_minutes = d.minutes
            cur.start_utc = d.is_utc
            cur.all_day = d.is_date_only
            cur.timezone = p.tzid
            // VALUE=DATE 也可以显式声明全天
            if p.value_kind == "DATE" { cur.all_day = true }
        } else if key == "DTEND" {
            cur.dtend = value.trim()
            let d2 = parse_ics_datetime(cur.dtend)
            cur.end_minutes = d2.minutes
        } else if key == "LOCATION" {
            cur.location = unescape_value(value)
        } else if key == "DESCRIPTION" {
            cur.description = unescape_value(value)
        } else if key == "ORGANIZER" {
            cur.organizer = value.trim()
        } else if key == "STATUS" {
            cur.status = value.trim()
        } else if key == "SEQUENCE" {
            let n = value.trim().to_f64()
            if n >= 0 { cur.sequence = n } else { cur.sequence = 0 }
        } else if key == "RRULE" {
            // ⚠️ 曾经这里什么都没有 → 带重复规则的日程被**静默降级成单次事件**，
            //    导出的 ICS 里 RRULE 也没了，用户完全不知道自己的每周例会被吃掉。
            //    现在原样存下来，导出时原样写回（见 export_ics）。
            cur.rrule = value.trim()
        } else if key == "EXDATE" {
            let v = value.trim()
            if v != "" {
                if cur.exdate == "" { cur.exdate = v }
                else { cur.exdate = cur.exdate + "|" + v }
            }
        } else if key == "RDATE" {
            let v = value.trim()
            if v != "" {
                if cur.rdate == "" { cur.rdate = v }
                else { cur.rdate = cur.rdate + "|" + v }
            }
        } else if key == "DTSTAMP" {
            cur.dtstamp = value.trim()
        }
    }

    return { events: evs, errors: errs, cur: cur, in_vevent: in_vevent,
             begin_line: begin_line }
}


// ⚠️ Splash 的对象是 prototype chain，**不能读一个从没写过的键** ——
//    会直接抛 "property nope not found in prototype chain"。
//    ⚠️ 更严重的是：一旦抛出，该脚本实例的**后续写操作全部静默失效**
//    （实测：回调抛错后，再点正常按钮也不再更新全局变量）。
//    所以这里的铁律是「绝不抛错」，所有状态字段一律预先声明。
fn new_carry() {
    return { started: false, lines: [], cursor: 0, events: [], errors: [],
             cur: nil, in_vevent: false, begin_line: 0,
             done: false, progress: 0.0 }
}


// 全量解析。ICS 通常几百行，一次跑完远低于 20000000 条全局指令预算。
// 返回新的 carry（不改传入的），避免中途抛错污染状态。
fn parse_all(text) {
    let carry = new_carry()
    let t = normalize_newlines(text)
    t = unfold_lines(t)
    carry.lines = t.split("\n")
    carry.started = true

    let r = parse_lines(carry.lines, 0, carry.lines.len(), carry)
    carry.events = r.events
    carry.errors = r.errors
    carry.cur = r.cur
    carry.in_vevent = r.in_vevent
    carry.begin_line = r.begin_line
    carry.cursor = carry.lines.len()
    carry.done = true
    carry.progress = 1.0

    if carry.cur != nil {
        carry.errors.push("第 " + ("" + carry.begin_line) + " 行起的事件未闭合")
        carry.cur = nil
    }
    return carry
}


// ---------------------------------------------------------------- 合并

// UID + SEQUENCE 去重。
// ⚠️ 不能建 uid→下标 的 map：Splash 对象读未写过的键会抛错，
//    而候选 UID 事先未知。事件数量级小，直接线性查找。
fn find_by_uid(list, uid) {
    for i in list.len() {
        if list[i].uid == uid { return i }
    }
    return -1
}


fn merge_events(local, incoming) {
    let out = { merged: [], added: 0, updated: 0, skipped: 0 }

    let m = []
    for i in local.len() { m.push(local[i]) }

    for i in incoming.len() {
        let ev = incoming[i]
        let hit = find_by_uid(m, ev.uid)
        if hit < 0 {
            m.push(ev)
            out.added = out.added + 1
        } else {
            let old = m[hit]
            if ev.sequence > old.sequence {
                m[hit] = ev
                out.updated = out.updated + 1
            } else {
                out.skipped = out.skipped + 1
            }
        }
    }
    out.merged = m
    return out
}


// "20261004T100000" → 20261004（整数），失败 -1
fn date_num(raw) {
    if raw == nil { return -1 }
    let d = date_of(raw)
    if d.len() < 8 { return -1 }
    let n = d.to_f64()
    if !(n >= 0) { return -1 }
    return n
}


// 承诺重量：判断这个事件能不能被动。
// 规则来自领域常识，不编造用户意图 —— 只在保守信号上提升等级。
//   3 = 硬承诺（终局/截止/外部会议）
//   2 = 有组织者（别人也在等）
//   1 = 默认
//   0 = 可协商（个人、无组织者、状态为 TENTATIVE）
fn commitment_weight(ev) {
    let s = upper_ascii(ev.summary)
    let hard = false
    // 终局/截止类关键词（中英）
    if s.search("DEADLINE") >= 0 { hard = true }
    if s.search("截止") >= 0 { hard = true }
    if s.search("冻结") >= 0 { hard = true }
    if s.search("FREEZE") >= 0 { hard = true }
    if s.search("发布会") >= 0 { hard = true }
    if ev.status == "CANCELLED" { return 0 }
    if ev.status == "TENTATIVE" { return 0 }
    if hard { return 3 }
    if ev.organizer != "" { return 2 }
    if ev.description != "" && ev.description.search("可改期") >= 0 { return 0 }
    return 1
}


// ---------------------------------------------------------------- 冲突检测

// 事件的「绝对分钟轴」：日期当日的 00:00 + 当日分钟。
// 跨天比较必须用这个，否则 10-04 和 10-05 的同分钟会被误判为重叠。
fn abs_start(ev) {
    return date_num(ev.dtstart) * 1440 + ev.start_minutes
}


fn weight_label(w) {
    if w >= 3 { return "硬承诺" }
    if w == 2 { return "有约在前" }
    if w == 0 { return "可协商" }
    return "常规"
}


fn abs_end(ev) {
    // 缺 DTEND 时按 30 分钟默认时长；全天事件按整日
    if ev.all_day { return date_num(ev.dtstart) * 1440 + 1440 }
    if ev.end_minutes < 0 { return abs_start(ev) + 30 }
    let e = date_num(ev.dtend) * 1440 + ev.end_minutes
    if e <= abs_start(ev) { return abs_start(ev) + 30 }
    return e
}


// 两事件是否重叠（同一天，半开区间 [start, end)）
fn overlaps(a, b) {
    let as = abs_start(a)
    let ae = abs_end(a)
    let bs = abs_start(b)
    let be = abs_end(b)
    if ae <= bs { return false }
    if be <= as { return false }
    return true
}


// 重叠时长（分钟），不重叠返回 0
fn overlap_minutes(a, b) {
    if !overlaps(a, b) { return 0 }
    let s = abs_start(a)
    if abs_start(b) > s { s = abs_start(b) }
    let e = abs_end(a)
    if abs_end(b) < e { e = abs_end(b) }
    return e - s
}


// 找出所有两两冲突。n 很小，O(n²) 足够。
fn find_conflicts(list) {
    let out = []
    let n = list.len()
    if n < 2 { return out }
    for i in 0..n {
        for j in (i + 1)..n {
            let a = list[i]
            let b = list[j]
            if a.status == "CANCELLED" { continue }
            if b.status == "CANCELLED" { continue }
            if overlaps(a, b) {
                out.push({ a: i, b: j, minutes: overlap_minutes(a, b) })
            }
        }
    }
    return out
}


// 在候选事件的当天，找一个 ≥ dur 分钟且不与任何事件冲突的空档。
// 搜索窗口：09:00 起，按 15 分钟步进，到 21:00 止。
fn propose_slot(candidate, list, dur) {
    let day = date_num(candidate.dtstart)
    if day < 0 { return nil }
    let day_start = 9 * 60
    let day_end = 21 * 60
    if dur > day_end - day_start { dur = day_end - day_start }

    let t = day_start
    while t + dur <= day_end {
        let slot_s = day * 1440 + t
        let slot_e = slot_s + dur
        let clash = false
        for k in list.len() {
            let ev = list[k]
            if ev.status == "CANCELLED" { continue }
            if abs_start(ev) == slot_s && abs_end(ev) == slot_e { continue }
            if slot_e <= abs_start(ev) { continue }
            if abs_end(ev) <= slot_s { continue }
            clash = true
            break
        }
        if !clash { return { start: t, end: t + dur } }
        t = t + 15
    }
    return nil
}


// 对每个冲突给出建议：移动「较轻」的那个。
// 同权重时移动较晚开始的那个（保守：先动后加进来的）。
fn build_advice(conflicts, list) {
    let out = []
    for i in conflicts.len() {
        let c = conflicts[i]
        let a = list[c.a]
        let b = list[c.b]
        let wa = commitment_weight(a)
        let wb = commitment_weight(b)

        let move_a = false
        if wa < wb { move_a = true }
        else if wa == wb && abs_start(a) > abs_start(b) { move_a = true }
        else if wa == wb && abs_start(a) == abs_start(b) && c.a > c.b { move_a = true }

        let mover = b
        let keeper = a
        if move_a { mover = a; keeper = b }

        let dur = abs_end(mover) - abs_start(mover)
        let slot = propose_slot(mover, list, dur)

        let has_slot = slot != nil
        let s0 = -1
        let s1 = -1
        let why = "当天 09:00-21:00 已无可放空档，建议改日或缩短时长"
        if has_slot {
            s0 = slot.start
            s1 = slot.end
            why = "移到当天 " + pretty_time(s0) + "-" + pretty_time(s1) + " 的空档"
        }

        out.push({
            aidx: c.a, bidx: c.b,
            minutes: c.minutes,
            mover: mover.uid,
            mover_summary: mover.summary,
            mover_weight: commitment_weight(mover),
            mover_label: weight_label(commitment_weight(mover)),
            keeper_summary: keeper.summary,
            keeper_weight: commitment_weight(keeper),
            keeper_label: weight_label(commitment_weight(keeper)),
            day: date_of(mover.dtstart),
            dur: dur,
            has_slot: has_slot,
            slot_start: s0,
            slot_end: s1,
            why: why
        })
    }
    return out
}


// ---------------------------------------------------------------- 导出

fn fold_line(line) {
    if line.len() <= 75 { return line }
    let out = substr(line, 0, 75)
    let rest = substr(line, 75, line.len())
    while rest.len() > 0 {
        let take = 74
        if take > rest.len() { take = rest.len() }
        out = out + "\n " + substr(rest, 0, take)
        rest = substr(rest, take, rest.len())
    }
    return out
}


// 拼一行 EXDATE / RDATE。
// key = "EXDATE" 或 "RDATE"；v = 原始日期时间值。
// 参数按**事件自身**的时间类型重建：全天事件补 `;VALUE=DATE`，
// 有时区的事件补 `;TZID=<该时区>` —— 与 DTSTART 的处理保持一致，
// 否则同一个时间在 EXDATE 里会变成「浮动时间」而对不上主时间。
fn exdate_line(key, v, e) {
    if e.all_day { return key + ";VALUE=DATE:" + v }
    if e.timezone != "" { return key + ";TZID=" + e.timezone + ":" + v }
    return key + ":" + v
}


fn export_ics(list) {    let out = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//OctoSense//OMA//CN\r\n"
    for i in list.len() {
        let e = list[i]
        out = out + "BEGIN:VEVENT\r\n"
        out = out + fold_line("UID:" + e.uid) + "\r\n"
        // RFC 5545 要求 VEVENT 带 DTSTAMP。只写回输入里的原值，不编造。
        if e.dtstamp != "" {
            out = out + "DTSTAMP:" + e.dtstamp + "\r\n"
        }
        out = out + fold_line("SUMMARY:" + escape_value(e.summary)) + "\r\n"
        // ⚠️ 时间必须带回类型参数，否则往返一次语义就丢了：
        //    `DTSTART;TZID=Asia/Shanghai:20261005T143000` 直接输出成
        //    `DTSTART:20261005T143000` → 读回时被当成「浮动时间」（无时区），
        //    全天事件也会退化成 00:00 的定时事件。
        if e.all_day {
            out = out + "DTSTART;VALUE=DATE:" + e.dtstart + "\r\n"
        } else if e.timezone != "" {
            out = out + "DTSTART;TZID=" + e.timezone + ":" + e.dtstart + "\r\n"
        } else {
            out = out + "DTSTART:" + e.dtstart + "\r\n"
        }
        if e.dtend != "" {
            if e.all_day {
                out = out + "DTEND;VALUE=DATE:" + e.dtend + "\r\n"
            } else if e.timezone != "" {
                out = out + "DTEND;TZID=" + e.timezone + ":" + e.dtend + "\r\n"
            } else {
                out = out + "DTEND:" + e.dtend + "\r\n"
            }
        }
        if e.location != "" {
            out = out + fold_line("LOCATION:" + escape_value(e.location)) + "\r\n"
        }
        // ⚠️ 下面两行曾经缺失 → DESCRIPTION / ORGANIZER 解析进来却写不回去，
        //    「导出再导入」会静默丢字段。而 UID 匹配的往返测试（新增/改期/跳过）
        //    对这类字段级缩水是**无感**的，所以一直没被发现。
        if e.description != "" {
            out = out + fold_line("DESCRIPTION:" + escape_value(e.description)) + "\r\n"
        }
        if e.organizer != "" {
            out = out + fold_line("ORGANIZER:" + e.organizer) + "\r\n"
        }
        if e.rrule != "" {
            out = out + fold_line("RRULE:" + e.rrule) + "\r\n"
        }
        // EXDATE / RDATE 可能有多行 —— 解析时用 "|" 串存，这里拆回多行。
        // 只留 RRULE 而丢掉 EXDATE，会把用户明确排除掉的那几次又变回来。
        // 不存 tz/vk 而是按事件自身的时间类型重建参数：现实中 EXDATE 与 DTSTART
        // 同型（同 TZID 或同为全天），这样既省字段又能覆盖实际用法。
        if e.exdate != "" {
            for x in e.exdate.split("|") {
                out = out + exdate_line("EXDATE", x, e) + "\r\n"
            }
        }
        if e.rdate != "" {
            for x in e.rdate.split("|") {
                out = out + exdate_line("RDATE", x, e) + "\r\n"
            }
        }
        if e.status != "" { out = out + "STATUS:" + e.status + "\r\n" }
        out = out + "SEQUENCE:" + ("" + e.sequence) + "\r\n"
        out = out + "END:VEVENT\r\n"
    }
    out = out + "END:VCALENDAR\r\n"
    return out
}


// 统一改状态条文字。
// ⚠️ 状态条是 on_render 动态容器，没有 `ui.status` 这个控件可 set_text；
//    必须改全局变量再让容器重画。
// 三态：notice（默认，赤陶底）· ok（绿底 ✓）· warn（琥珀底 !）
fn set_status(t) {
    status_text = t
    status_icon = "·"
    status_bg = #xfdf0e9
    status_bd = #xf0d9c9
    status_fg = #x8a3f16
    ui.status_panel.render()
}


fn set_status_ok(t) {
    status_text = t
    status_icon = "✓"
    status_bg = c_ok_s
    status_bd = #xc9e6d3
    status_fg = #x14532d
    ui.status_panel.render()
}


fn set_status_warn(t) {
    status_text = t
    status_icon = "!"
    status_bg = c_warn_s
    status_bd = #xf0dfc0
    status_fg = #x7c3a06
    ui.status_panel.render()
}


// 有没有可回滚的快照。快照在每次解析时落盘（save_snapshot），
// 少于 2 份就没有「上一步」可回。
fn can_rollback() {
    if !fs.exists(SNAP_FILE) { return false }
    let v = fs.read(SNAP_FILE).parse_json()
    if v == nil { return false }
    return v.len() >= 2
}


// 冲突面板：静态容器 + set_text/set_visible（按钮点击才不会失效）
fn sync_conflict() {
    let n = conflicts.len()
    let can = can_rollback()
    // ⚠️ 不能只按 `n > 0` 显示：应用建议后冲突归零 → 整条消失 → 「回滚」也跟着没了，
    //    用户改错了就没法撤销。只要还有快照，这条就得留着。
    // ⚠️ 但导入面板/关于页打开时必须让位 —— 这条常驻后会多占 ~52px，
    //    把导入面板底部的「取消/写入」确认条挤出 892px 视口之外（实测点不到）。
    let show_bar = (n > 0 || can) && !about_open && !import_open && tab == 0
    ui.conflict_bar.set_visible(show_bar)
    if n > 0 {
        ui.conflict_label.set_text("发现 " + ("" + n) + " 处时间冲突")
    } else if can {
        // ⚠️ 必须短：右侧被「收起详情/回滚/应用建议」三个按钮吃掉 ~209px，
        //    这行只剩 ~131px。旧文案「当前没有时间冲突 · 可回滚上一次导入」
        //    换行成 3 行、被 44px 的条裁掉尾巴（实测）。
        ui.conflict_label.set_text("无冲突 · 可回滚")
    }
    let show_detail = more_open && n > 0
    ui.conflict_detail.set_visible(show_detail)
    if show_detail && advice.len() > 0 {
        let a = advice[0]
        ui.advice_line.set_text("重叠 " + ("" + a.minutes) + " 分钟 · 保留 " + a.keeper_summary)
        ui.advice_line2.set_text("可动 · " + a.mover_summary + "（" + a.mover_label + "）")
        ui.advice_why.set_text(a.why)
    }
}


// 确认条是静态容器，只能靠 set_text + set_visible 同步（不能放 on_render，否则点击失效）
fn sync_confirm() {
    // 关于页打开时让位：确认条高 ~40px，会把关于页的 CC BY 署名和两个按钮
    // 挤出 892px 的视口（实测）。预览数据留在 merged 里，关掉关于页就回来。
    let has = merged.len() > 0 && !about_open && tab == 0
    ui.preview_label.set_text("预览 · " + ("" + merged.len()) + " 个事件尚未写入")
    ui.confirm_bar.set_visible(has)
}


fn save() {
    fs.write(KEYS_FILE, events.to_json())
}


// 统一刷新所有 on_render 容器。
// ⚠️ 三条实测规则：
//   1. on_render **不会自动执行**，必须显式 render() —— 漏掉哪个容器它就永远空白。
//   2. **只有声明了 on_render 的 View 才有 render() 方法**；静态 View/SolidView
//      调 render() 会报 "widget method render not found"。所以这里只列动态容器。
//   3. `height: Fit` + on_render **零产出** → 节点从布局树消失并扰乱兄弟的 Fill 分配；
//      所以动态容器一律显式高度/固定高度，空状态也给占位。
// 节日来源按钮的文案。定义在 refresh_all 之前 —— Splash 里函数体引用
// 「后面才定义」的函数会直接报错（前向引用限制）。
fn festival_mode_label() {
    if festival_mode == 0 { return "节日 中国" }
    if festival_mode == 1 { return "节日 国际" }
    return "节日 全部"
}


// 当前视图的年月标题。同上，必须能被 refresh_all 显式推给控件 ——
// 静态 Label 的 `text:` 只在建树时求值一次，翻月不会自己更新（实测）。
fn month_title_text() {
    return "" + view_year() + " 年 " + ("" + view_month()) + " 月"
}


fn refresh_all() {
    // 翻月会改变的两处标题。静态 Label 的 `text:` 只在建树时求值一次，
    // **不会**跟着 view_year/view_month 自己变 —— 不加这两行，翻到 2025-10
    // 网格早就是十月了，标题还钉着「2026 年 9 月」（实测）。
    ui.month_title.set_text(month_title_text())
    // 节假日说明：节日一行、放假安排一行（见 fest_bar 的血泪注释）。
    // 第二行没内容就整行让位 —— 隐藏的 widget 不占空间，容器 height: Fit 会跟着变矮。
    let fa = festival_note(view_year(), view_month())
    let fb = month_holiday_note(view_year(), view_month())
    if fa == "" { fa = "本月无节日" }
    ui.fest_line.set_text(fa)
    ui.fest_line2.set_text(fb)
    ui.fest_row2.set_visible(fb != "")
    // 指标行三个数（2026-09-30：从 on_render 改成静态 Label，值在这里同步）
    ui.metric_events.set_text("" + events.len())
    ui.metric_sources.set_text("" + source_count())
    ui.metric_latest.set_text(latest_day_label())
    // ⚠️⚠️ 血泪（2026-09-30，第四次踩这个坑，代价最大）：这里**必须**是
    //    `ui.canvas.render()`，不能是 `ui.grid.render()`。
    //    `render()` 只对**自己带 on_render 的控件**有效；对一个没有 on_render 的
    //    View 调用它会抛 `widget method render not found for uid ...`
    //    （view.rs:893 的 heap_key 校验失败 → MethodNotFound）。
    //    而脚本里的报错会**静默中断整个函数** —— 它后面的 `ui.cnt.render()` /
    //    `ui.list.render()` / `ui.status_panel.render()` / 两处 set_text /
    //    `sync_conflict()` / `sync_confirm()` **全部不会执行**。
    //    表现极具误导性：月历整片空白（on_render 没跑）+ 主列表和状态条也一起
    //    不刷新，看着像「布局炸了」，实际是这一行报错把 refresh_all 砍断了。
    //    排查路径：宿主日志里 grep `\[E\]`，一条 `widget method render not found` 就够。
    //    （grid 改版前 on_render 在 grid 自己身上，所以这行以前是对的。）
    ui.canvas.render()
    ui.cnt.render()
    ui.list.render()
    ui.status_panel.render()
    // 节日来源按钮的文案跟着模式走。按钮是静态声明的（on_render 里建的按钮
    // 点不动），所以文案只能在这里显式同步。
    ui.fest_btn.set_text(festival_mode_label())
    // 新建面板里那个「重复」按钮的文案。它同样是**静态声明**的按钮，
    // 文案必须在状态变化时同步（cycle_repeat 里也同步了一次，那是为了
    // 点一下立刻变字、不必等整页刷新；这里再同步一次，让按钮文案就是
    // new_repeat 的纯函数 —— 少一条「某条路径忘了更新按钮」的可能）。
    ui.nr_btn.set_text(repeat_label(new_repeat))
    // ══ 2026-10-01 新增：分区导航 / 视图 / 各分区内容 ══════════════
    // 全部是「静态控件的文案与可见性」同步 —— 这些值只在建树时求值一次，
    // 不在这里推就永远是初值（本项目最贵的一类坑，见 month_title 的注释）。
    ui.tab_mark0.set_visible(tab == 0)
    ui.tab_mark1.set_visible(tab == 1)
    ui.tab_mark2.set_visible(tab == 2)
    ui.tab_mark3.set_visible(tab == 3)
    ui.tab_mark4.set_visible(tab == 4)
    ui.mascot_say.set_text(mascot_line())
    ui.vbtn_m.set_text(view_btn_label(0))
    ui.vbtn_w.set_text(view_btn_label(1))
    ui.vbtn_d.set_text(view_btn_label(2))
    // ── 周视图 7 行 ──
    ui.wk_b0.set_text(week_weekday(0))
    ui.wk_d0.set_text(week_mmdd(0))
    ui.wk_s0.set_text(week_sum(0))
    ui.wk_t0.set_text(week_today_label(0))
    ui.wk_b1.set_text(week_weekday(1))
    ui.wk_d1.set_text(week_mmdd(1))
    ui.wk_s1.set_text(week_sum(1))
    ui.wk_t1.set_text(week_today_label(1))
    ui.wk_b2.set_text(week_weekday(2))
    ui.wk_d2.set_text(week_mmdd(2))
    ui.wk_s2.set_text(week_sum(2))
    ui.wk_t2.set_text(week_today_label(2))
    ui.wk_b3.set_text(week_weekday(3))
    ui.wk_d3.set_text(week_mmdd(3))
    ui.wk_s3.set_text(week_sum(3))
    ui.wk_t3.set_text(week_today_label(3))
    ui.wk_b4.set_text(week_weekday(4))
    ui.wk_d4.set_text(week_mmdd(4))
    ui.wk_s4.set_text(week_sum(4))
    ui.wk_t4.set_text(week_today_label(4))
    ui.wk_b5.set_text(week_weekday(5))
    ui.wk_d5.set_text(week_mmdd(5))
    ui.wk_s5.set_text(week_sum(5))
