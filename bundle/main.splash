fn export_to_entry() {
    ui.entry.set_text(export_ics(events))
    set_status_ok("已生成 ICS 文本（" + ("" + events.len()) + " 个事件），复制即可带走")
    refresh_all()
}


// ---------------------------------------------------------------- 持久化

fn load() {
    let n = 0
    if fs.exists(KEYS_FILE) {
        let v = fs.read(KEYS_FILE).parse_json()
        if v != nil {
            events = v
            n = v.len()
        }
    }
    // 初值：三个面板收起；月历/指标/节日行按规则可见。
    // ★ 一律走 sync_panels() —— 面板显隐只允许有一个出口（见它的注释），
    //   这里原来手写 set_visible，新增面板时漏一个就是这个类缺陷的来源。
    // ★ 2026-10-01：先定「关注日」= 今天，再读旁路存储（待办/心情/目标/胶囊/共享）。
    init_focus()
    load_aux()
    sync_panels()
    ui.confirm_bar.set_visible(false)
    ui.conflict_bar.set_visible(false)
    ui.conflict_detail.set_visible(false)
    refresh_all()
    set_status("已加载 " + ("" + n) + " 个事件")
}


// 解析警告摘要。
// ⚠️ 原先只返回「（N 条警告）」：用户知道自己出错了，却不知道错在哪一行、
//    错在哪个字段 —— 知道有错但不知道错在哪，等于没说。
//    状态条只有一行（≈33 字符），所以报**第一条**的具体内容 + 剩余条数；
//    行号足够让人回到源文件定位。
fn err_msg() {
    if errors.len() == 0 { return "" }
    if errors.len() == 1 { return " · " + errors[0] }
    return " · " + errors[0] + " 等 " + ("" + errors.len()) + " 条"
}


// 重算冲突与建议，并刷新状态栏 + 冲突面板
fn scan_conflicts() {
    conflicts = find_conflicts(events)
    advice = build_advice(conflicts, events)
    show_advice = conflicts.len() > 0
    // ⚠️ 这里**不要**再往状态条上拼「含 N 条重复日程」：状态条是单行固定宽度，
    //    实测多出 6 个字就换行 → 第二行被容器裁掉一半，还压住了下面的冲突条。
    //    重复日程的告知改由两处承担（都不动布局）：
    //      ① 列表里每条重复日程都挂「每周重复 / 每年重复」描边标签；
    //      ② 导入面板的说明文字事先讲清楚规则会被保留。
    // 文案照设计稿：`已写入 3 个事件 · 新增 3 / 改期 0 / 跳过 0`（.status.ok）
    if conflicts.len() == 0 {
        set_status_ok("已写入 " + ("" + events.len()) + " 个事件 · 新增 " + ("" + added)
            + " / 改期 " + ("" + updated) + " / 跳过 " + ("" + skipped))
    } else {
        set_status_warn("已写入 " + ("" + events.len()) + " 个事件 · 发现 "
            + ("" + conflicts.len()) + " 处时间冲突")
    }
    sync_conflict()
}


// 第 3 步：确认写入
fn confirm_import() {
    if merged.len() == 0 {
        set_status_warn("没有待写入的内容")
        return
    }
    events = merged
    save()
    ui.entry.set_text("")
    merged = []
    // 写入完成 → 收起导入面板，让主列表立刻显示刚写进去的事件
    import_open = false
    // ★ 走唯一出口。这里原来手写了 3 行 set_visible（import_panel / cal_box / metrics），
    //   而 fest_bar 是**新加的常驻条、旧代码里从不隐藏**，所以当时没暴露问题；
    //   但现在 toggle_import() 改成按规则让位（导入时连 fest_bar 一起收起来给确认条腾地方），
    //   手写这 3 行就会把 fest_bar 永久留在隐藏态 —— 说明行在第一次导入之后再也不出现。
    //   接线到 sync_panels() 从根上消掉这类「五处手动同步」的漂移。
    sync_panels()
    scan_conflicts()
    refresh_all()
}


// 占位：保留接口，避免重复应用同一条建议时叠加
fn applied_done(ad, k) {
    return false
}


// 630 → "1030"，用于拼回 ICS 的 DTSTART
fn clock_compact(minutes) {
    if minutes < 0 { return "0000" }
    let h = ipart(minutes / 60)
    let m = minutes - h * 60
    let hs = "" + h
    if h < 10 { hs = "0" + hs }
    let ms = "" + m
    if m < 10 { ms = "0" + ms }
    return hs + ms
}


// 重算冲突并刷新两个面板（「查冲突」按钮）
fn rescan_ui() {
    scan_conflicts()
    sync_conflict()
    refresh_all()
}


// 一键应用建议：把建议里的「可动方」移到提议的空档
fn apply_advice() {
    if advice.len() == 0 {
        set_status("当前没有待处理的冲突")
        return
    }
    let applied = 0
    for i in advice.len() {
        let ad = advice[i]
        if !ad.has_slot { continue }
        // 找到 mover 并改时间（同一天，替换分钟）。
        // ⚠️ Splash 对 events[k].field = x 的成员写不可靠 —— 整体换对象。
        for k in events.len() {
            if events[k].uid == ad.mover && applied_done(ad, k) == false {
                let e = events[k]
                // 全天事件不能改期成某个时段 —— 会把整天承诺降级成 1 小时会议，
                // 语义直接变了。宁可少应用一条，也不动它。
                if e.all_day { continue }
                // 带 RRULE 的事件同理：屏幕上只有「首个实例」这一行，但底下是
                // 一整条重复序列。挪它等于悄悄改掉用户未来所有的例会时间，
                // 而且 COUNT/UNTIL/BYDAY 的语义还会跟着漂。不动它。
                if e.rrule != "" { continue }
                let dp = date_of(e.dtstart)
                let dpe = date_of(e.dtend)
                if dpe == "" { dpe = dp }
                // ⚠️ 保留原时间的类型后缀：原 DTSTART 是 `...103000Z`（UTC），
                //    重建时若丢掉 Z，读回就变成「浮动时间」，与 SEQUENCE/时区语义不符。
                let sfx = ""
                if e.start_utc { sfx = "Z" }
                events[k] = {
                    uid: e.uid, summary: e.summary,
                    dtstart: dp + "T" + clock_compact(ad.slot_start) + "00" + sfx,
                    dtend: dpe + "T" + clock_compact(ad.slot_end) + "00" + sfx,
                    location: e.location, description: e.description,
                    organizer: e.organizer, status: e.status, sequence: e.sequence,
                    // ⚠️ 新建对象必须列全所有字段：Splash 读一个从没写过的键
                    //    会抛 "property not found in prototype chain"，
                    //    而且抛错后该实例的**后续写操作全部静默失效**。
                    rrule: e.rrule, exdate: e.exdate, rdate: e.rdate,
                    dtstamp: e.dtstamp,
                    all_day: false, start_utc: e.start_utc, timezone: e.timezone,
                    start_minutes: ad.slot_start, end_minutes: ad.slot_end
                }
                applied = applied + 1
            }
        }
    }
    save()
    scan_conflicts()
    if applied > 0 {
        set_status_ok("已应用 " + ("" + applied) + " 条改期建议 · 剩余 " + ("" + conflicts.len()) + " 处冲突")
    } else if conflicts.len() > 0 {
        // 不能静默失败：全天事件不参与改期，没有空档也无从下手 —— 都得说清楚。
        set_status("建议未能应用（涉及全天事件，或当天没有够长的空档）")
    }
    refresh_all()
}


fn cancel_import() {
    merged = []
    // 放弃这次预览 → 一并收起导入面板，回到主列表视图
    import_open = false
    // ★ 同 confirm_import：走 sync_panels()（理由见那里的注释）
    sync_panels()
    set_status("已取消，事件库未改动")
    refresh_all()
}


// 快照：保留最近几次导入前的状态，便于回滚（评审要求的"失败/空状态"友好）
fn save_snapshot(list) {
    let snaps = []
    if fs.exists(SNAP_FILE) {
        let v = fs.read(SNAP_FILE).parse_json()
        if v != nil { snaps = v }
    }
    snaps.push({ at: time_now(), count: list.len(), data: list })
    // 只留最近 5 份
    while snaps.len() > 5 {
        let kept = []
        for i in snaps.len() { if i > 0 { kept.push(snaps[i]) } }
        snaps = kept
    }
    fs.write(SNAP_FILE, snaps.to_json())
}


fn undo_last() {
    if !fs.exists(SNAP_FILE) {
        set_status_warn("没有可回滚的快照")
        return
    }
    let snaps = fs.read(SNAP_FILE).parse_json()
    if snaps == nil || snaps.len() == 0 {
        set_status_warn("没有可回滚的快照")
        return
    }
    // 用倒数第 2 份（倒数第 1 份是刚才导入后的状态）
    let target = snaps.len() - 2
    if target < 0 {
        events = []
        set_status_ok("已清空事件库")
        save()
        refresh_all()
        return
    }
    events = snaps[target].data
    save()
    set_status_ok("已回滚到 " + ("" + events.len()) + " 个事件")
    refresh_all()
}


// ---------------------------------------------------------------- 导入流程

// 一步到位：读输入框 → 全量解析 → 合并 → 出预览。
// ⚠️ 不在 start_timeout / on_click 里做「可能抛错 + 需要回滚」的操作：
//    回调抛错会让该实例后续写入全部失效，且现场无栈可看。
fn start_import() {
    let text = ui.entry.text()
    if text == nil {
        set_status_warn("输入框是空的，先把 .ics 内容粘进来")
        return
    }
    if text.trim() == "" {
        set_status_warn("输入框是空的，先把 .ics 内容粘进来")
        return
    }
    if text.search("BEGIN:VCALENDAR") < 0 {
        set_status_warn("这看起来不是 ICS 文件（找不到 BEGIN:VCALENDAR）")
        refresh_all()
        return
    }

    import_text = text
    let c = parse_all(text)
    chunk = c
    errors = c.errors
    let incoming = c.events

    if incoming.len() == 0 {
        set_status_warn("没有解析出任何事件" + err_msg())
        refresh_all()
        return
    }

    // 合并（幂等 + 改期检测）
    let r = merge_events(events, incoming)
    merged = r.merged
    added = r.added
    updated = r.updated
    skipped = r.skipped

    // 存快照，支持回滚
    save_snapshot(merged)

    // 有警告时状态条优先报原因：一行放不下「统计 + 具体错误」两套信息，
    // 而用户此刻更需要知道「为什么少了几个事件」。
    if errors.len() > 0 {
        set_status_warn("解析 " + ("" + incoming.len()) + " 个 · 跳过 "
            + ("" + skipped) + err_msg())
    } else {
        set_status("解析 " + ("" + incoming.len()) + " 个：新增 " + ("" + added)
            + " / 改期 " + ("" + updated) + " / 跳过 " + ("" + skipped))
    }
    refresh_all()
}


fn clear_all() {
    events = []
    merged = []
    import_text = ""
    ui.entry.set_text("")
    save()
    set_status_ok("事件库已清空，输入框也一并清掉了")
    refresh_all()
}


// ---------------------------------------------------------------- 视图数据
//
// 这一节全部是「把数据整理成 UI 想直接吃的形状」，不含业务判断。
// ⚠️ 铁律仍适用：绝不读未声明的键、绝不抛错。

// 数字补零：7 → "07"
fn pad2(n) {
    let x = ipart(n)
    if x < 0 { x = 0 }
    if x < 10 { return "0" + ("" + x) }
    return "" + x
}


// kind → 颜色，对应设计稿 .d / .d.out / .d.today
fn cal_color(kind) {
    if kind == 2 { return #xffffff }
    if kind == 1 { return c_ink2 }
    return #xc9c3bc
}


// 显示哪个列表：有预览看预览，没预览看事件库
fn display_list() {
    if merged.len() > 0 { return merged }
    return events
}


// 判断事件类型，决定左侧色条颜色。
//   work    = 有 organizer 或 location 含会议地址
//   holiday = 摘要含「截止 / 冻结 / deadline」等硬承诺词
//   allday  = VALUE=DATE 全天事件
//   plain   = 其余
fn kind_of(ev) {
    if ev.all_day { return "allday" }
    let s = upper_ascii(ev.summary)
    if s.search("截止") >= 0 { return "holiday" }
    if s.search("冻结") >= 0 { return "holiday" }
    if s.search("DEADLINE") >= 0 { return "holiday" }
    if s.search("FREEZE") >= 0 { return "holiday" }
    if ev.organizer != "" { return "work" }
    if ev.location != "" { return "work" }
    return "plain"
}


// 时间区间显示："10:00" + 结束 "11:00"；全天 → "全天"
fn time_range(ev) {
    if ev.all_day { return "全天" }
    if ev.start_minutes < 0 { return "全天" }
    if ev.end_minutes < 0 { return pretty_time(ev.start_minutes) + " – --:--" }
    return pretty_time(ev.start_minutes) + " – " + pretty_time(ev.end_minutes)
}


// 时区/来源标记："UTC" / "Asia/Shanghai" / 空
fn tz_label(ev) {
    if ev.all_day { return "全天" }
    if ev.timezone != "" { return ev.timezone }
    if ev.start_utc { return "UTC" }
    return "本地"
}


// RRULE → 简短中文标签。
// Splash 没有 contains/starts_with，用 `split(子串).len() > 1` 判断包含关系。
// ⚠️ 返回的必须是**含中文的短词**，所以渲染端这一项走 font_regular；
//    千万别塞 `↻` 之类符号，font_code 缺字形会变豆腐块。
fn rrule_label(r) {
    if r == "" { return "" }
    if r.split("FREQ=DAILY").len() > 1 { return "每天重复" }
    if r.split("FREQ=WEEKLY").len() > 1 { return "每周重复" }
    if r.split("FREQ=MONTHLY").len() > 1 { return "每月重复" }
    if r.split("FREQ=YEARLY").len() > 1 { return "每年重复" }
    if r.split("FREQ=HOURLY").len() > 1 { return "每小时重复" }
    if r.split("FREQ=MINUTELY").len() > 1 { return "每分钟重复" }
    return "重复日程"
}


// ── .ev-time 两行：上=开始时间（mono 11.5 ink2），下=结束时间（mono 10.5 ink3）
//    设计稿：<div class="ev-time">10:00<span class="end">11:00</span></div>
fn ev_time_start(ev) {
    if ev.all_day { return "全天" }
    if ev.start_minutes < 0 { return "全天" }
    return pretty_time(ev.start_minutes)
}


fn ev_time_end(ev) {
    if ev.all_day { return "" }
    if ev.start_minutes < 0 { return "" }
    if ev.end_minutes < 0 { return "" }
    return pretty_time(ev.end_minutes)
}


// ── .ev-meta 的条目数组。每条 = {ic, v, tag}
//    设计稿：定时事件 → ◎地点 · 时区；全天事件 → [VALUE=DATE 标签] #seq 2
// 把 location 按空格拆成若干「段」，每段标明是否用等宽字体。
//   mono 段（房间号 / 链接 / 纯 ASCII）走 font_code：字宽 ≈0.6em。
//   非 mono 段（含中文的地名）走 font_regular：字宽 ≈0.9em，但只有它才有 CJK 字形。
// ⚠️ 实测「腾讯会议 123-456-789」整段用 font_regular 宽 195px，正文区放不下，
//    会把行尾时区顶出去、被裁成「Asia/Sh」。拆段后同一行只占 ~121px。
// ⚠️ 本函数必须在 ev_meta_items **之前**定义（Splash 不允许函数体内前向引用）。
fn loc_segs(loc) {
    let out = []
    let parts = loc.split(" ")
    let i = 0
    for p in parts {
        if p != "" {
            if i == 0 {
                out.push({ v: "@ " + p, mono: false })
            } else {
                out.push({ v: p, mono: true })
            }
            i = i + 1
        }
    }
    return out
}


fn ev_meta_items(ev) {
    let out = []
    // 每项结构：{ ic, segs: [ {v, mono} ], tag }
    //   tag: true  → 渲染成描边小标签（设计稿 .tag）
    //   mono       → 该段用 font_code（窄），否则 font_regular（宽，但有 CJK）
    // ⚠️ 图标（@ · #）一律**拼进文本**，不再做独立 Label：
    //    实测每个 Label 有 ≈7px 水平开销，meta 里 5 个 Label 就是 ~35px ——
    //    正是「Asia/Shanghai」被裁掉的直接原因。拼进去后 meta 只剩 3 个 Label。
    // ⚠️ 重复标签放在**最前**：它是对语义影响最大的一条属性，
    //    用户扫一眼列表就得知道「这行不是单次事件」。
    if ev.rrule != "" {
        out.push({ ic: "", segs: [ { v: rrule_label(ev.rrule), mono: false } ], tag: true })
    }
    if ev.all_day {
        out.push({ ic: "", segs: [ { v: "VALUE=DATE", mono: true } ], tag: true })
        if ev.sequence > 0 {
            out.push({ ic: "", segs: [ { v: "# seq " + ("" + ev.sequence), mono: true } ], tag: false })
        }
        return out
    }
    if ev.location != "" {
        out.push({ ic: "", segs: loc_segs(ev.location), tag: false })
    }
    let tz = tz_label(ev)
    if tz == "全天" {
        out.push({ ic: "", segs: [ { v: "· " + tz, mono: false } ], tag: false })
    } else {
        out.push({ ic: "", segs: [ { v: "· " + tz, mono: true } ], tag: false })
    }
    return out
}


// ── 日期算术（不引入 Date 库，纯整数） ──
// 闰年判断
fn is_leap(y) {
    if y % 400 == 0 { return true }
    if y % 100 == 0 { return false }
    if y % 4 == 0 { return true }
    return false
}


fn days_in_month(y, m) {
    if m == 2 {
        if is_leap(y) { return 29 }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 { return 30 }
    return 31
}


// 蔡勒公式变体：返回当月 1 号的星期（0=周一 … 6=周日），用于对齐「一」开头
fn first_weekday_mon0(y, m) {
    let yy = y
    let mm = m
    if mm < 3 { mm = mm + 12; yy = yy - 1 }
    let k = yy % 100
    let j = ipart(yy / 100)
    // Zeller: h = (q + floor(13(m+1)/5) + K + floor(K/4) + floor(J/4) + 5J) mod 7
    // h: 0=Saturday … 6=Friday ；q = 1
    let q = 1
    let t1 = q
    let t2 = ipart(13 * (mm + 1) / 5)
    let t3 = k
    let t4 = ipart(k / 4)
    let t5 = ipart(j / 4)
    let t6 = 5 * j
    let h = (t1 + t2 + t3 + t4 + t5 + t6) % 7
    // h: 0=Sat,1=Sun,2=Mon … 6=Fri  → 转成 0=Mon … 6=Sun
    let mon0 = h - 2
    if mon0 < 0 { mon0 = mon0 + 7 }
    return mon0
}


// 今天（card-host 下 local_time 是 UTC）
fn today_parts() {
    let t = local_time(time_now())
    // ⚠️ 不保证所有宿主都有这些字段，做正面守卫
    let y = 2026
    let m = 10
    let d = 9
    if t.year >= 2000 { y = t.year }
    if t.month >= 1 && t.month <= 12 { m = t.month }
    if t.day >= 1 && t.day <= 31 { d = t.day }
    return { year: y, month: m, day: d }
}


// 已经写进事件库的日期集合 → 用于月历上的小圆点。
// 返回一个「扁平字符串」，因为 Splash 没有 Set；用 " 20261004 20261005 " 查子串。
// 是否显示中国的「法定放假 / 调休上班」标记。
// 「仅国际」模式下必须完全不显示国内的放假安排 —— 否则切到国际节日，
// 格子里的绿点和「班」字还杵在那儿，等于切了个寂寞。
// 这个判断收在 holiday_kind 一处，月历格子、说明行、仪表盘全都自动跟着走。
fn cn_holiday_shown() {
    return festival_mode != 1
}


// 某一天的性质：0 = 普通日 · 1 = 法定放假 · 2 = 调休上班
// ⚠️ 用 pad2 统一补零再拼 `|YYYYMMDD|`：节假日表是字符串，靠
//    `search("|日期|")` 命中。两端竖线不能省，否则 "2025101" 会误命中
//    "20251011"（10 月 11 日调休上班），把整天的判断带偏。
fn holiday_kind(y, m, d) {
    if !cn_holiday_shown() { return 0 }
    let key = "|" + ("" + ipart(y)) + pad2(m) + pad2(d) + "|"
    if HOLIDAYS.search(key) >= 0 { return 1 }
    if WORKDAYS.search(key) >= 0 { return 2 }
    return 0
}


// 当月放假/调休摘要，例如「放假 7 天 · 10/10 上班」；当月没有则返回 ""。
// 不做「连休区间」推算（需要处理跨月，如 2025 端午 5/31–6/2），
// 只给放假总天数和需要上班的日期 —— 后者才是真正容易记错、最该被标出来的信息。
fn month_holiday_note(y, m) {
    let dim = days_in_month(y, m)
    let hi = dim + 1
    let nhol = 0
    let wd = ""
    for d in 1..hi {
        let k = holiday_kind(y, m, d)
        if k == 1 { nhol = nhol + 1 }
        if k == 2 {
            if wd != "" { wd = wd + "、" }
            wd = wd + ("" + ipart(m)) + "/" + ("" + d)
        }
    }
    if nhol == 0 && wd == "" { return "" }
    let s = ""
    if nhol > 0 { s = "放假 " + ("" + nhol) + " 天" }
    if wd != "" {
        if s != "" { s = s + " · " }
        s = s + wd + " 上班"
    }
    return s
}


// ── 节日名称查询 ────────────────────────────────────────────────────

// 中国节日：这天落在哪个节日区间里 → 返回名称，否则 ""。
// CN_SPANS 是 `起|止|名|起|止|名|…`（无空洞，见常量处的说明），按 3 项一组扫描。
// ⚠️⚠️ 血泪（2026-09-30）：两个坑叠在一起，定位花了很久 ——
//   ① 索引必须是**整数**。`i = k * 3` 算出来可能是浮点，`parts[i]` 取不到值
//      （静默失败，不报错！）→ 一律过 ipart()。
//   ② 字段步长依赖常量的竖线写法。第 ① 条修好却仍然取不到名字，真凶是
//      常量每行首尾都带竖线、拼出 `||` 空字段，把步长从 3 顶成了 4。
// 比较用 to_f64 转数字，不用字符串字典序（"20260101" vs "202691" 长度不等时
//    字典序会给出反直觉结果）。
fn cn_festival_on(y, m, d) {
    let parts = CN_SPANS.split("|")
    let n = parts.len()
    let key = (("" + ipart(y)) + pad2(m) + pad2(d)).to_f64()
    for k in 0..13 {
        let i = ipart(k * 3)
        let j = ipart(i + 1)
        let j2 = ipart(i + 2)
        if j2 >= n { break }
        let sv = parts[i].to_f64()
        let ev = parts[j].to_f64()
        if key >= sv && key <= ev { return parts[j2] }
    }
    return ""
}


// 格子里显示的节日名。
//   为什么需要它：CN_SPANS 里 2025 年那组叫「国庆中秋」（4 个字），
//   直接画进格子会被裁成「国庆中秂」—— 实测 2025-10 就是这样。
//   格子内容宽 ≈52px，4 个汉字 @9px ≈ 49px，再加绿点(3.5)+间距(2) 就超了。
//   超过 3 字时取前 2 字（假期主体是国庆，信息不丢）；3 字及以内原样保留
//   （劳动节/中秋节都放得下）。**不动 CN_SPANS 常量** —— 说明行的
//   「国庆中秋 10/1」还要用全名，那里宽度够。
fn cell_fest_name(n) {
    if n.len() > 3 { return substr(n, 0, 2) }
    return n
}


// 国际节日：固定公历日期，MMDD 精确匹配。索引同样必须 ipart 过。
fn intl_festival_on(m, d) {
    let parts = INTL_FIXED.split("|")
    let n = parts.len()
    let key = pad2(m) + pad2(d)
    for k in 0..9 {
        let i = ipart(k * 2)
        let j = ipart(i + 1)
        if j >= n { break }
        if parts[i] == key { return parts[j] }
    }
    return ""
}


// 当前模式下某天的节日名（中国优先）。
fn festival_on(y, m, d) {
    if festival_mode == 0 || festival_mode == 2 {
        let cn = cn_festival_on(y, m, d)
        if cn != "" { return cn }
    }
    if festival_mode == 1 || festival_mode == 2 {
        return intl_festival_on(m, d)
    }
    return ""
}


// 当月节日摘要。
//   · 只有一个节日 → 带日期，例如「中秋 9/25」（信息量最大，且放得下）
//   · 两个以上     → **只列名字**，例如「国庆 · 万圣节」
// 为什么两个以上不写日期：说明行可用宽 ≈359px（412 − 20·2 内边距 − 圆点 − 间距），
//   11px 下中文 ≈1.35em / ASCII ≈0.9em。带日期的 3 条
//   「国庆 10/1 · 万圣节 10/31 · 圣诞节 12/25」≈354px 已经贴边，
//   再加「等 N 个」必爆 → Label 自己折行、被固定高容器裁掉（实测踩过）。
//   只列名字后最坏情况 ≈209px，任何组合都稳。
// 连续假期同名只报一次（否则「春节 2/15 · 春节 2/16 · …」刷屏）；
//   节日名超过 3 个就折叠成「等 N 个」。
fn festival_note(y, m) {
    let dim = days_in_month(y, m)
    let hi = dim + 1
    let nm1 = ""
    let d1 = 0
    let names = ""
    let cnt = 0
    let seen = " "
    for d in 1..hi {
        let nm = festival_on(y, m, d)
        if nm == "" { continue }
        if seen.search(" " + nm + " ") >= 0 { continue }
        seen = seen + nm + " "
        cnt = cnt + 1
        if cnt == 1 { nm1 = nm; d1 = d }
        if cnt <= 3 {
            if names != "" { names = names + " · " }
            names = names + nm
        }
    }
    if cnt == 0 { return "" }
    if cnt == 1 { return nm1 + " " + ("" + ipart(m)) + "/" + ("" + d1) }
    if cnt > 3 { names = names + " 等 " + ("" + cnt) + " 个" }
    return names
}


// 来源按钮的文案
fn cycle_festival_mode() {
    festival_mode = festival_mode + 1
    if festival_mode > 2 { festival_mode = 0 }
    refresh_all()
}


// ══════════════════════════════════════════════════════════════════════
//  新建日程 · 重复规则（2026-09-30 用户要求）
//  原话：「为什么那些日期不能点开」「我想在某一天写我要做什么」
//        「或者专门有一个界面，选择日期、选择重复 —— 比如生日设每年重复」
//  做法：点月历格子 → 预填该日期打开面板；面板里可改标题 / 日期 / 重复。
//        「每年」是刚需（生日、纪念日），所以下面 repeat_hits() 做**轻量展开**。
// ══════════════════════════════════════════════════════════════════════

// 格子底色：选中格用 c_sel_bg（画进画布、不经过动画器），
// 其余按「这一天有多少事」铺一层热度底。
// ★ 2026-10-01：这就是用户要的「以月为单位的事件图」—— **零额外高度**：
//   不另开图表区（那要多占 ~60px，会把面板底部按钮挤出视口），
//   而是让格子本身变成热力图。事件越多底色越暖，一眼看出哪几天最忙。
// ⚠️ 上/下月的格子（kind == 0）不参与热度：它们不属于当前月，
//    画上颜色只会让人误以为「这个月很忙」。
// ⚠️ 热度档位 **不在这里算** —— cell_bg 是 on_render 里每帧每格都会走的路径，
//    在这儿数事件等于每帧重算 42 遍。档位由 cal_cells() 算好、随格子对象带出来（hlv）。
//    血泪：早先这里写的是 `heat_color(heat_of(c.d8))`，而 heat_of 根本没有函数体 ——
//    运行时报 `variable heat_of not found in scope`，on_render 的整个产出被丢弃，
//    月历直接空白，还连带 refresh_all() 静默中断。静态门禁 deps.py 抓不到这种
//    「运行时上下文里的未定义引用」，只有真跑起来才会爆。
fn cell_bg(i, c) {
    if i == sel_idx { return c_sel_bg }
    if c.kind == 0 { return c_card }
    return heat_color(c.hlv)
}


// 格子数字颜色：选中格改赤陶，其余沿用当天的语义色（放假绿 / 调休赤陶 / 普通灰）。
fn cell_num(base, i) {
    if i == sel_idx { return c_accent }
    return base
}


fn repeat_label(mode) {
    if mode == 1 { return "每天" }
    if mode == 2 { return "每周" }
    if mode == 3 { return "每月" }
    if mode == 4 { return "每年" }
    return "不重复"
}


fn repeat_rule(mode) {
    if mode == 1 { return "FREQ=DAILY" }
    if mode == 2 { return "FREQ=WEEKLY" }
    if mode == 3 { return "FREQ=MONTHLY" }
    if mode == 4 { return "FREQ=YEARLY" }
    return ""
}


fn cycle_repeat() {
    new_repeat = new_repeat + 1
    if new_repeat > 4 { new_repeat = 0 }
    ui.nr_btn.set_text(repeat_label(new_repeat))
}


// 只有本应用自己写出来的**朴素**规则才允许展开。
// ★★ 2026-09-30 自检抓到的一个真 bug（注释与实现矛盾）：
//    `repeat_hits` 用的是 `r.split("FREQ=MONTHLY").len() > 1`，它**连修饰一起匹配** ——
//    导入的 `RRULE:FREQ=MONTHLY;BYDAY=-1FR`（每月最后一个周五）照样命中，
//    然后按「和起始日同号」去标，标出来的日子跟真实规则**毫无关系**；
//    `FREQ=WEEKLY;INTERVAL=2`（隔周一次）被当成每周标；
//    `FREQ=YEARLY;UNTIL=…` 忽略 UNTIL，过期了还在往后标。
//    而上面的注释明明写着「`FREQ=MONTHLY;BYDAY=-1FR` 表达不出来，就不标」——
//    也就是说**代码没有实现它承诺的规则**。导入的 RRULE 是原样存下来的
//    （见解析分支 `cur.rrule = value.trim()`），所以这条路真的能走到。
//    修法：白名单精确匹配。带 BYDAY / BYMONTHDAY / INTERVAL / COUNT / UNTIL /
//    BYSETPOS 等任何修饰的，一个点都不标 —— 宁可少标，不可乱标。
//    （DTSTART 那天仍由 marked_days 的 dn 分支单独标出来，不会漏掉事件本身。）
fn rrule_plain(r) {
    if r == "FREQ=DAILY" { return true }
    if r == "FREQ=WEEKLY" { return true }
    if r == "FREQ=MONTHLY" { return true }
    if r == "FREQ=YEARLY" { return true }
    return false
}


// 某事件是否落在 (y, m, d) 这一天。
// ⚠️ 定位说明：本应用**不展开** RRULE（见 new_event 的注释：展开要处理
//    EXDATE / RDATE / COUNT / UNTIL 和跨时区夏令时，超出原型范围），
//    RRULE 只做「原样保存 + 原样导出」。
//    但用户明确提了一个场景：「生日设成每年重复，那每一年这个日期都要显示」——
//    完全「不展开」就等于这个需求做不到。所以这里加一个**只面向当前显示月份**的
//    轻量命中判断：够用、不引入 BYDAY / BYSETPOS 那套复杂度，也不改变导出语义
//    （事件本体仍只存一条，ICS 往返仍然字段级无损）。
//    命中不了的一律 false —— **宁可少标，不可乱标**。像
//    `FREQ=MONTHLY;BYDAY=-1FR`（每月最后一个周五）我们表达不出来，就不标。
fn repeat_hits(ev, y, m, d) {
    let r = ev.rrule
    if r == "" { return false }
    // ★ 白名单：只展开本应用自己写出的四种朴素规则。
    //   导入的 RRULE 一律**不展开**（只保留原样保存 / 原样导出 + DTSTART 当天一个点），
    //   理由与踩坑记录见 rrule_plain() 的注释。
    if !rrule_plain(r) { return false }
    let src = date_of(ev.dtstart)
    if src.len() != 8 { return false }
    // 起点之前不重复（换个说法：重复规则不回溯）
    let cur = ("" + y + pad2(m) + pad2(d)).to_f64()
    let snum = src.to_f64()
    if !(cur >= snum) { return false }
    // 一律用字符串比较，避开整数转换；pad2 之后长度一致，比较是安全的
    let sy = substr(src, 0, 4)
    let sm = substr(src, 4, 6)
    let sd = substr(src, 6, 8)
    let m2 = pad2(m)
    let d2 = pad2(d)
    if ("" + y) == sy && m2 == sm && d2 == sd { return true }
    if r.split("FREQ=YEARLY").len() > 1 { return m2 == sm && d2 == sd }
    if r.split("FREQ=MONTHLY").len() > 1 { return d2 == sd }
    if r.split("FREQ=WEEKLY").len() > 1 {
        // 同星期几即可：用 Zeller 推两边是周几（0 = 周一）
        let w1 = (first_weekday_mon0(y, m) + d - 1) % 7
        let w2 = (first_weekday_mon0(ipart(sy.to_f64()), ipart(sm.to_f64()))
                  + ipart(sd.to_f64()) - 1) % 7
        return w1 == w2
    }
    if r.split("FREQ=DAILY").len() > 1 { return true }
    return false
}


// 把用户填的日期解析成 "YYYYMMDD"。接受 2026-10-01 / 2026/10/01 / 2026.10.01 /
// 20261001 / 10-01（补当前显示年份）。
// **不要宽松到「猜」** —— 猜错日期比直接报错糟得多，所以月份/日都必须落在合法范围。
fn parse_date_input(s) {
    let t = s.trim()
    if t == "" { return "" }
    // 去掉常见分隔符
    let b = ""
    let a = t.split("-")
    for i in a.len() { b = b + a[i] }
    let c = b.split("/")
    b = ""
    for i in c.len() { b = b + c[i] }
    let e = b.split(".")
    b = ""
    for i in e.len() { b = b + e[i] }
    let f = b.split(" ")
    b = ""
    for i in f.len() { b = b + f[i] }
    if b == "" { return "" }
    let n = b.to_f64()
    if !(n >= 0) { return "" }
    if b.len() == 4 {
        // MM-DD → 补当前显示年份
        let mm = ipart(substr(b, 0, 2).to_f64())
        let dd = ipart(substr(b, 2, 4).to_f64())
        if mm < 1 || mm > 12 { return "" }
        if dd < 1 || dd > days_in_month(view_year(), mm) { return "" }
        return "" + view_year() + pad2(mm) + pad2(dd)
    }
    if b.len() != 8 { return "" }
    let yy = ipart(substr(b, 0, 4).to_f64())
    let mm = ipart(substr(b, 4, 6).to_f64())
    let dd = ipart(substr(b, 6, 8).to_f64())
    if yy < 1970 || yy > 2999 { return "" }
    if mm < 1 || mm > 12 { return "" }
    if dd < 1 || dd > days_in_month(yy, mm) { return "" }
    return b
}


fn open_new_on(y, m, d) {
    import_open = false
    about_open = false
    new_open = true
    new_repeat = 0
    ui.nt_input.set_text("")
    ui.nd_input.set_text(pretty_date("" + y + pad2(m) + pad2(d)))
    ui.nr_btn.set_text(repeat_label(0))
    sync_panels()
    refresh_all()
}


fn toggle_new() {
    if new_open {
        cancel_new()
        return
    }
    // 没点格子就新建 → 预填「今天」。最常见的意图就是「今天要做的事」。
    let tp = today_parts()
    open_new_on(tp.year, tp.month, tp.day)
}


// 点格子换日期。与 open_new_on 的区别只有一条：**面板已经开着时只改日期**，
// 保留已经敲进去的标题和重复档位。
// ★ 2026-09-30 自检补：原来 pick_cell 直接调 open_new_on（它无条件
//   `set_text("")` + `new_repeat = 0`）—— 用户写着「妈妈生日」想改个日期，
//   一点别的格子标题就没了；重复档位也从「每年」悄悄退回「不重复」。
//   这是真实可复现的数据丢失（虽然只丢用户还没保存的输入），必须分开。
fn retarget_new(y, m, d) {
    if !new_open { return 0 }
    ui.nd_input.set_text(pretty_date("" + y + pad2(m) + pad2(d)))
    sync_panels()
    refresh_all()
    return 1
}


fn cancel_new() {
    new_open = false
    sel_idx = -1          // 面板关掉就不再占着选中态
    sync_panels()
    refresh_all()
}


fn save_new() {
    let title = ui.nt_input.text().trim()
    if title == "" {
        set_status_warn("请先写「这天要做什么」")
        refresh_all()
        return
    }
    let d8 = parse_date_input(ui.nd_input.text())
    if d8 == "" {
        set_status_warn("日期填得不对 —— 用 2026-10-01 这种格式（也可以只写 10-01）")
        refresh_all()
        return
    }
    new_seq = new_seq + 1
    let ev = new_event()
    // uid 里带序号而不是时间戳：没有取当前时间的能力（见 new_event 的注释），
    // 而 uid 是 ICS 往返里「同一个事件」的判据，撞号会让两次导入互相合并。
    ev.uid = "manual-" + d8 + "-" + ("" + new_seq)
    ev.summary = title
    // 全天事件：DTSTART;VALUE=DATE，**不写 DTEND**。
    //   RFC 5545 里全天事件无 DTEND 就等于「一天」；而算 DTEND 需要「日期 +1 天」，
    //   得写跨月跨年进位 + 闰年判断 —— 多一个会算错的地方，收益只是导出文本多一行。
    //   往返仍然无损：读回来 dtend 还是空，导出还是不写。
    ev.dtstart = d8
    ev.dtend = ""
    ev.all_day = true
    ev.timezone = ""
    ev.rrule = repeat_rule(new_repeat)
    events.push(ev)
    save()
    new_open = false
    sel_idx = -1          // 存完就收掉选中态（新事件自己会在格子上点出圆点）
    sync_panels()
    scan_conflicts()
    refresh_all()
    let extra = ""
    if new_repeat != 0 { extra = " · " + repeat_label(new_repeat) + "重复" }
    set_status_ok("已新建「" + title + "」· " + pretty_date(d8) + extra)
    refresh_all()
}


// 点月历格子：下标 → 日期 → 打开新建面板（预填）。
// 用一个**覆盖整片网格的静态点击层**（42 个透明 ButtonFlat），而不是给 on_render
// 建的格子上挂 on_click —— on_render 重建出来的控件 on_click 不会重绑，点了没反应
// （实测，见 import_panel 上面 confirm_bar 的注释）。静态层顺带把「悬停高亮」也解决了：
// ButtonFlat 自带 color_hover，而 GestureView 只有在能定义 animator 时才有 hover
// （view.rs:1070 `if self.animator.is_defined`），脚本里定义不了 animator。
fn pick_cell(idx) {
    if idx < 0 || idx > 41 { return }
    let c = cal_cells()[idx]
    // 上/下月的格子不响应 —— 点了会改到别的月份，那是「猜」，不如不响应
    if c.kind == 0 { return }
    let d = ipart(c.txt.to_f64())
    if d < 1 { return }
    // ★ 选中态：只有**当前月**的格子才可能走到这里（上面刚拦掉上/下月），
    //   所以 sel_idx 与网格下标一一对应；翻月时必须重算（见 nav_month）。
    sel_idx = idx
    // ★ 2026-10-01：同时把「关注日」挪到这一天 —— 日/周视图、待办、心情
    //   全都以 focus_d8 为锚，点格子就是「我要看这一天」的唯一入口。
    focus_d8 = pad8(view_year(), view_month(), d)
    // 面板已经开着就只换日期（retarget_new），不要清掉用户已经敲好的标题。
    if retarget_new(view_year(), view_month(), d) == 1 { return }
    open_new_on(view_year(), view_month(), d)
}


// ══ 面板显隐的唯一出口 ═══════════════════════════════════════════
//   为什么要有这个函数：about / import / new 三个面板**都在抢同一块竖向空间**，
//   而 892px 的视口已经被「顶栏 + 月历 + 说明行 + 工具条 + 列表 + 状态条」占满。
//   血泪（2026-09-30，第二次踩）：metrics 只多占 19px，就把
//   「预览 · N 个事件尚未写入 | 取消 | 写入」这条确认条挤出视口，
//   「写入」按钮直接点不到（e2e 报 `FAIL: 找不到按钮「写入」`）。
//   所以显隐规则**只能有一处**，任何新增面板都必须在这里让位，而不是各自改各自的。
fn sync_panels() {
    // ★ 面板互斥的**兜底收口**（2026-09-30 自检补）：三个面板共用同一块竖向空间，
    //   同时开两个就会把底部内容挤出 892px 视口（实测：新建面板 + 导入面板叠加时
    //   确认条已经贴到 y≈705，再来一个面板就点不到了）。
    //   各 toggle 里已经各写了一句互斥，但那是**四处分散的 if** —— 将来只要新增
    //   一条打开路径（或漏写一条），就又会出现「两个面板叠着」。
    //   这里作为「面板显隐的唯一出口」再收一次口：优先级 新建 > 导入 > 关于。
    //   ⚠️ 这三行是「纠正状态」，不是「渲染状态」；后面三行 set_visible 才读它们。
    if new_open { about_open = false }
    if new_open { import_open = false }
    if import_open { about_open = false }
    // 「有面板开着」= 页面处于模态态。下面所有让位规则都只依赖这一个布尔量。
    let panel_on = about_open || import_open || new_open
    ui.about_panel.set_visible(about_open)
    // ★ 2026-10-01：导入 / 新建面板**只属于「日程」分区**。切到别的分区时把它们收起，
    //   但**不改** new_open / import_open 状态 —— 切回来内容还在。
    //   （若在这里强行置 false，用户在新建面板里敲了一半的标题，会因为点了一下
    //    「待办」就没了。状态归状态，显隐归显隐，两件事要分开。）
    ui.import_panel.set_visible(import_open && tab == 0)
    ui.new_panel.set_visible(new_open && tab == 0)
    // ★★ 分区导航在任何面板打开时**整条收起**。
    //   这是本轮最关键的防回归措施：面板打开时的竖向几何与改动前**完全一致**，
    //   所以从结构上不可能出现「新增的导航条把面板底部按钮挤出 892px 视口」。
    ui.tabbar.set_visible(!panel_on)
    ui.sec_todo.set_visible(tab == 1 && !panel_on)
    ui.sec_mood.set_visible(tab == 2 && !panel_on)
    ui.sec_goal.set_visible(tab == 3 && !panel_on)
    ui.sec_egg.set_visible(tab == 4 && !panel_on)
    // ── 「日程」分区 ──
    // 月历：关于页让位（它很长），导入页也让位（导入流程要一整屏）；
    //   **新建日程不让位** —— 用户正是在看着月历挑日期。
    let cal_on = tab == 0 && !about_open && !import_open
    // 工具条（导入/导出/计数）是日程的数据出入口，只在日程分区出现。
    ui.tools.set_visible(tab == 0)
    ui.cal_box.set_visible(cal_on)
    // 吉祥物互动条：日程分区 + 无面板时才在（面板打开时收起，避免白占位）。
    ui.mascot_bar.set_visible(tab == 0 && !panel_on)
    // 指标行更矮，只有关于/导入完全让位；新建面板时也收起，把空间给面板。
    let met_on = cal_on && !new_open
    ui.metrics.set_visible(met_on)
    // 节日说明行同 metrics。
    ui.fest_bar.set_visible(met_on)
    // ★ 视图切换条（月/周/日）2026-10-01 已并入 cal_box 的 cal-top 行 ——
    //   cal_box 一藏它就跟着藏，所以这里**不再**需要单独的 set_visible。
    //   （原先是独立一行，必须显式跟 metrics 同进退，否则会挤出面板底部按钮。）
    // ── 三个日历视图互斥 ──
    ui.grid.set_visible(cal_view == 0)
    ui.cv_week.set_visible(cal_view == 1)
    ui.cv_day.set_visible(cal_view == 2)
}


fn marked_days() {
    let s = " "
    for i in events.len() {
        let dn = date_of(events[i].dtstart)
        if dn.len() == 8 {
            if s.search(" " + dn + " ") < 0 {
                s = s + dn + " "
            }
        }
        // ★ 重复日程：把「当前显示的这个月」里所有命中的日子也标出来
        //   （生日设成每年重复 → 往后每一年的这个月那一天都有点）。
        //   只扫本月，不扫网格里的上/下月格子 —— 那些是 kind == 0，
        //   cal_cells 本来就不给它们画标记，扫了也是白扫。
        if events[i].rrule != "" {
            let vy = view_year()
            let vm = view_month()
            let dim = days_in_month(vy, vm)
            for k in 0..31 {
                let d = k + 1
                if d > dim { continue }
                if !repeat_hits(events[i], vy, vm, d) { continue }
                let c8 = "" + vy + pad2(vm) + pad2(d)
                if s.search(" " + c8 + " ") < 0 {
                    s = s + c8 + " "
                }
            }
        }
    }
    return s
}


// 来源数：按 timezone / all_day 组合粗算不同来源，仅用于仪表盘数字
fn source_count() {
    let n = 0
    let seen = " "
    for i in events.len() {
        let k = events[i].timezone
        if k == "" {
            if events[i].all_day { k = "DATE" }
            else if events[i].start_utc { k = "UTC" }
            else { k = "LOCAL" }
        }
        if seen.search("[" + k + "]") < 0 {
            seen = seen + "[" + k + "]"
            n = n + 1
        }
    }
    return n
}


// 最近一个事件日期（"10-04" 形式），没有则 "—"
fn latest_day_label() {
    let best = -1
    for i in events.len() {
        let d = date_num(events[i].dtstart)
        if d < 0 { continue }
        if best < 0 || d < best { best = d }
    }
    if best < 0 { return "—" }
    let s = "" + best
    return substr(s, 4, 6) + "-" + substr(s, 6, 8)
}


// 当前显示月（今天 + month_offset）
fn view_year() {
    let p = today_parts()
    let m = p.month + month_offset
    let y = p.year
    while m > 12 { m = m - 12; y = y + 1 }
    while m < 1 { m = m + 12; y = y - 1 }
    return y
}


fn view_month() {
    let p = today_parts()
    let m = p.month + month_offset
    while m > 12 { m = m - 12 }
    while m < 1 { m = m + 12 }
    return m
}


// 月历导航：-1 上一月，+1 下一月，0 回到本月
fn nav_month(d) {
    if d == 0 { month_offset = 0 } else { month_offset = month_offset + d }
    // ★ 2026-10-01：高亮不再「翻月就清空」，而是**按关注日重算**。
    //   理由：sel_idx 是**相对当前显示月份**的下标（0..41），换个月份之后同一个
    //   下标指的是完全不同的日期 —— 所以必须重算，不能沿用旧值（沿用就是
    //   「高亮跑到别的日子上」）。重算之后：关注日落在新月份里就继续高亮
    //   （翻走再翻回来还能看见），不在就自然是 -1。
    //   原来那行 `sel_idx = -1` 是「防错位」的一种做法，但它顺手把
    //   「翻回来还能看见」这个正常能力也一起删掉了。
    sel_idx = index_of_day(focus_d8)
    // ★ 新建面板绑定在**被点中的那一天**上，翻月之后那天已经不在视野里。
    //   只清高亮、把面板留着，会出现三方不一致 —— 面板写着「2026-09-21」、
    //   月历显示「2026 年 10 月」、格子上又没有任何高亮，用户看不出这个面板
    //   到底写给哪一天。翻月即视为放弃这次选择，一并收起。
    //   （**必须显式调 sync_panels()**：refresh_all() 不负责面板显隐。）
    new_open = false
    sync_panels()
    refresh_all()
}


// 月历 42 格的**纯数据**（不含控件）。
// ⚠️ 实测结论：控件块只有在词法上位于 on_render 闭包内才会被收集 ——
//    把它放进函数、靠函数调用「代为生成」是不生效的（静默失败、无日志）。
//    所以这里只算数据，控件在 on_render 里手写。
// 返回 [{txt, c, a}] 长度 42；a=强调(今天/有事件)
fn cal_cells() {
    let out = []
    let y = view_year()
    let m = view_month()
    let first = first_weekday_mon0(y, m)
    let dim = days_in_month(y, m)
    let marks = marked_days()
    // ★ 热度底色用的事件列表，整个 cal_cells() 只取一次，42 格共用。
    let dlist = display_list()
    let tp = today_parts()
    // ⚠️ 局部名别叫 today8 —— 那会**遮蔽**同名的全局函数（today8()）。
    //    这里虽然不调用它，但留着同名局部变量迟早会变成「明明有这个函数却报
    //    not a function」的怪问题，不值得省这三个字符。
    let today_key = "" + tp.year + pad2(tp.month) + pad2(tp.day)
    let m0 = pad2(m)
    let pm = m - 1
    let py = y
    if pm < 1 { pm = 12; py = y - 1 }
    let pdim = days_in_month(py, pm)

    for i in 0..42 {
        let dnum = i - first + 1
        let txt = ""
        let kind = 0
        let dot = false
        // hol: 0 = 普通日 · 1 = 法定放假 · 2 = 调休上班（补班）
        let hol = 0
        // fest: 当天有节日（按当前来源模式），但**照常上班** —— 用小黑点标出来。
        //   区分三种性质正是用户的诉求：「放假标小绿点、正常上班标小黑点、
        //   调休上班写个『班』字」。国际节日（妇女节/万圣节…）与国内无关，
        //   不放假，所以只能是小黑点。
        let fest = false
        // fname: 放假日对应的节日名，直接写成格子里的绿色小字（见标记行）。
        //   ★ 跟着 hol 走：hol 由 holiday_kind() 给出，而它第一句就是
        //     `if !cn_holiday_shown() { return 0 }` —— 也就是说**切到「仅国际」时
        //     绿点与绿字一起消失**。这是刻意的：用户主动选择「只看国际」，
        //     却还留着国内放假的标记，等于切了个寂寞（与 fest_line 让位同理）。
        //     一致性要求：绿点(hol==1)与绿字(fname!="")必须同进同退，
        //     所以 fname 的赋值条件就是 hol == 1，不能另立判据。
        //   用 cn_festival_on 而不是 festival_on 取名字：后者受「国际节日」
        //     那一半模式影响，在「全部」模式下取不到国庆/中秋的名字。
        let fname = ""
        // ★ 2026-10-01：格子带上自己的日期串（"YYYYMMDD"）。
        //   热度底色、日/周视图跳转都要按**日期**而不是格子下标来判断 ——
        //   下标只在「当前显示月份」内有效，翻月就全错位了。
        let c8 = ""
        // hlv: 热度档位（0..4）。也只对本月格子有意义；上/下月格子 kind == 0，
        //   cell_bg 直接返回卡片色，不看 hlv。放在这里算是因为它必须和 c8 同生共死
        //   —— 下标的月份口径和这儿不一致，出了这个块就再也对不上了。
        let hlv = 0
        if dnum >= 1 && dnum <= dim {
            txt = "" + dnum
            kind = 1
            let cell8 = "" + y + m0 + pad2(dnum)
            c8 = cell8
            hlv = heat_level(heat_count_in(cell8, dlist))
            if marks.search(" " + cell8 + " ") >= 0 { dot = true }
            if cell8 == today_key { kind = 2 }
            hol = holiday_kind(y, m, dnum)
            if hol == 1 { fname = cell_fest_name(cn_festival_on(y, m, dnum)) }
            if hol == 0 && festival_on(y, m, dnum) != "" { fest = true }
        } else if dnum < 1 {
            txt = "" + (pdim + dnum)
        } else {
            txt = "" + (dnum - dim)
        }
        out.push({ txt: txt, kind: kind, dot: dot, hol: hol, fest: fest, fname: fname, d8: c8, hlv: hlv })
    }
    return out
}


// 星期名（0=周一）
fn weekday_name(mon0) {
    if mon0 == 0 { return "周一" }
    if mon0 == 1 { return "周二" }
    if mon0 == 2 { return "周三" }
    if mon0 == 3 { return "周四" }
    if mon0 == 4 { return "周五" }
    if mon0 == 5 { return "周六" }
    return "周日"
}


// 取第 row 行的 7 格（0..5）。返回**数组**——on_render 里用 `for c in arr` 遍历。
// ⚠️ 官方示例证实 on_render 支持 `for x in array`；实测 `for x in 0..n`（range）
//    在 on_render 内不产出控件（静默）。所以这里返回数组而非下标。
fn cal_cells_of(row) {
    let all = cal_cells()
    let out = []
    for k in 0..7 {
        out.push(all[row * 7 + k])
    }
    return out
}


// "20261004" → "10 月 4 日"；用于按天分组的小标题
fn day_head_label(d8) {
    if d8.len() < 8 { return d8 }
    let m = substr(d8, 4, 6)
    let d = substr(d8, 6, 8)
    let mi = m.to_f64()
    let di = d.to_f64()
    if !(mi >= 0) { return d8 }
    if !(di >= 0) { return d8 }
    return ("" + mi) + " 月 " + ("" + di) + " 日"
}


// 该日期是周几（用蔡勒公式，输入 datetime 串）
// ⚠️ 血泪：q 必须是「日号」。之前这里写死成 1，算出来的是「当月 1 号」的星期，
//    导致 2026-10-04（周日）被显示成周四（10-01 才是周四）。已修。
fn weekday_of_dt(raw) {
    let d8 = date_of(raw)
    if d8.len() < 8 { return "" }
    let y = substr(d8, 0, 4).to_f64()
    let m = substr(d8, 4, 6).to_f64()
    let dd = substr(d8, 6, 8).to_f64()
    if !(y >= 0) { return "" }
    if !(m >= 0) { return "" }
    if !(dd >= 0) { return "" }
    let yy = y
    let mm = m
    if mm < 3 { mm = mm + 12; yy = yy - 1 }
    let k = yy % 100
    let j = ipart(yy / 100)
    // Zeller: h = (q + floor(13(m+1)/5) + K + floor(K/4) + floor(J/4) + 5J) mod 7
    // h: 0=Sat, 1=Sun, 2=Mon … 6=Fri
    let h = (dd + ipart(13 * (mm + 1) / 5) + k + ipart(k / 4) + ipart(j / 4) + 5 * j) % 7
    let mon0 = h - 2
    if mon0 < 0 { mon0 = mon0 + 7 }
    return weekday_name(mon0)
}


// 该日期的事件条数
fn count_on(d8, list) {
    let n = 0
    for i in list.len() {
        if date_of(list[i].dtstart) == d8 { n = n + 1 }
    }
    return n
}


// 按天分组：返回 [{d8, wd, count, idxs:[]}]
// ⚠️ 事件可能乱序，这里做插入排序（阈值小，手写即可，因为无 sort）
fn group_by_day(list) {
    let groups = []
    for i in list.len() {
        let d8 = date_of(list[i].dtstart)
        let hit = -1
        for g in groups.len() {
            if groups[g].d8 == d8 { hit = g }
        }
        if hit < 0 {
            groups.push({ d8: d8, n: date_num(list[i].dtstart), count: 1, idxs: [i] })
        } else {
            let g0 = groups[hit]
            let idl = []
            for x in g0.idxs.len() { idl.push(g0.idxs[x]) }
            idl.push(i)
            groups[hit] = { d8: d8, n: g0.n, count: idl.len(), idxs: idl }
        }
    }
    // 按日期升序（手写选择排序）
    let m = groups.len()
    for i in 0..m {
        let minj = i
        for j in (i + 1)..m {
            if groups[j].n < groups[minj].n { minj = j }
        }
        if minj != i {
            let tmp = groups[i]
            groups[i] = groups[minj]
            groups[minj] = tmp
        }
    }
    return groups
}

// ---------------------------------------------------------------- 界面
//
// 严格按 design 稿 prototype/ui-design-v1.html 复刻（「档案卷宗」语言）。
// 所有字号 / padding / 间距 / 颜色都照 CSS 原值，不做「美学发挥」。
//
// 设计稿原文（CSS 关键值）：
//   .head{padding:26px 20px 18px}  h1{27px/600}  .sub{12.5px margin-top:5px}
//   .headmeta{margin-top:14px;padding-top:12px;border-top:1px}  .v{19px/600} .k{10px}
//   .cal{padding:18px 20px 16px}  .cal-top{margin-bottom:12px} .ym{14.5px/600}
//   .nav button{26x24 radius:6}  .dow{9.5px gap:2 margin-bottom:5px}
//   .d{height:34px font:12.5px radius:7}
//   .tools{padding:12px 20px gap:8}  .btn{12.5px/500 padding:7px 14px radius:8px}
//   .status{margin:12px 20px;padding:9px 12px;radius:8px;font:12px}
//   .list{padding:0 20px 20px}  .daygroup{margin-top:18px}  .dayhead{padding-bottom:7px}
//   .dn{12px/600} .dw{11px} .dc{10px}  .ev{padding:11px 0;gap:12px}
//   .ev-time{flex:0 0 52px;11.5px}  .ev-title{13.5px/500}  .ev-meta{11px gap:10px}
//   .ev-flag{3px radius:2 margin:2px 0}
//   .empty{padding:52px 20px} .big{34px} h3{14px} p{12px}
//
// ⚠️ 平台事实（实测，血泪）：
//   1. `SolidView` 与 `View` 是**兄弟**，都继承 `ViewBase`；`on_render`/`render()`
//      只定义在 **`View`** 上。用 SolidView 挂 on_render = 静默失效。
//   2. 动态子节点在 `height: Fit` 父级里算不出高度 → 塌成 0，必须给显式高度。
//   3. on_render **不会自动跑**，必须显式 `ui.X.render()`。
//   4. 静态 Label 只在建树时求值一次 —— 凡是会变的值都要放进动态容器。

let about_open = false     // 关于面板
let import_open = false    // 导入面板（输入框只在这里出现）
let more_open = false      // 冲突细节展开
// ── 新建日程（2026-09-30 用户要求：「为什么日期不能点开」「我想在某一天写我要做什么」）──
let new_open = false       // 新建日程面板
let new_repeat = 0         // 重复档位：0 不重复 / 1 每天 / 2 每周 / 3 每月 / 4 每年
// uid 计数。**不能靠时钟** —— 本应用没有取当前时间的能力（见 new_event 的说明），
// 靠 events.len() 会重复（删掉一个再建一个就撞号），所以用一个只增不减的序号。
let new_seq = 0
// 当前选中的格子下标（0..41；-1 = 没选中）。只在「新建面板开着」时有意义。
// 它同时是**画布上高亮哪一格**的唯一依据（cell_bg / cell_num 都读它）。
let sel_idx = -1
let H_TAP = 32.0
let H_NAV = 24.0           // .nav button height:24px


fn toggle_more() {
    more_open = !more_open
    // 按钮是静态声明的（on_render 里建的按钮点不动），所以只能手动同步文案 ——
    // 否则展开了文案还写「详情」，用户不知道这是切换开关。
    if more_open {
        ui.more_btn.set_text("收起详情")
    } else {
        ui.more_btn.set_text("详情")
    }
    sync_conflict()
}


// 把事件列表拍平成「渲染行」，on_render 只需单层遍历。
//   天标题行：{t:"day", dl:"10 月 4 日", wd:"周日", cnt:"1 项"}
//   事件行：  {t:"ev", tm:"10:00", te:"11:00", sm:"...", mi:[{ic,v,tag}], fc: 色}
fn build_rows(list) {
    let out = []
    let groups = group_by_day(list)
    for g in groups.len() {
        let grp = groups[g]
        out.push({
            t: "day",
            dl: day_head_label(grp.d8),
            wd: weekday_of_dt(grp.d8 + "T000000"),
            cnt: "" + grp.count + " 项",
            tm: "", te: "", sm: "", mi: [], fc: c_ink
        })
        for k in grp.idxs.len() {
            let ev = list[grp.idxs[k]]
            let kd = kind_of(ev)
            let fc = c_accent
            if kd == "work" { fc = c_work }
            if kd == "holiday" { fc = c_warn }
            if kd == "allday" { fc = c_ink3 }
            out.push({
                t: "ev",
                dl: "", wd: "", cnt: "",
                tm: ev_time_start(ev),
                te: ev_time_end(ev),
                sm: ev.summary,
                mi: ev_meta_items(ev),
                fc: fc
            })
        }
    }
    return out
}


// （已删除 rows_height：那是在「容器写死像素高度」的错误路线下加的补救，
//   改用官方 `height: Fit` 后不再需要。见 makepad/splash.md:8。）


fn toggle_about() {
    about_open = !about_open
    if about_open { import_open = false }
    // ★ 2026-09-30 自检补：新建面板当时是**唯一没被别的面板关掉**的一个。
    //   「开着新建面板再点关于」→ 两个面板同时可见、高度叠加，关于面板底部的
    //   CC BY 署名与「清空事件库」按钮被推出 892px 视口（点不到）。
    //   三个面板两两互斥，缺一条就会炸，所以每条 toggle 都要写全。
    if about_open { new_open = false }
    // 关于页当模态用：月历（~405px）+ 指标（~39px）+ 节日说明行（~44px）一起让位。
    // 不让位的话关于面板会落在 y≈960 —— 892px 的窗口里 CC BY 署名和
    // 「清空事件库/收起」两个按钮全在屏幕外（实测）。
    // ★ 显隐一律走 sync_panels()：这里原来手写 2 行 set_visible，**漏了 fest_bar**
    //   （旧代码里 fest_bar 从不隐藏所以没炸，但它一直白占 44px，让关于页很挤）。
    sync_panels()
    refresh_all()
}


fn toggle_import() {
    import_open = !import_open
    if import_open { about_open = false }
    // ★ 2026-09-30 自检补：见 toggle_about 的注释 —— 新建面板此前不受 import 约束。
    //   实测「新建面板开着再点导入」两个面板叠加，确认条被压到 y≈705，
    //   再多一个面板就落到视口外了。互斥必须三个方向都写。
    if import_open { new_open = false }
    if import_open { ui.entry.set_text("") }
    // 导入面板同样当模态用：月历 + 指标 + 节日说明行让位（与 about 同一套路）。
    // ⚠️⚠️ 血泪（2026-09-30）：**节日说明行 fest_bar（44px）** 加上 metrics(39px)
    //    会把「预览 · N 个事件尚未写入 | 取消 | 写入」这条确认条挤到 y≈930 ——
    //    892px 的窗口里「写入」按钮**根本点不到**（e2e 报 `FAIL: 找不到按钮「写入」`）。
    //    这正是项目里那条铁律：面板显隐必须互斥让位，**任何「让它常驻」的改动
    //    都要跑一遍 e2e 看回归**。
    // ★ sync_panels() 现在把 fest_bar 也一起收起来（旧代码从不隐藏它，白占 44px），
    //   导入流程因此比改前更宽松：顶栏 + 工具条 + 面板 204 + 确认条 54 + 状态 52 ≈ 400px。
    sync_panels()
    refresh_all()
}

// ══════════════════════════════════════════════════════════════════
// ★★ 2026-10-01：分区导航 · 日/周/月视图 · 待办 · 心情 · 目标 · 彩蛋 · 共享范围
//
// 这一段是**纯逻辑**，控件在文件下半部分（建树区）静态声明。三条纪律照旧：
//   ① 分区 / 面板的显隐**只能**走 sync_panels()，不许各自 set_visible；
//   ② 静态 Label / ButtonFlat 的文案由 refresh_all() 推过去（建树时只求值一次）；
//   ③ 每个 ButtonFlat 必须写全 color_focus / border_color_focus / draw_text.color_focus。
//
// ⚠️ 数组里的对象**一律整体重建**再赋值（不写 `todos[i].done = …`）：
//    嵌套下标赋值在 Splash 里是否落地到原对象没有实测过，而这里的重建
//    语句直白、无歧义，数据量又只有个位数 —— 用「肯定对」的写法换掉「大概对」。
// ══════════════════════════════════════════════════════════════════

// ── 日期小工具 ────────────────────────────────────────────────────
fn pad8(y, m, d) {
    return "" + ipart(y) + pad2(ipart(m)) + pad2(d)
}


fn valid8(s) {
    if s.len() < 8 { return false }
    let a = substr(s, 0, 4).to_f64()
    let b = substr(s, 4, 6).to_f64()
    let c = substr(s, 6, 8).to_f64()
    if !(a >= 2000 && a <= 2099) { return false }
    if !(b >= 1 && b <= 12) { return false }
    if !(c >= 1 && c <= 31) { return false }
    return true
}


// ICS 里的日期串是不是一个**真实存在**的日历日期。
// ⚠️⚠️ 血泪（2026-10-01 自查发现的「静默半丢失」）：
//    导入侧此前对 DTSTART **只查「非空」**。于是
//      `DTSTART;VALUE=DATE:20260230`（2 月 30 日 —— 这天不存在）
//      `DTSTART;VALUE=DATE:20260229`（2026 是平年，没有 2 月 29 日）
//    会被当成正常事件收下：状态条报「新增 1」，事件库按 2026-02-30 分组显示，
//    而**月历格子永远不会有这一天**（格子由 cal_cells 按真实日期生成）
//    → 事件「导入成功」却从不出现在日历上，且没有任何提示。
//    用户看到的是「我明明导进去了，日历上怎么没有」，比直接报错难查得多。
//    现在在 END:VEVENT 处拦下，报出**行号 + 具体日期 + 原因**并跳过。
fn ics_date_ok(raw) {
    let d = date_of(raw)
    if d.len() < 8 { return false }
    // 8 位纯数字的粗筛：非数字 → to_f64 得 NaN → 与任何值比较为 false → 被拦下；
    // 少一位（如 "2026023x" 被前缀解析成 2026023）也会被 8 位量级拦掉。
    if !(d.to_f64() >= 20000101) { return false }
    if !(d.to_f64() <= 20991231) { return false }
    let y = ipart(substr(d, 0, 4).to_f64())
    let m = ipart(substr(d, 4, 6).to_f64())
    let dd = ipart(substr(d, 6, 8).to_f64())
    if !(m >= 1 && m <= 12) { return false }
    // ★ 这一句才是关键：按**当月实际天数**判（days_in_month 已正确处理闰年，
    //   所以 2024-02-29 通过、2026-02-29 被拒）。
    if !(dd >= 1 && dd <= days_in_month(y, m)) { return false }
    return true
}


fn today8() {
    let tp = today_parts()
    return pad8(tp.year, tp.month, tp.day)
}


fn init_focus() {
    focus_d8 = today8()
}


// 从 "YYYYMMDD" 取回 {y,m,d}；不合法就退回「今天」（正面守卫，绝不抛错）
fn focus_parts() {
    let s = focus_d8
    if valid8(s) {
        return { y: substr(s, 0, 4).to_f64(), m: substr(s, 4, 6).to_f64(),
                 d: substr(s, 6, 8).to_f64() }
    }
    let tp = today_parts()
    return { y: tp.year, m: tp.month, d: tp.day }
}


fn focus_mmdd() {
    if !valid8(focus_d8) { return "--" }
    return substr(focus_d8, 4, 6) + "-" + substr(focus_d8, 6, 8)
}


fn focus_full() {
    let p = focus_parts()
    return "" + ipart(p.m) + " 月 " + ipart(p.d) + " 日"
}


fn focus_weekday() {
    return weekday_of_dt(focus_d8 + "T000000")
}


// 日期加减天数（跨月跨年自己进位）。n 只可能是 -7..7，循环足够。
fn add_days(d8, n) {
    if !valid8(d8) { return d8 }
    let y = substr(d8, 0, 4).to_f64()
    let m = substr(d8, 4, 6).to_f64()
    let d = substr(d8, 6, 8).to_f64()
    let k = n
    while k > 0 {
        d = d + 1
        if d > days_in_month(y, m) {
            d = 1
            m = m + 1
        }
        if m > 12 {
            m = 1
            y = y + 1
        }
        k = k - 1
    }
    while k < 0 {
        d = d - 1
        if d < 1 {
            m = m - 1
            if m < 1 {
                m = 12
                y = y - 1
            }
            d = days_in_month(y, m)
        }
        k = k + 1
    }
    return pad8(y, m, d)
}


// 周几（0 = 周一）。复用已经验证过的 weekday_of_dt（蔡勒公式），
// 不再自己写一套 —— 那处曾经写错 q（把日号写死成 1），有血泪记录。
fn mon0_of(d8) {
    let nm = weekday_of_dt(d8 + "T000000")
    if nm == "周二" { return 1 }
    if nm == "周三" { return 2 }
    if nm == "周四" { return 3 }
    if nm == "周五" { return 4 }
    if nm == "周六" { return 5 }
    if nm == "周日" { return 6 }
    return 0
}


// 某天在**当前显示月份**的月历里是第几格（0..41）；不在本月返回 -1。
fn index_of_day(d8) {
    if !valid8(d8) { return -1 }
    let y = substr(d8, 0, 4).to_f64()
    let m = substr(d8, 4, 6).to_f64()
    let d = substr(d8, 6, 8).to_f64()
    if !(y == view_year()) { return -1 }
    if !(m == view_month()) { return -1 }
    let i = first_weekday_mon0(view_year(), view_month()) + ipart(d) - 1
    if i < 0 || i > 41 { return -1 }
    return i
}


// 把「关注日」挪到 d8，并把月历一起翻到那个月。
// 为什么不只改 focus_d8：用户从周视图挑了 10/03 却停在 9 月，切回月视图会一片茫然
// （高亮看不到、也没有任何提示）。month_offset 是页面上唯一的「当前月份」状态，
// 必须一起跟着走。
fn focus_goto(d8) {
    if !valid8(d8) { return }
    focus_d8 = d8
    let y = substr(d8, 0, 4).to_f64()
    let m = substr(d8, 4, 6).to_f64()
    let tp = today_parts()
    month_offset = (ipart(y) - ipart(tp.year)) * 12 + (ipart(m) - ipart(tp.month))
    sel_idx = index_of_day(d8)
}


fn focus_set(y, m, d) {
    focus_goto(pad8(y, m, d))
    sync_panels()
    refresh_all()
}


// ── 分区 / 视图切换 ──────────────────────────────────────────────
fn set_tab(i) {
    tab = i
    // ⚠️ 刻意**不**在这里关面板：面板只属于「日程」分区，切走时 sync_panels()
    //    会把它们收起来（set_visible 带 tab == 0 条件），切回来内容还在 ——
    //    用户敲了一半的标题不会因为点了一下「待办」就没了。
    sync_panels()
    refresh_all()
}


fn set_cal_view(v) {
    cal_view = v
    sync_panels()
    refresh_all()
}


// ── 事件热度（月视图格子底色 = 当天事件多寡）───────────────────────
fn heat_level(n) {
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    if n == 2 { return 2 }
    if n <= 4 { return 3 }
    return 4
}


fn heat_color(lv) {
    if lv == 1 { return c_heat1 }
    if lv == 2 { return c_heat2 }
    if lv == 3 { return c_heat3 }
    if lv == 4 { return c_heat4 }
    return c_card
}


// 某天的事件数 —— **含重复日程**（生日设了「每年」，今年这天也该算热）。
// 「按 dtstart 精确匹配」的 count_on() 做不到，所以另开一个。
// ★ 传 list 的版本：月历网格要连算 42 格。调用方取一次 display_list() 往下传，
//   避免 42 次重复取（更重要的是语义清楚：这 42 格必须看**同一份**列表）。
fn heat_count_in(d8, list) {
    if !valid8(d8) { return 0 }
    let n = count_on(d8, list)
    let y = substr(d8, 0, 4).to_f64()
    let m = substr(d8, 4, 6).to_f64()
    let d = substr(d8, 6, 8).to_f64()
    for i in list.len() {
        if list[i].rrule == "" { continue }
        if date_of(list[i].dtstart) == d8 { continue }
        if repeat_hits(list[i], y, m, d) { n = n + 1 }
    }
    return n
}


fn heat_count(d8) {
    return heat_count_in(d8, display_list())
}


fn heat_note() {
    return "格子底色越深，这天日程越多"
}


// ── 周视图（focus 所在的那一周）──────────────────────────────────
fn week_day_d8(k) {
    return add_days(focus_d8, k - mon0_of(focus_d8))
}


fn week_mmdd(k) {
    let d8 = week_day_d8(k)
    if !valid8(d8) { return "--" }
    return substr(d8, 4, 6) + "-" + substr(d8, 6, 8)
}


fn week_weekday(k) {
    return weekday_name(k)
}


fn week_sum(k) {
    let d8 = week_day_d8(k)
    let n = heat_count(d8)
    let t = todo_count(d8)
    let s = ""
    if n > 0 { s = "" + n + " 个日程" }
    if t > 0 {
        if s != "" { s = s + " · " }
        s = s + "待办 " + ("" + t)
    }
    if s == "" { s = "—" }
    return s
}


fn week_is_today(k) {
    if week_day_d8(k) == today8() { return true }
    return false
}


fn week_today_label(k) {
    if week_is_today(k) { return "今天" }
    return ""
}


fn week_pick(k) {
    let d8 = week_day_d8(k)
    focus_goto(d8)
    cal_view = 2
    sync_panels()
    refresh_all()
    set_status("已选 " + focus_mmdd() + " " + focus_weekday() + "，下面就是这一天的详情")
    refresh_all()
}


// ── 待办清单 ────────────────────────────────────────────────────
fn save_todos() {
    fs.write(TODOS_FILE, todos.to_json())
}


fn todo_open_count(d8) {
    let n = 0
    for i in todos.len() {
        if todos[i].d8 == d8 {
            if !todos[i].done { n = n + 1 }
        }
    }
    return n
}


fn todo_done_count(d8) {
    let n = 0
    for i in todos.len() {
        if todos[i].d8 == d8 {
            if todos[i].done { n = n + 1 }
        }
    }
    return n
}


// 当天待办**总数**（完成 + 未完成）。周视图摘要用 —— 那里只想知道「这天有没有事」，
// 分成两类反而要多占字符。别把它和 todo_open_count 混了。
fn todo_count(d8) {
    return todo_open_count(d8) + todo_done_count(d8)
}


// 界面上 6 个槽位当前装的是哪几条（存**原始下标**）
fn todo_view() {
    let out = []
    for i in todos.len() {
        if todos[i].d8 != focus_d8 { continue }
        if only_open && todos[i].done { continue }
        out.push(i)
    }
    return out
}


fn todo_status() {
    let a = todo_done_count(focus_d8)
    let b = a + todo_open_count(focus_d8)
    if b == 0 { return "这一天还没有待办" }
    return "已完成 " + ("" + a) + " / " + ("" + b)
}


fn todo_filter_label() {
    if only_open { return "只看未完成" }
    return "全部"
}


fn toggle_only_open() {
    only_open = !only_open
    refresh_all()
}


fn todo_add() {
    let t = ui.todo_in.text().trim()
    if t == "" {
        set_status_warn("先写点什么再添加")
        refresh_all()
        return
    }
    if !valid8(focus_d8) { init_focus() }
    todo_seq = todo_seq + 1
    todos.push({ uid: "t" + ("" + todo_seq), text: t, d8: focus_d8, done: false })
    save_todos()
    ui.todo_in.set_text("")
    set_status_ok("已加到 " + focus_mmdd() + "：" + t)
    refresh_all()
}


fn todo_toggle(k) {
    let v = todo_view()
    if k < 0 || k >= v.len() { return }
    let i = v[k]
    let out = []
    for j in todos.len() {
        let t = todos[j]
        if j == i {
            out.push({ uid: t.uid, text: t.text, d8: t.d8, done: !t.done })
        } else {
            out.push({ uid: t.uid, text: t.text, d8: t.d8, done: t.done })
        }
    }
    todos = out
    save_todos()
    refresh_all()
}


fn todo_del(k) {
    let v = todo_view()
    if k < 0 || k >= v.len() { return }
    let i = v[k]
    let out = []
    for j in todos.len() {
        if j == i { continue }
        out.push(todos[j])
    }
    todos = out
    save_todos()
    set_status("已删掉一条待办")
    refresh_all()
}


// ── 心情日记 ────────────────────────────────────────────────────
fn save_moods() {
    fs.write(MOODS_FILE, moods.to_json())
}


fn mood_name(i) {
    if i == 0 { return "开心" }
    if i == 1 { return "平静" }
    if i == 2 { return "一般" }
    if i == 3 { return "疲惫" }
    return "低落"
}


fn mood_color(i) {
    if i == 0 { return c_mood1 }
    if i == 1 { return c_mood2 }
    if i == 2 { return c_mood3 }
    if i == 3 { return c_mood4 }
    return c_mood5
}


fn mood_at(d8) {
    for i in moods.len() {
        if moods[i].d8 == d8 { return i }
    }
    return -1
}


// 当前选中档位；没记过返回 -1
fn mood_now() {
    let m = mood_at(focus_d8)
    if m < 0 { return -1 }
    return moods[m].mood
}


fn mood_pick(i) {
    if !valid8(focus_d8) { init_focus() }
    let m = mood_at(focus_d8)
    let out = []
    if m < 0 {
        for j in 0..moods.len() { out.push(moods[j]) }
        out.push({ d8: focus_d8, mood: i, note: "" })
    } else {
        for j in 0..moods.len() {
            let r = moods[j]
            if j == m {
                out.push({ d8: r.d8, mood: i, note: r.note })
            } else {
                out.push({ d8: r.d8, mood: r.mood, note: r.note })
            }
        }
    }
    moods = out
    save_moods()
    set_status_ok("记下了 " + focus_mmdd() + " 的心情：" + mood_name(i))
    refresh_all()
}


fn mood_note_save() {
    let t = ui.mood_in.text().trim()
    if !valid8(focus_d8) { init_focus() }
    let m = mood_at(focus_d8)
    let out = []
    if m < 0 {
        // 只写备注、还没点心情 → 落成「一般」，不让备注丢
        for j in 0..moods.len() { out.push(moods[j]) }
        out.push({ d8: focus_d8, mood: 2, note: t })
    } else {
        for j in 0..moods.len() {
            let r = moods[j]
            if j == m {
                out.push({ d8: r.d8, mood: r.mood, note: t })
            } else {
                out.push({ d8: r.d8, mood: r.mood, note: r.note })
            }
        }
    }
    moods = out
    save_moods()
    set_status_ok("备注已存到 " + focus_mmdd())
    refresh_all()
}


fn mood_summary() {
    let m = mood_at(focus_d8)
    if m < 0 { return "还没记 —— 点一个心情" }
    let note = moods[m].note
    if note == "" { return "心情：" + mood_name(moods[m].mood) }
    return "心情：" + mood_name(moods[m].mood) + " · " + note
}


// 本月记了几天（心情分区的一句小结）
fn mood_days_in_month() {
    let y = view_year()
    let m = view_month()
    let n = 0
    for i in moods.len() {
        let d8 = moods[i].d8
        if !valid8(d8) { continue }
        let yy = substr(d8, 0, 4).to_f64()
        let mm = substr(d8, 4, 6).to_f64()
        if yy == y && mm == m { n = n + 1 }
    }
    return n
}


fn mood_month_note() {
    return "本月已记 " + ("" + mood_days_in_month()) + " 天"
}


// ── 目标 / 子任务 ───────────────────────────────────────────────
fn save_goals() {
    fs.write(GOALS_FILE, goals.to_json())
}


// 3 张目标卡、每张 3 个子任务槽位。槽位固定是因为**按钮必须静态声明**
// （on_render 里建出来的按钮点击不重绑，这条在本项目踩过两次）。
fn goal_title(k) {
    if k < 0 || k >= goals.len() { return "" }
    return goals[k].title
}


fn goal_due(k) {
    if k < 0 || k >= goals.len() { return "" }
    let d = goals[k].due
    if d == "" { return "未设期限" }
    return "到 " + d
}


fn goal_progress(k) {
    if k < 0 || k >= goals.len() { return "0/0" }
    let subs = goals[k].subs
    let n = subs.len()
    if n == 0 { return "0 步" }
    let d = 0
    for i in 0..n {
        if subs[i].done { d = d + 1 }
    }
    return "" + d + "/" + ("" + n) + " 步"
}


// 目标卡上的进度条：10 格，已完成比例填色。
// ⚠️ 只用 ASCII 的 `#` / `-`：`█`/`░`/`●`/`○`/`✓` 在宿主字体（IBMPlexSans、
//    LiberationMono）里**没有字形**，会渲染成豆腐块或直接空白 —— 这条在本项目
//    已经踩过（✓ ✕ ◌ 三个字符全废），所以进度类表达一律退回 ASCII。
fn goal_bar(k) {
    if k < 0 || k >= goals.len() { return "" }
    let subs = goals[k].subs
    let n = subs.len()
    if n == 0 { return "" }
    let d = 0
    for i in 0..n {
        if subs[i].done { d = d + 1 }
    }
    let full = ipart(10 * d / n)
    let s = ""
    for i in 0..10 {
        if i < full {
            s = s + "#"
        } else {
            s = s + "-"
        }
    }
    return s
}


fn goal_sub_text(gi, si) {
    if gi < 0 || gi >= goals.len() { return "" }
    let subs = goals[gi].subs
    if si < 0 || si >= subs.len() { return "" }
    let s = subs[si]
    if s.done { return "[x] " + s.text }
    return "[ ] " + s.text
}


fn goal_add() {
    let t = ui.goal_in.text().trim()
    if t == "" {
        set_status_warn("先写目标，比如「AP 考试」")
        refresh_all()
        return
    }
    goal_seq = goal_seq + 1
    let out = []
    for j in goals.len() { out.push(goals[j]) }
    out.push({ uid: "g" + ("" + goal_seq), title: t, due: "", subs: [] })
    goals = out
    save_goals()
    ui.goal_in.set_text("")
    set_status_ok("已新建目标：" + t)
    refresh_all()
}


fn goal_del(k) {
    if k < 0 || k >= goals.len() { return }
    let out = []
    for j in goals.len() {
        if j == k { continue }
        out.push(goals[j])
    }
    goals = out
    save_goals()
    set_status("已删掉一个目标")
    refresh_all()
}


// 给第 k 个目标加一步（用同一行输入框，加完清空）
fn goal_step_add(k) {
    if k < 0 || k >= goals.len() { return }
    let t = ui.goal_in.text().trim()
    if t == "" {
        set_status_warn("先在上面的输入框写这一步要做什么")
        refresh_all()
        return
    }
    let g = goals[k]
    let ns = []
    for j in g.subs.len() { ns.push(g.subs[j]) }
    ns.push({ text: t, done: false })
    let ng = { uid: g.uid, title: g.title, due: g.due, subs: ns }
    let out = []
    for j in goals.len() {
        if j == k {
            out.push(ng)
        } else {
            out.push(goals[j])
        }
    }
    goals = out
    save_goals()
    ui.goal_in.set_text("")
    set_status_ok("已加一步：" + t)
    refresh_all()
}


fn goal_step_toggle(gi, si) {
    if gi < 0 || gi >= goals.len() { return }
    let g = goals[gi]
    if si < 0 || si >= g.subs.len() { return }
    let ns = []
    for j in g.subs.len() {
        let s = g.subs[j]
        if j == si {
            ns.push({ text: s.text, done: !s.done })
        } else {
            ns.push({ text: s.text, done: s.done })
        }
    }
    let ng = { uid: g.uid, title: g.title, due: g.due, subs: ns }
    let out = []
    for j in goals.len() {
        if j == gi {
            out.push(ng)
        } else {
            out.push(goals[j])
        }
    }
    goals = out
    save_goals()
    refresh_all()
}


// ── 彩蛋：节气 / 历史上的今天 / 时间胶囊 ──────────────────────────
// 从 s 的 from 处取到下一个 "|" 之前的内容（同时给出下一段的起点）
// ── 在「|」分隔的扁平表里查一个键，返回它后面第 k 个字段 ─────────────
// ⚠️⚠️ 血泪（2026-10-01）：**不要用 `search` + `substr` 做这件事**。
//     `str.search(pat)` 返回的是**字节**下标（platform/script/src/string.rs:264
//       "str.search(pat) -> number (byte index of first match, or -1)"），
//     而本文件的 `substr()` 是按**字符**切的（它走 to_chars / retain）。
//     表里只要有中文（SOLAR_TERMS 的节气名、HISTORY 的事件名），两者就对不上：
//       · 拿字节下标当字符下标去 substr → 切在完全无关的位置
//         （实测：2026-10-08 的寒露被读成 "立夏|202"）；
//       · 键本身在中文之后 → 下标越界 → 读成空串
//         （实测：「历史上的今天」对**任何一天**都显示「暂时没有收录」，
//           而 9/30 明明有 `|0930|1935|胡佛水坝竣工`）。
//     两个 bug 都不报错、不崩溃，只表现为「这个功能好像没数据」—— 最贵的一类。
//     改用 split("|") 后是纯数组下标，与编码无关，天然正确。
//     ✅ `search` 的**布尔用法**（`!= -1` / `< 0` / `>= 0`）是安全的，全文其余
//       20 处都是那种，不必改。
fn table_field(tbl, key, k) {
    let parts = tbl.split("|")
    for i in 0..parts.len() {
        if parts[i] != key { continue }
        let j = i + k
        if j >= 0 && j < parts.len() { return parts[j] }
        return ""
    }
    return ""
}


fn term_c_at(idx) {
    let parts = TERM_C.split("|")
    if idx < 0 || idx >= parts.len() { return 0.0 }
    return parts[idx].to_f64()
}


fn term_n_at(idx) {
    let parts = TERM_N.split("|")
    if idx < 0 || idx >= parts.len() { return "" }
    return parts[idx]
}


// 节气名。表内（2025–2030）是解算出来的精确值；表外退回公式推算，
// 前缀「≈」明确标出「这是估算」—— 宁可在界面上显得啰嗦，也不让人拿它当权威。
fn solar_term(y, m, d) {
    // ★ 查表走 table_field（split 下标），**不是** search+substr —— 见 table_field 的血泪。
    let nm = table_field(SOLAR_TERMS, pad8(y, m, d), 1)
    if nm != "" { return nm }
    let est = solar_term_est(y, m, d)
    if est == "" { return "" }
    return "≈" + est
}


fn solar_term_est(y, m, d) {
    let yy = ipart(y)
    let mm = ipart(m)
    if yy < 2000 || yy > 2099 { return "" }
    if mm < 1 || mm > 12 { return "" }
    let y2 = yy - 2000
    // L = floor((yy - 2001) / 4)。写成正数除法再减 1000，避免负数取整方向出错
    // （脚本里 ipart 是截断，不是 floor；yy = 2000 时真值是 -1，截断会给 0）。
    let L = ipart((yy + 1999) / 4.0) - 1000
    for k in 0..2 {
        let idx = (mm - 1) * 2 + k
        let day = ipart(y2 * 0.2422 + term_c_at(idx)) - L
        if day == ipart(d) { return term_n_at(idx) }
    }
    return ""
}


fn history_on(mmdd) {
    // ★ 同 solar_term：必须 split 查表。这里一次 split 取「年份 + 事件」两个字段
    //   （两次 table_field 会把 HISTORY 白拆两遍）。
    let parts = HISTORY.split("|")
    for i in 0..parts.len() {
        if parts[i] != mmdd { continue }
        if i + 2 >= parts.len() { return "" }
        return parts[i + 1] + " · " + parts[i + 2]
    }
    return ""
}


// 彩蛋分区可以前后翻日（默认停在「关注日」）
fn egg_date() {
    return add_days(focus_d8, egg_roll)
}


// "YYYYMMDD" → "MMDD"（**紧凑四位、不带连字符**，用于查 SOLAR_TERMS / HISTORY 的键）。
// ⚠️⚠️ 血泪（2026-10-01）：这里原来写成 `substr(4,6) + "-" + substr(6,8)` → "09-30"，
//    而 HISTORY 的键是 `|0930|`。于是 `HISTORY.search("|09-30|")` **永远查不到**，
//    彩蛋分区的「历史上的今天」对**任何一天**都显示「暂时没有收录」。
//    这个 bug 极其安静：没有报错、没有空指针，只是「功能好像没数据」——
//    是冒烟测试把界面走了一遍、人眼看出 9/30 明明有 `|0930|1935|胡佛水坝竣工`
//    却写着「暂时没有收录」，才被抓出来。
//    教训：**两个函数各自约定一种日期串格式时，必须把格式写进函数名或注释**，
//    不然拼接点在调用处「看起来很对」。
fn egg_mmdd() {
    let d8 = egg_date()
    if !valid8(d8) { return "0101" }
    return substr(d8, 4, 6) + substr(d8, 6, 8)
}


fn egg_title() {
    let d8 = egg_date()
    if !valid8(d8) { return "—" }
    return "" + ipart(substr(d8, 4, 6).to_f64()) + " 月 "
        + ipart(substr(d8, 6, 8).to_f64()) + " 日"
}


fn egg_term_line() {
    let d8 = egg_date()
    if !valid8(d8) { return "—" }
    let t = solar_term(substr(d8, 0, 4).to_f64(), substr(d8, 4, 6).to_f64(),
                       substr(d8, 6, 8).to_f64())
    if t == "" { return "这一天不是节气" }
    return t
}


fn egg_history_line() {
    let h = history_on(egg_mmdd())
    if h == "" { return "这一天暂时没有收录（选编条目有限，不是全集）" }
    return h
}


// 挑今天应该显示的「唯一一条」小知识。优先级：
//   中国特别日 > 国际节日 > 节气 > 历史上的今天
// 没挑到就返回 ""，**界面不渲染占位**（用户原话：「没有就不要改」）。
// ★ 设计取舍：原本 3 张卡同时显示（节气 + 历史上的今天 + 时间胶囊），
//   现在合并为 1 张「今日」卡 —— 信息密度低、视觉干净，
//   时间胶囊保留为另一张（它是写操作功能，不是展示）。
// ⚠️ 用 splat `{tag, title, hint}` 形似对象但**本语言不支持** —— 拆成 3 个返回值。
fn egg_today_pick(d8) {
    if !valid8(d8) { return ["", "", ""] }
    let mm = substr(d8, 4, 6) + substr(d8, 6, 8)
    // 1) 中国特别日
    let cn_nm = table_field(CHINA_FIXED, mm, 1)
    if cn_nm != "" {
        return ["今日 · 中国", cn_nm, table_field(CHINA_FIXED, mm, 2)]
    }
    // 2) 国际节日
    let intl_nm = table_field(INTL_FIXED, mm, 1)
    if intl_nm != "" {
        return ["今日 · 国际", intl_nm, ""]
    }
    // 3) 节气（注意 solar_term 表是按 YYYYMMDD 查，不是 MMDD —— 见函数注释）
    let y = substr(d8, 0, 4).to_f64()
    let mo = substr(d8, 4, 6).to_f64()
    let dd = substr(d8, 6, 8).to_f64()
    let term = solar_term(y, mo, dd)
    if term != "" {
        return ["今日 · 节气", term, ""]
    }
    // 4) 历史上的今天（HISTORY 一次 split 共用，避免拆两遍）
    let parts = HISTORY.split("|")
    for i in 0..parts.len() {
        if parts[i] != mm { continue }
        if i + 2 >= parts.len() { break }
        return ["今日 · 历史", parts[i + 1] + " · " + parts[i + 2], ""]
    }
    return ["", "", ""]
}


fn egg_roll_by(n) {
    egg_roll = egg_roll + n
    refresh_all()
}


fn egg_reset() {
    egg_roll = 0
    refresh_all()
}


fn save_caps() {
    fs.write(CAPS_FILE, caps.to_json())
}


fn cap_open_now(c) {
    if c.unlock <= today8() { return true }
    return false
}


fn cap_add() {
    let t = ui.cap_in.text().trim()
    if t == "" {
        set_status_warn("先写一句要封存的话")
        refresh_all()
        return
    }
    if !valid8(focus_d8) { init_focus() }
    cap_seq = cap_seq + 1
    let out = []
    for j in caps.len() { out.push(caps[j]) }
    out.push({ uid: "c" + ("" + cap_seq), text: t, unlock: focus_d8, opened: false })
    caps = out
    save_caps()
    ui.cap_in.set_text("")
    set_status_ok("已封存 · " + focus_mmdd() + " 那天才能打开")
    refresh_all()
}


fn cap_del(k) {
    if k < 0 || k >= caps.len() { return }
    let out = []
    for j in caps.len() {
        if j == k { continue }
        out.push(caps[j])
    }
    caps = out
    save_caps()
    set_status("已删掉一个时间胶囊")
    refresh_all()
}


fn cap_open_it(k) {
    if k < 0 || k >= caps.len() { return }
    let c = caps[k]
    if !cap_open_now(c) {
        set_status_warn("还没到解封日 —— 这天之前不打开")
        refresh_all()
        return
    }
    let out = []
    for j in caps.len() {
        let r = caps[j]
        if j == k {
            out.push({ uid: r.uid, text: r.text, unlock: r.unlock, opened: true })
        } else {
            out.push({ uid: r.uid, text: r.text, unlock: r.unlock, opened: r.opened })
        }
    }
    caps = out
    save_caps()
    refresh_all()
}


fn cap_slot_line(k) {
    if k < 0 || k >= caps.len() { return "" }
    let c = caps[k]
    if cap_open_now(c) {
        if c.opened { return c.text }
        return "到期了 —— 点「开启」看看当时写了什么"
    }
    return "封存中 · " + substr(c.unlock, 4, 6) + "-" + substr(c.unlock, 6, 8) + " 解封"
}


fn cap_slot_btn(k) {
    if k < 0 || k >= caps.len() { return "空" }
    let c = caps[k]
    if cap_open_now(c) {
        if c.opened { return "已读" }
        return "开启"
    }
    return "未到期"
}


fn cap_slot_del_label(k) {
    if k < 0 || k >= caps.len() { return "—" }
    return "删除"
}


// ── 共享范围（离线版）────────────────────────────────────────────
// ⚠️ 说清楚边界：真正的**实时共享**需要一个后端（本应用只申请 storage、
//    没有任何网络出口），所以这里做的是「共享范围控制」——
//    把哪些事件标为愿意对外分享，导出时只导出这些（隐私留在本机）。
//    这是离线能做到的最大诚实版本；实时互通列入后续计划。
fn is_shared(uid) {
    if uid == "" { return false }
    if shared.search("|" + uid + "|") >= 0 { return true }
    return false
}


fn share_count() {
    let n = 0
    for i in events.len() {
        if is_shared(events[i].uid) { n = n + 1 }
    }
    return n
}


fn share_label() {
    return "共享范围 " + ("" + share_count()) + " / " + ("" + events.len()) + " 个事件"
}


fn share_all() {
    let s = ""
    for i in events.len() {
        s = s + "|" + events[i].uid
    }
    if s != "" { s = s + "|" }
    shared = s
    fs.write(SHARE_FILE, shared)
    set_status_ok("已把 " + ("" + events.len()) + " 个事件标为可共享")
    refresh_all()
}


fn share_none() {
    shared = ""
    fs.write(SHARE_FILE, shared)
    set_status_ok("已清空共享标记 —— 导出时不会带任何事件")
    refresh_all()
}


fn export_shared() {
    let out = []
    for i in events.len() {
        if is_shared(events[i].uid) { out.push(events[i]) }
    }
    if out.len() == 0 {
        set_status_warn("还没有标记共享事件 —— 先点「全部共享」")
        refresh_all()
        return
    }
    // 借导入面板的输入框当输出框：它就在页面中段，用户能立刻看到并复制。
    // ⚠️ 顺序必须是这样：先把面板状态改好、刷完，**最后**再灌文本 ——
    //    toggle_import() 会 `ui.entry.set_text("")`，早灌就白灌了。
    import_open = true
    about_open = false
    new_open = false
    sync_panels()
    refresh_all()
    ui.entry.set_text(export_ics(out))
    set_status_ok("已生成共享包（" + ("" + out.len()) + " 个事件）· 私密事件不在其中")
    refresh_all()
}


// ── 吉祥物：点一下换一句（首页可见，不再藏在关于页里）──────────────
fn mascot_line() {
    let tp = today_parts()
    let t8 = today8()
    let n = heat_count(t8)
    let td = todo_open_count(t8)
    // ⚠️ 文案长度有上限（≈20 个汉字）：mascot_say 是单行 Label，超了会折行，
    //    而折行会把吉祥物条撑高、把下面的月历整体推下去 —— 竖向预算本来就紧。
    //    每句都按「一行放得下」写。
    let k = mascot_tip % 9
    if k == 0 {
        return "今天 " + ("" + ipart(tp.month)) + " 月 " + ("" + ipart(tp.day))
            + " 日 · " + ("" + n) + " 个日程 · 待办剩 " + ("" + td) + " 项"
    }
    if k == 1 { return "点月历上任意一格，就能在那天写日程" }
    if k == 2 { return "生日这种，把「重复」设成「每年」" }
    if k == 3 { return "「待办」分区里，勾掉一件算一件" }
    if k == 4 { return "「心情」分区，记一句这天怎么样" }
    if k == 5 { return "数据全在本机 —— 不联网、不上传" }
    // ★ 第 7 句：原先是独立的图例行（view_bar 里的 vnow，整整占掉 30px 一行）。
    //   竖向预算不够，那一行被并掉了 —— 图例改由吉祥物顺带讲。这正是吉祥物
    //   存在的意义：把旁边那些「说明行」省下来。
    if k == 6 { return "月视图：" + heat_note() }
    // 第 8 句：原先是页头下面那行常驻副标题，同样为了 35px 让位搬到这儿。
    if k == 7 { return "重复导入不会重复添加，能认出来" }
    if k == 8 { return "点我，我还能再说一句" }
    return "点我，我还能再说一句"
}


fn mascot_next() {
    mascot_tip = mascot_tip + 1
    refresh_all()
}


// ── 视图按钮 / 状态文案（静态控件的文案一律在 refresh_all 里推）────
fn view_btn_label(v) {
    if cal_view == v {
        if v == 0 { return "[月]" }
        if v == 1 { return "[周]" }
        return "[日]"
    }
    if v == 0 { return "月" }
    if v == 1 { return "周" }
    return "日"
}


// 日视图：走「新建面板」，与点格子是同一条路径（sel_idx 也要跟着对）
fn new_here() {
    if !valid8(focus_d8) { init_focus() }
    let p = focus_parts()
    sel_idx = index_of_day(focus_d8)
    open_new_on(p.y, p.m, p.d)
}


// ── 待办槽位取值 ────────────────────────────────────────────────
fn todo_slot_mark(k) {
    let v = todo_view()
    if k < 0 || k >= v.len() { return "[ ]" }
    if todos[v[k]].done { return "[x]" }
    return "[ ]"
}


fn todo_slot_text(k) {
    let v = todo_view()
    if k < 0 || k >= v.len() { return "" }
    return todos[v[k]].text
}


fn todo_slot_visible(k) {
    return k < todo_view().len()
}


fn todo_more_text() {
    let v = todo_view()
    if v.len() <= 6 { return "" }
    return "还有 " + ("" + (v.len() - 6)) + " 条没显示（这里只有 6 个位置）"
}


// ── 日视图取值 ─────────────────────────────────────────────────
fn day_events() {
    let list = display_list()
    let out = []
    for i in list.len() {
        if date_of(list[i].dtstart) == focus_d8 { out.push(list[i]) }
    }
    return out
}


fn day_ev_text(k) {
    let e = day_events()
    if k < 0 || k >= e.len() { return "" }
    let t = ev_time_start(e[k])
    if t == "" { return e[k].summary }
    return t + " " + e[k].summary
}


fn day_ev_more_text() {
    let n = day_events().len()
    if n <= 4 { return "" }
    return "还有 " + ("" + (n - 4)) + " 个 —— 下面列表里有这一天的完整分组"
}


fn day_sub_text() {
    let s = focus_weekday()
    let t = egg_term_for(focus_d8)
    if t != "" { s = s + " · " + t }
    return s
}


fn egg_term_for(d8) {
    if !valid8(d8) { return "" }
    return solar_term(substr(d8, 0, 4).to_f64(), substr(d8, 4, 6).to_f64(),
                      substr(d8, 6, 8).to_f64())
}


fn day_stat_text() {
    let n = day_events().len()
    let a = todo_done_count(focus_d8)
    let b = a + todo_open_count(focus_d8)
    let m = mood_now()
    let s = "日程 " + ("" + n)
    if b > 0 { s = s + " · 待办 " + ("" + a) + "/" + ("" + b) }
    if m >= 0 { s = s + " · 心情 " + mood_name(m) }
    return s
}


fn day_empty_hint() {
    if day_events().len() > 0 { return "" }
    return "这一天还没有日程 —— 点下面的「写日程」"
}


// ── 目标卡取值 ─────────────────────────────────────────────────
fn goal_card_visible(k) {
    return k < goals.len()
}


fn goal_sub_visible(gi, si) {
    if gi < 0 || gi >= goals.len() { return false }
    return si < goals[gi].subs.len()
}


fn goal_sub_mark(gi, si) {
    if gi < 0 || gi >= goals.len() { return "[ ]" }
    let subs = goals[gi].subs
    if si < 0 || si >= subs.len() { return "[ ]" }
    if subs[si].done { return "[x]" }
    return "[ ]"
}


fn goal_sub_label(gi, si) {
    if gi < 0 || gi >= goals.len() { return "" }
    let subs = goals[gi].subs
    if si < 0 || si >= subs.len() { return "" }
    return subs[si].text
}


fn goal_count_text() {
    if goals.len() == 0 { return "还没有目标" }
    return "已建 " + ("" + goals.len()) + " 个"
}


// ── 胶囊槽位取值 ────────────────────────────────────────────────
fn cap_slot_visible(k) {
    return k < caps.len()
}


// ── 载入旁路存储 ────────────────────────────────────────────────
// ⚠️ 全部做存在性 + nil 检查：文件可能不存在（首次运行）或被外部改坏。
//    一个 parse_json 失败就把整个 load() 掀掉，用户看到的是「应用起不来」。
fn load_aux() {
    if fs.exists(TODOS_FILE) {
        let v = fs.read(TODOS_FILE).parse_json()
        if v != nil { todos = v }
    }
    if fs.exists(MOODS_FILE) {
        let v = fs.read(MOODS_FILE).parse_json()
        if v != nil { moods = v }
    }
    if fs.exists(GOALS_FILE) {
        let v = fs.read(GOALS_FILE).parse_json()
        if v != nil { goals = v }
    }
    if fs.exists(CAPS_FILE) {
        let v = fs.read(CAPS_FILE).parse_json()
        if v != nil { caps = v }
    }
    if fs.exists(SHARE_FILE) {
        let v = fs.read(SHARE_FILE)
        if v != nil { shared = v }
    }
    // 序号从已有条数起步 —— 只增不减，够用（uid 只用来做键，不参与展示）
    todo_seq = todos.len() + 100
    goal_seq = goals.len() + 100
    cap_seq = caps.len() + 100
}


start_timeout(0.05, || load())

// 根：整页纸底
// ⚠️ 布局三层（全部来自实测）：
//   1. Splash 会把整个脚本包进 `View{height: Fit, ...}`（splash.rs:155 SPLASH_PREFIX），
//      所以脚本根必须先用官方 `Filler`（= View{width: Fill height: Fill}）撑满整屏。
//   2. 内层用 **ScrollYView{height: Fill}** 让整页滚动 —— 内容自然流式排列，
//      避免「固定高度 + 多个 Fill/Fit 兄弟」时 makepad 的 Fill 分配算错、
//      导致后面的面板整个从布局树消失（实测 5 个面板全丢）。
//   3. 页面内所有动态容器（on_render）一律给**显式高度**或保证产出内容，
//      因为 `height: Fit` + on_render 零产出会让节点消失并扰乱兄弟布局。
Filler{
    draw_bg +: {color: c_paper}
    flow: Down
ScrollYView{width: Fill height: Fill flow: Down draw_bg +: {color: c_paper}

    // ══ 头部 .head{padding:26px 20px 18px} ══════════════════
    // ★ 2026-10-01：padding 26/18 → 16/10，并**删掉原来那一行副标题**
    //   （「导入的日程按天归位，重复导入不会重复添加」）。
    //   原因同样是竖向预算：新增分区导航 + 吉祥物条后，页面底部必须同时容纳
    //   `tools`(48) 与 `status_panel`(52)，实测差的正好是这 ~35px。
    //   副标题那句话没丢 —— 它变成了吉祥物的第 8 句轮换文案（见 mascot_line），
    //   而且顺带解决了「同一句话永远钉在标题下面」的呆板感。
    RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 16 bottom: 10}
        draw_bg +: {color: c_card}

        // 顶行：左 .kicker，右「关于」文字钮（设计稿语言：无底色、小字 ink3）
        RoundedView{width: Fill height: Fit flow: Right spacing: 8 draw_bg +: {color: c_card}
            // .kicker{10px letter-spacing:.16em uppercase accent margin-bottom:7px}
            Label{width: Fill text: "OCTOSENSE CALENDAR" draw_text.color: c_accent
                draw_text.text_style: theme.font_code{font_size: 10}}
            ButtonFlat{text: "关于" height: 20.0 padding: Inset{left: 0 right: 0} on_click: || toggle_about()
                draw_bg +: {border_radius: 0.0 color: c_card color_hover: c_card color_down: c_card color_focus: c_card border_size: 0.0}
                draw_text +: {color: c_ink3 color_hover: c_ink2 color_down: c_ink2 color_focus: c_ink3}}
        }
        // .head h1{27px/600 letter-spacing:-.015em}
        // ⚠️⚠️ 血泪（2026-09-30）：`text:` 里的表达式是**建树时求值一次**，
        //    静态 Label 之后再也不会更新 —— 翻月时网格、说明行都跟着走，
        //    唯独这个大标题一直钉在启动时的月份上（实测：翻到 2025-10，
        //    标题还写着「2026 年 9 月」）。凡是内容随状态变的 Label，
        //    一律 `:=` 立 id + 在 refresh_all 里 set_text。
        month_title := Label{text: "" + view_year() + " 年 " + ("" + view_month()) + " 月" draw_text.color: c_ink
            draw_text.text_style: theme.font_bold{font_size: 27}}

        // .headmeta{margin-top:14px padding-top:12px border-top:1px line}
        Hr{draw_bg +: {color: c_line border_size: 0.0 height: 1.0}}
        // ★★ 2026-09-30 第二次修（用户：「这 4 3 10-04 是什么东西？我没看明白」）：
        //   这一行原来写死 `height: 46.0`。三个指标块是「19px 大数字 + 10px 小标签」
        //   竖排，两个 Label 的自然行盒加起来 ≈ 47px；扣掉 padding-top 12，
        //   可用高度只剩 34px → **第二行标签被整行裁掉**。
        //   于是页面上只剩三个裸数字「4  3  10-04」，没有任何说明。
        //   这是本文件第 0 条铁律的又一次实例：**容器必须 height: Fit**
        //   （写死像素高度会压扁/裁掉内部 Label，把数字改大也没用，裁切位置不动）。
        //
        //   ⚠️⚠️ 但**修法不能只是改成 Fit** —— 竖排恢复后这行会从 46 变成 65，
        //   而第 2042 行的血泪注释写得明明白白：metrics 只多占 42px 就会把
        //   「预览 · N 个事件尚未写入 | 取消 | 写入」这条**确认条挤出视口**，
        //   「写入」按钮点不到（e2e 报 `FAIL: 找不到按钮「写入」`）。我第一版
        //   就是只改了 Fit，当场把这个坑重新踩了出来（实测确认）。
        //   → 所以这里**同时改版式**：数字与小标签**同行**排列（不再竖排），
        //     行高 = max(17px 数字行盒, 10px 标签行盒) ≈ 31，加 padding 8 = 39，
        //     **比原来的 46 还矮 7px** —— 确认条的处境反而比修改前更宽松。
        //   同时把 on_render 换掉：on_render 建的子节点**首帧布局时还不存在**，
        //   那一刻 `height: Fit` 会算出 0，反过来扰乱兄弟布局（见第 2063 行附近），
        //   所以「Fit + on_render」不能凑一起用 —— 两者正是当初写死 46 的原因。
        //   改成**静态 Label + id**：子节点一开始就在树里，值在 refresh_all 里 set_text。
        //   标签也顺手写清楚：「最近」→「最近日程」。
        metrics := RoundedView{width: Fill height: Fit flow: Right spacing: 20 padding: Inset{top: 2}
            draw_bg +: {color: c_card}
            // .metric .v{17px mono}  .k{10px ink3} —— 同行排列，标签贴底
            RoundedView{width: Fit height: Fit flow: Right spacing: 5
                align: Align{x: 0.5 y: 0.5} draw_bg +: {color: c_card}
                metric_events := Label{text: "0" draw_text.color: c_ink draw_text.text_style: theme.font_code{font_size: 17}}
                Label{text: "事件" draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            RoundedView{width: Fit height: Fit flow: Right spacing: 5
                align: Align{x: 0.5 y: 0.5} draw_bg +: {color: c_card}
                metric_sources := Label{text: "0" draw_text.color: c_ink draw_text.text_style: theme.font_code{font_size: 17}}
                Label{text: "来源" draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            RoundedView{width: Fit height: Fit flow: Right spacing: 5
                align: Align{x: 0.5 y: 0.5} draw_bg +: {color: c_card}
                metric_latest := Label{text: "-" draw_text.color: c_ink draw_text.text_style: theme.font_code{font_size: 17}}
                Label{text: "最近日程" draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            }
        }
    }

    // ══ 状态条 .status{margin:12px 20px;padding:9px 12px;font:12px} ══════
    //   默认 accent-soft/#8a3f16；.ok → ok-soft/#14532d；.warn → warn-soft/#7c3a06
    //   .si{mono 11px} 图标 ✓ / ✕ / !
    // ⚠️ 实测铁律（血泪）：`height: Fit` + on_render **零产出**时，该节点会整个
    //    从布局树消失，并连带扰乱后续兄弟的尺寸分配（Fill 算错）。
    //    所以动态面板一律**显式高度**，空状态也保留占位。
    //
    // ★★ 2026-10-01 位置大改：**从页面底部（工具条之后）挪到页头之下**。
    //    为什么非挪不可（这不是审美问题，是硬约束）：
    //      ScrollYView 是 Flow::Down，总高超出 892px 视口时，**排在最后的节点
    //      会被裁掉、直接从布局树里消失**（不是「看不见」——snap 里根本没有它）。
    //      新增的「分区导航 45 + 吉祥物条 70 + 视图切换 30」让页面长高约 145px，
    //      结果 `tools` 被压成 4px、`status_panel` 整个消失 —— 直接后果是
    //      ① `assert_clean` 读不到「已加载 0 个事件」（7 条流程全部前置失败）；
    //      ② 写完事件后 `e2e.py write` 抓不到「已写入 N 个事件」那条状态文案。
    //    把状态条提到页头下面后，「工具条之前的总高」不再包含这 52px 的尾巴，
    //    底部只剩下 tools 一个必须完整可见的常驻条 —— 预算立刻宽松 44px。
    //    ⚠️ 它是**常驻**的（任何分区、任何面板都显示）：状态文案是操作反馈，
    //      藏起来就等于没反馈。因此它占的这 52px 必须永远算进竖向预算。
    status_panel := RoundedView{width: Fill height: 52.0 flow: Down
        draw_bg +: {color: c_paper}
        on_render: || {
            RoundedView{width: Fill height: 44.0 flow: Right spacing: 8 margin: Inset{left: 20 right: 20 top: 4 bottom: 4} padding: Inset{top: 9 bottom: 9 left: 12 right: 12}
                draw_bg +: {color: status_bg border_radius: 8.0 border_size: 1.0 border_color: status_bd}
                // ⚠️ 不用字符图标（✓ ✕ 在 LiberationMono / IBMPlexSans 里都没有字形，
                //    实测渲染成豆腐块）。改成 draw_bg 画的实心圆点，颜色已由 status_fg 三态区分。
                CircleView{width: 6.0 height: 6.0 margin: Inset{top: 10}
                    draw_bg +: {color: status_fg border_radius: 0.0}}
                Label{width: Fill text: status_text align: Align{x: 0.0 y: 0.0} draw_text.color: status_fg
                    draw_text.text_style: theme.font_regular{font_size: 12}}
            }
        }
    }

    // ══ 分区导航（2026-10-01 新增）══════════════════════════════
    // 5 个分区：日程 / 待办 / 心情 / 目标 / 彩蛋。同一时刻只显示一段。
    // ★★ 为什么不是「往下继续叠面板」：本页的竖向预算是硬约束 ——
    //    实测任何常驻内容多占几十像素，就会把面板底部的按钮挤出 892px 视口
    //    （已踩三次，e2e 报「找不到按钮」）。所以：
    //      ① 新功能一律做成**互斥分区**，不新增常驻竖条；
    //      ② 这个导航条本身在**任何面板打开时收起** —— 面板打开时的几何
    //         与改动前完全一致，从结构上杜绝「按钮被挤出视口」的回归。
    // ★ 当前分区的指示：按钮的填充色改不了（静态声明），所以每个分区下面挂一条
    //    3px 的**标记条**（tab_mark0..4），靠 set_visible 切换 —— 可见性是
    //    一定能改的。比改文案（「· 日程」）清楚得多。
    tabbar := RoundedView{width: Fill height: Fit flow: Right spacing: 6
        padding: Inset{left: 20 right: 20 top: 3 bottom: 0}
        draw_bg +: {color: c_paper}

        RoundedView{width: Fill height: Fit flow: Down draw_bg +: {color: c_paper}
            tab_btn0 := ButtonFlat{text: "日程" width: Fill height: 28.0 padding: Inset{left: 0 right: 0}
                on_click: || set_tab(0)
                draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                    color_disabled: c_ink3 text_style: theme.font_regular{font_size: 12}}}
            tab_mark0 := RoundedView{width: Fill height: 3.0 margin: Inset{left: 10 right: 10}
                draw_bg +: {color: c_accent border_radius: 2.0}}
        }
        RoundedView{width: Fill height: Fit flow: Down draw_bg +: {color: c_paper}
            tab_btn1 := ButtonFlat{text: "待办" width: Fill height: 28.0 padding: Inset{left: 0 right: 0}
                on_click: || set_tab(1)
                draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                    color_disabled: c_ink3 text_style: theme.font_regular{font_size: 12}}}
            tab_mark1 := RoundedView{width: Fill height: 3.0 margin: Inset{left: 10 right: 10}
                draw_bg +: {color: c_accent border_radius: 2.0}}
        }
        RoundedView{width: Fill height: Fit flow: Down draw_bg +: {color: c_paper}
            tab_btn2 := ButtonFlat{text: "心情" width: Fill height: 28.0 padding: Inset{left: 0 right: 0}
                on_click: || set_tab(2)
                draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                    color_disabled: c_ink3 text_style: theme.font_regular{font_size: 12}}}
            tab_mark2 := RoundedView{width: Fill height: 3.0 margin: Inset{left: 10 right: 10}
                draw_bg +: {color: c_accent border_radius: 2.0}}
        }
        RoundedView{width: Fill height: Fit flow: Down draw_bg +: {color: c_paper}
            tab_btn3 := ButtonFlat{text: "目标" width: Fill height: 28.0 padding: Inset{left: 0 right: 0}
                on_click: || set_tab(3)
                draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                    color_disabled: c_ink3 text_style: theme.font_regular{font_size: 12}}}
            tab_mark3 := RoundedView{width: Fill height: 3.0 margin: Inset{left: 10 right: 10}
                draw_bg +: {color: c_accent border_radius: 2.0}}
        }
        RoundedView{width: Fill height: Fit flow: Down draw_bg +: {color: c_paper}
            tab_btn4 := ButtonFlat{text: "小知识" width: Fill height: 28.0 padding: Inset{left: 0 right: 0}
                on_click: || set_tab(4)
                draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                    color_disabled: c_ink3 text_style: theme.font_regular{font_size: 12}}}
            tab_mark4 := RoundedView{width: Fill height: 3.0 margin: Inset{left: 10 right: 10}
                draw_bg +: {color: c_accent border_radius: 2.0}}
        }
    }

    // ══ 吉祥物互动条（2026-10-01 新增）══════════════════════════
    // 用户反馈：「吉祥物感觉有跟没有差不多」—— 它此前只在最底部的关于面板里出现，
    // 平时根本看不见，也没有任何作用。现在挪到首页、**可点击**：
    // 点一下章鱼就换一句话（今日概览 / 使用提示），让它在页面主路径上真的存在。
    // ⚠️ 图像上叠一个透明 ButtonFlat 来接点击（Image 自己没有 on_click）——
    //    与月历的「画布 + 点击层」同一套路。悬停用**半透明**赤陶，
    //    否则会把章鱼整个盖住（同 grid 的血泪）。
    // ★ 2026-10-01 瘦身：图像 52→44，并**去掉常驻的「↑ 点章鱼换一句」提示行**
    //   （它自己也是 ~28px 的一行）。可发现性改由吉祥物文案本身承担 ——
    //   第 9 句就是「点我，我还能再说一句」。竖向预算的账见 status_panel 的说明。
    mascot_bar := RoundedView{width: Fill height: Fit flow: Right spacing: 10
        padding: Inset{left: 20 right: 20 top: 1 bottom: 2}
        draw_bg +: {color: c_paper}
        RoundedView{width: 44.0 height: 44.0 flow: Overlay align: Align{x: 0.0 y: 0.0}
            draw_bg +: {color: c_card border_radius: 10.0}
            Image{width: 44.0 height: 44.0 src: http_resource("{{assets}}/octo-mascot-96.webp")
                fit: ImageFit.CropToFill}
            ButtonFlat{text: "" width: 44.0 height: 44.0 margin: 0 padding: 0 on_click: || mascot_next()
                draw_bg +: {border_radius: 10.0 border_size: 0.0 color: #x0000 color_hover: c_hover_bg
                    color_down: c_down_bg color_focus: #x0000 color_disabled: #x0000}
                draw_text +: {color: #x0000 color_hover: #x0000 color_down: #x0000 color_focus: #x0000
                    color_disabled: #x0000}}
        }
        RoundedView{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{top: 4}
            draw_bg +: {color: c_paper}
            mascot_say := Label{width: Fill text: "" draw_text.color: c_ink2
                draw_text.text_style: theme.font_regular{font_size: 11}}
        }
    }

    // ══ Mini 月历 .cal{padding:18px 20px 16px} ═══════════════
    // 加 id：关于页打开时整块让位（见 toggle_about）
    cal_box := RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 18 bottom: 16}
        draw_bg +: {color: c_card}

        // .cal-top{margin-bottom:12px}：左 .ym{14.5px/600}，右 .nav{‹ · › 26x24}
        RoundedView{width: Fill height: Fit flow: Right spacing: 6 draw_bg +: {color: c_card}
            // ── 日 / 周 / 月 视图切换（2026-10-01 新增，同日并入本行）──────────
            // 用户要求「以月、以周、以日为单位的事件视图」。
            // ★ 并入本行的原因只有一个：竖向预算。它原先独占一行（view_bar，30px），
            //   而新增的「分区导航 + 吉祥物条」已经把页面推长了 115px，实测结果
            //   是页面底部的 `tools`（导入/导出）和 `status_panel` 被挤出 892px 视口，
            //   直接从布局树里消失（详见 status_panel 上方那段血泪说明）。
            //   同时删掉本行原有的 `cal_ym`（「2026 · 9」）—— 页头 27px 的大标题
            //   已经写着「2026 年 9 月」，同一句话隔 200px 写两遍没有意义。
            // ⚠️ 当前视图的指示靠**按钮文案**（选中显示 `[月]`，未选中 `月`），
            //   不靠颜色 —— 静态声明的按钮填充色改不了（见 view_btn_label）。
            //   宽度实测：`[月]` 三个字形在 font_regular 11px 下 ≈27px，34px 装得下。
            vbtn_m := ButtonFlat{text: "月" width: 34.0 height: H_NAV padding: Inset{left: 0 right: 0}
                on_click: || set_cal_view(0)
                draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                    color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
            vbtn_w := ButtonFlat{text: "周" width: 34.0 height: H_NAV padding: Inset{left: 0 right: 0}
                on_click: || set_cal_view(1)
                draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                    color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
            vbtn_d := ButtonFlat{text: "日" width: 34.0 height: H_NAV padding: Inset{left: 0 right: 0}
                on_click: || set_cal_view(2)
                draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                    color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
            Label{width: Fill text: "" draw_text.color: c_ink3}
            // 节日来源切换：点一下在「中国 → 国际 → 全部」之间循环。
            // 文案用 font_regular（含中文，font_code 会渲染成豆腐块）；
            // 内容是动态的，所以按钮必须静态声明 + 用 set_text 同步（见 refresh_all）。
            fest_btn := ButtonFlat{text: "节日 中国" height: H_NAV margin: Inset{right: 6}
                padding: Inset{left: 8 right: 8} on_click: || cycle_festival_mode()
                draw_bg +: {border_radius: 6.0 color: c_accent_s color_hover: c_accent_s color_down: c_accent_s
                    color_focus: c_accent_s border_size: 1.0 border_color: #xf0d9c9 border_color_focus: #xf0d9c9}
                draw_text +: {color: c_accent color_hover: c_accent color_down: c_accent color_focus: c_accent
                    color_disabled: c_ink3 text_style: theme.font_regular{font_size: 10}}}
            // .nav button{26x24 radius:6 line2 描边 ink2 字}
            ButtonFlat{text: "<" width: 26.0 height: H_NAV padding: Inset{left: 0 right: 0} on_click: || nav_month(-1)
                draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3 text_style: theme.font_code{font_size: 11}}}
            ButtonFlat{text: "·" width: 26.0 height: H_NAV padding: Inset{left: 0 right: 0} on_click: || nav_month(0)
                draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3 text_style: theme.font_code{font_size: 11}}}
            ButtonFlat{text: ">" width: 26.0 height: H_NAV padding: Inset{left: 0 right: 0} on_click: || nav_month(1)
                draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3 text_style: theme.font_code{font_size: 11}}}
        }

        // ══ 视图切换已并入上面的 cal-top 行（2026-10-01）════════════
        //    这里原本是一个独立的 view_bar（30px）。删掉它是为了竖向预算 ——
        //    见上方 cal-top 行的说明。`vnow`（「月视图 · 格子底色越深…」）
        //    也一并去掉：当前视图由按钮文案 `[月]` 表达，而「底色越深日程越多」
        //    这条图例挪进了吉祥物的轮换文案（mascot_line 的第 7 句）。

        // .dow{9.5px gap:2 margin-bottom:5px}
        // ⚠️ 星期头是中文 → 必须用 font_regular；font_code(LiberationMono) 无 CJK 字形（实测豆腐块）。
        RoundedView{width: Fill height: 26.0 flow: Right spacing: 2 padding: Inset{top: 8} draw_bg +: {color: c_card}
            Label{width: Fill height: 18.0 text: "一" align: Align{x: 0.5 y: 0.5} draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            Label{width: Fill height: 18.0 text: "二" align: Align{x: 0.5 y: 0.5} draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            Label{width: Fill height: 18.0 text: "三" align: Align{x: 0.5 y: 0.5} draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            Label{width: Fill height: 18.0 text: "四" align: Align{x: 0.5 y: 0.5} draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            Label{width: Fill height: 18.0 text: "五" align: Align{x: 0.5 y: 0.5} draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            Label{width: Fill height: 18.0 text: "六" align: Align{x: 0.5 y: 0.5} draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            Label{width: Fill height: 18.0 text: "日" align: Align{x: 0.5 y: 0.5} draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
        }

        // .grid{gap:2}  .d{height:40px}（原 34 —— 34 装不下「班」字，见文件里 2026-09-30 的说明）
        //
        // ★★ 网格线（2026-09-30 用户要求）：日期格子之间要有分隔线，
        //    否则「这一格是哪一天」分不出来，整片连成一团。
        //    做法**不是**给每个格子加 border —— 7×6 的方框会画成双线，
        //    圆角还会互相打架。真正的做法是**让容器的底色从格子间隙里露出来**：
        //      grid 与每一行的 draw_bg 设成线色 c_line2，每个格子自己铺满 c_card，
        //      spacing 那 1px 就自然成为网格线 —— 横竖都有，线宽严格相等。
        //    高度 = 6 × 52 + 5 × 1 = 317
        // ══ 月历网格：画布 + 点击层（flow: Overlay 双层）══════════════
        // ★★ 2026-09-30 第三次改版，起因是用户两句话：
        //    「为什么那些日期不能点开 / 我在具体的日期里面写下这一天要做什么」
        //    「鼠标移到哪个方块上，它就显现出跟其他方块不一样的方框、颜色」
        //    —— 格子要**可点**，并且要有**逐格悬停高亮**。
        //
        //    ⚠️ 为什么必须做成「两层」，而不是直接给格子挂 on_click / hover：
        //      ① 格子是 on_render 里建出来的 —— on_render 重建出的控件
        //         **on_click 不会重绑**，点了没反应（血泪见下面 confirm_bar 的注释）。
        //      ② 纯 View / RoundedView **没有悬停高亮**：makepad 的 hover 分支是
        //         `Hit::FingerHoverIn => if self.animator.is_defined { ... }`
        //         （widgets/src/view.rs:1070）—— 脚本里**定义不了 animator**，
        //         这个分支永远进不去。
        //      → 唯一同时满足「逐格可点 + 逐格 hover」的控件是 **ButtonFlat**：
        //        它自带 color_hover 四态混色，on_click 静态声明也可靠。
        //      → 于是：底层照旧是 on_render 画布（数字 / 圆点 / 节日名），
        //        顶层叠 42 个**静态透明 ButtonFlat**，几何与画布 1:1。
        //
        //    ⚠️ Flow::Overlay 的语义（draw/src/turtle.rs:4595）：子节点**不推进**
        //       turtle 位置 —— 全部落在同一个原点，容器尺寸取并集。所以两层天然
        //       严丝合缝，不需要任何偏移补偿。
        //       声明顺序 = 绘制顺序 ⇒ **按钮层必须写在画布之后**，否则会被画布压住。
        //
        //    ⚠️ 命中测试（实测）：按钮层在最上面 ⇒ hover / 点击都命中按钮；
        //       画布里的 Label / RoundedView 不参与命中（View 需要 cursor 或 animator）。
        grid := RoundedView{width: Fill height: 317.0 flow: Overlay
            align: Align{x: 0.0 y: 0.0} draw_bg +: {color: c_line2}
            // ── 底层：画布（数字 / 圆点 / 节日名）。以下结构原样保留，仅整体缩进。
            //    网格线仍然是「让容器底色从 1px 间隙里露出来」，线宽严格相等。
            canvas := RoundedView{width: Fill height: 317.0 flow: Down spacing: 1.0
                draw_bg +: {color: c_line2}
                on_render: || {
                    let cs = cal_cells()
                    for row in 0..6 {
                        RoundedView{width: Fill height: 52.0 flow: Right spacing: 1.0 draw_bg +: {color: c_line2}
                            for col in 0..7 {
                                let c = cs[row * 7 + col]
                                // 选中态要用**绝对下标**，先算出来
                                // （on_render 里只有 row/col，没有 i）
                                let ci = row * 7 + col
                                // .d = {height:34, 居中, mono 12.5px}
                                //   普通 ink2 / .out #c9c3bc / .today 实心 ink 白字
                                //   .sel 赤陶浅底 / .has 底部小圆点
                                // ★★ 月历格子（2026-09-30 第二次改版 —— 用户反馈「这格子太丑了」）
                                //   旧版三个毛病，一次改掉：
                                //   ① 每格 border_radius: 7 + 1px 缝 → 42 块**圆角小白砖**浮在米色底上，
                                //      像瓷砖 / 马赛克，不像日历。→ **改直角**（radius 0）：整片网格
                                //      变成「一块白底 + 发丝线」，这是主流做法（iOS / Google 月视图都直角）。
                                //   ② 缝底色用的是 c_line2 #xd5cfc8 —— 那是「描边」色，偏深偏暖，
                                //      铺满整片网格时分量太重，整体发脏。→ **改用 c_line #e7e3de**
                                //      （那才是「分隔线 / 发丝线」色）。
                                //   ③ 「今天」原把**整格 52px 刷成墨黑圆角块** —— 那是全页最重的一块，
                                //      看着像「一个被按下的按钮」，而不是「今天」。→ **改成数字外套一个
                                //      26px 实心圆**：视觉重量 52² = 2704px² → π·13² ≈ 531px²（降到 1/5）。
                                //   顺带修一个真 bug：旧版 kind == 2 的分支**只画数字** ——
                                //      「今天」那格的事件点 / 放假标记 / 节日名**全被丢掉**了。
                                //      现在标记行对所有格子共用，今天也有标记。
                                //   结构统一成「数字行 27 + 标记行 23」——于是同一行里每个数字
                                //      都在同一条水平线上（旧版：无标记的格子数字居中、有标记的偏上，
                                //      一行之内数字是错位的）。
                                RoundedView{width: Fill height: 52.0 flow: Down align: Align{x: 0.5 y: 0.5}
                                    draw_bg +: {color: cell_bg(ci, c) border_radius: 0.0}
                                    // ── 数字行：按当天性质四选一（今天 / 上下月 / 放假 / 调休 / 普通）──
                                    if c.kind == 2 {
                                        // 今天：实心墨圆 + 白字（不再整格反色）
                                        RoundedView{width: 26.0 height: 26.0 flow: Down align: Align{x: 0.5 y: 0.5}
                                            draw_bg +: {color: c_ink border_radius: 13.0}
                                            Label{text: c.txt draw_text.color: #xffffff
                                                draw_text.text_style: theme.font_bold{font_size: 12}}
                                        }
                                    } else if c.kind == 0 {
                                        // 上/下月：淡色 #c9c3bc
                                        RoundedView{width: Fill height: 27.0 flow: Down align: Align{x: 0.5 y: 0.5}
                                            draw_bg +: {color: #x0000}
                                            Label{width: Fill text: c.txt align: Align{x: 0.5 y: 0.5}
                                                draw_text.color: cell_num(#xc9c3bc, ci)
                                                draw_text.text_style: theme.font_regular{font_size: 12}}
                                        }
                                    } else if c.hol == 1 {
                                        // 放假：绿字
                                        RoundedView{width: Fill height: 27.0 flow: Down align: Align{x: 0.5 y: 0.5}
                                            draw_bg +: {color: #x0000}
                                            Label{width: Fill text: c.txt align: Align{x: 0.5 y: 0.5}
                                                draw_text.color: cell_num(c_ok, ci)
                                                draw_text.text_style: theme.font_bold{font_size: 12}}
                                        }
                                    } else if c.hol == 2 {
                                        // 调休上班：赤陶字（要提醒）
                                        RoundedView{width: Fill height: 27.0 flow: Down align: Align{x: 0.5 y: 0.5}
                                            draw_bg +: {color: #x0000}
                                            Label{width: Fill text: c.txt align: Align{x: 0.5 y: 0.5}
                                                draw_text.color: cell_num(c_accent, ci)
                                                draw_text.text_style: theme.font_code{font_size: 12}}
                                        }
                                    } else {
                                        // 普通日：次级墨色
                                        RoundedView{width: Fill height: 27.0 flow: Down align: Align{x: 0.5 y: 0.5}
                                            draw_bg +: {color: #x0000}
                                            Label{width: Fill text: c.txt align: Align{x: 0.5 y: 0.5}
                                                draw_text.color: cell_num(c_ink2, ci)
                                                draw_text.text_style: theme.font_code{font_size: 12}}
                                        }
                                    }
                                    // ⚠️⚠️ 标记行必须真的**被分配到 ≥23px**（血泪，2026-09-30）：
                                    //    否则 Label 里的 CJK 字形会被裁到只剩中间几条横（看着像个小点）。
                                    //    真正的约束不是这一行写多少，而是**单元格够不够高** ——
                                    //    上面那个数字 Label 的**自然行盒 ≈ 26px**（写 height: 19/21/23
                                    //    都压不下去，makepad 取 max(显式, 自然)），它先吃掉 26px，
                                    //    剩下的才给这一行。实测：
                                    //      单元格 34 → 本行只剩 8~13px → 「班」= 2px 残片
                                    //      单元格 46 → 本行 17px          → 仍是残片
                                    //      单元格 52 → 本行 23px          → 「班」完整清晰 ✅
                                    //    所以 6 行网格高度 = 6 × 52 + 5 × 行距 = 317（行距 1px 就是线本身）。
                                    //    ⚠️ 变的只是行距，**单元格始终是 52** —— 单元格高度才是
                                    //       「班」字能否完整的唯一约束，行距不参与这 52px 的分配。
                                    //    数字行现在写成显式 27px（比自然行盒 26 大 1），
                                    //      27 + 23 = 50 ≤ 52，仍有 2px 余量。
                                    //    另外 align 要用 y: 0.5（垂直居中）；用 y: 0.0 也会把字裁掉。
                                    //    小方块（CircleView）不受影响，只有文字受此限制。
                                    RoundedView{width: Fill height: 23.0 flow: Right spacing: 2
                                        align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x0000}
                                        // .d.has::after{bottom:3px 3.5px 圆点 accent}
                                        if c.dot {
                                            CircleView{width: 3.5 height: 3.5
                                                draw_bg +: {color: c_accent border_radius: 0.0}}
                                        }
                                        // 放假：小绿点
                                        if c.hol == 1 {
                                            CircleView{width: 3.5 height: 3.5
                                                draw_bg +: {color: c_ok border_radius: 0.0}}
                                        }
                                        // 节日但照常上班：小黑点（与「事件点」的赤陶色、
                                        // 「放假点」的绿色区分开 —— 三色三义，不靠位置猜）
                                        if c.fest {
                                            CircleView{width: 3.5 height: 3.5
                                                draw_bg +: {color: c_ink2 border_radius: 0.0}}
                                        }
                                        // ★★ 放假的**每一天**都用绿色小字写出是哪个节日
                                        //   （2026-09-30 用户要求：「这是中秋节还是国庆节」）。
                                        //   只有绿点的话，说不清「放的什么假」—— 国庆 7 天
                                        //   每天一个绿点，但用户想知道的是「这是国庆」。
                                        //   字号 9：最多 3 个汉字 ≈ 37px，加绿点(3.5)+间距(2)
                                        //   仍在格子内容宽（≈52px）之内。
                                        //   ⚠️ 与「班」字同一个坑：**不写 height**、align 用
                                        //      y: 0.5 —— 写死高度或 y: 0.0 都会把 CJK 裁成几条横。
                                        if c.fname != "" {
                                            Label{width: Fit text: c.fname
                                                draw_text.color: c_ok
                                                draw_text.text_style: theme.font_regular{font_size: 9}}
                                        }
                                        // 调休上班：一个「班」字。中文必须 font_regular，
                                        // font_code(LiberationMono) 没有 CJK 字形会变豆腐块。
                                        if c.hol == 2 {
                                            // ⚠️ 不要给这个 Label 写 height、也不要用 flow: Right 的
                                            //    align y=0.0 —— 两者都会让 CJK 字形被裁到只剩中间几条横
                                            //    （只剩 2~3 个像素，看上去像个小点）。
                                            //    实测唯一稳定可读的组合：
                                            //      flow: Right + align: Align{x: 0.5 y: 0.5} + width: Fit（不写 height）
                                            Label{width: Fit text: "班"
                                                draw_text.color: c_accent
                                                draw_text.text_style: theme.font_regular{font_size: 11}}
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── 顶层：点击 / 悬停层（42 个静态透明 ButtonFlat，1:1 盖住格子）──
            //   ⚠️ 尺寸必须与画布**逐项相同**（行高 52 / 行距 1 / 6 行 × 7 列），
            //      否则第 N 格的 hover 会盖到第 N+1 格上 —— 这类错位不看像素发现不了。
            //   ⚠️ ButtonFlat 默认 `margin: theme.mspace_v_1`、`text: "Button"`，
            //      两个都必须显式改掉：margin 会把每格撑宽让 7 格排不下，
            //      text 不置空会画出 42 个 "Button" 字样。
            //   ⚠️ on_click 的下标一律**写字面量**（0..41），不经循环变量 ——
            //      循环里闭包捕获下标在本项目踩过坑，字面量没有歧义。
            //
            //   hover 配色（用户要求「你认为什么颜色最好看」）：
            //     **半透明**赤陶底 + 1px 赤陶内描边 c_accent #xb4531f。
            //     选它有三个理由：
            //       ① 整片网格是「白底 + 发丝线」，四类语义（今天墨黑 / 放假绿 /
            //          调休赤陶 / 普通灰）**全都是白底上的字色**，没有任何填充块 ——
            //          所以悬停只要「浅底 + 细描边」就足够醒目，不会与语义抢眼。
            //       ② 赤陶是这个应用唯一的强调色（确认条底色、节日按钮同色系），
            //          用它做悬停＝沿用既有语言，不必引入第五种颜色。
            //       ③ 只靠浅底表达太弱，所以补 1px 赤陶内描边 ——
            //          用户原话就是「显现出来那个方框」。
            //
            //   ⚠️⚠️⚠️ 血泪（2026-09-30，用户实测报回来的真 bug）：
            //      **悬停底必须带透明度，否则会把日期数字整块擦掉。**
            //      这一层点击按钮画在**画布之上**，而日期数字 / 事件点 / 节日名
            //      全是画布画的。第一版把 color_hover 写成**不透明**的 #xfbeadf，
            //      于是鼠标一移上去数字就被糊没 —— 用户原话「那个日期消失了，
            //      就只剩空白了」。颜色本身挑得没错，错的是**不透明度**。
            //      修法：八位色值 #xRRGGBBAA（**末字节才是 alpha**，见
            //      makepad/platform/script/src/colorhex.rs 的 `#rrggbbaa` 分支），
            //      取赤陶再深一档做基色 #xe4b28e、alpha 30% → #xe4b28e4d。
            //      实测合成结果（.runtime/diag15.sh，用 color_focus 当代理色取像素）：
            //        未选中的格：底 白→#f7e8dd、数字 #191714→#564639（**依然清晰**）
            //        已选中的格：底 #f6dcc7→#f1d0b6、数字 #b4531f→#c37141（仍可读）
            //      ⇒ 一条纪律：**点击层里任何状态色（color / hover / down / focus）
            //        都不许不透明** —— 不透明就是「把画布擦掉」。
            //        静态门禁 tools/cellhover.py 专门守这一条（第 7 道门禁）。
            //
            //   ⚠️ color_focus 必须写 #x0000（透明）：ButtonFlat 一被点就 set_key_focus
            //      （button.rs 的 Hit::FingerDown），填充色落到 color_focus 上；
            //      若照抄主题色，点过的格子会**一直亮着**，看着像坏了。
            //
            //   ⚠️ 关于「hover 到底能不能测」—— 这里之前的结论是错的，已更正：
            //      **真机上 hover 是有效的**（用户就是拿真鼠标看到数字被擦掉的）；
            //      但 card-host 的**合成**鼠标输入复现不出来 —— 用纯红 #xff0000 做
            //      hover，`/m?k=move`（含 `&hw=1` 那条硬件路径）、可见窗口、隐藏窗口、
            //      等 3 秒、点一下再截图，全都测过，格子上**一个像素都没变**
            //      （两图 md5 相同）。所以**不能**拿合成 hover 当验收手段，改用：
            //        ① 静态门禁 cellhover.py —— 从根上禁止「不透明压画布」；
            //        ② color_focus 代理取像素 —— 焦点是持久的、能真实画出来，
            //           正好用来验「半透明合成之后数字还看不看得见」（diag15.sh）。
            //      另外，点中的那一格由**画布自己**画成 c_sel_bg 底 + 赤陶数字，
            //      这层反馈不经过任何动画器，永远看得见。
            click_layer := RoundedView{width: Fill height: 317.0 flow: Down spacing: 1.0
                draw_bg +: {color: #x0000}
                RoundedView{width: Fill height: 52.0 flow: Right spacing: 1.0 draw_bg +: {color: #x0000}
                    ButtonFlat{text: "" width: Fill height: 52.0 margin: 0 padding: 0 on_click: || pick_cell(0)
                        draw_bg +: {border_radius: 0.0 border_size: 1.0 color: #x0000 color_hover: c_hover_bg
                            color_down: c_down_bg color_focus: #x0000 color_disabled: #x0000
                            border_color: #x0000 border_color_hover: c_accent border_color_down: c_accent
                            border_color_focus: #x0000 border_color_disabled: #x0000}
                        draw_text +: {color: #x0000 color_hover: #x0000 color_down: #x0000
                            color_focus: #x0000 color_disabled: #x0000}}
                    ButtonFlat{text: "" width: Fill height: 52.0 margin: 0 padding: 0 on_click: || pick_cell(1)
                        draw_bg +: {border_radius: 0.0 border_size: 1.0 color: #x0000 color_hover: c_hover_bg
                            color_down: c_down_bg color_focus: #x0000 color_disabled: #x0000
                            border_color: #x0000 border_color_hover: c_accent border_color_down: c_accent
                            border_color_focus: #x0000 border_color_disabled: #x0000}
                        draw_text +: {color: #x0000 color_hover: #x0000 color_down: #x0000
                            color_focus: #x0000 color_disabled: #x0000}}
                    ButtonFlat{text: "" width: Fill height: 52.0 margin: 0 padding: 0 on_click: || pick_cell(2)
                        draw_bg +: {border_radius: 0.0 border_size: 1.0 color: #x0000 color_hover: c_hover_bg
                            color_down: c_down_bg color_focus: #x0000 color_disabled: #x0000
                            border_color: #x0000 border_color_hover: c_accent border_color_down: c_accent
                            border_color_focus: #x0000 border_color_disabled: #x0000}
                        draw_text +: {color: #x0000 color_hover: #x0000 color_down: #x0000
                            color_focus: #x0000 color_disabled: #x0000}}
                    ButtonFlat{text: "" width: Fill height: 52.0 margin: 0 padding: 0 on_click: || pick_cell(3)
                        draw_bg +: {border_radius: 0.0 border_size: 1.0 color: #x0000 color_hover: c_hover_bg
                            color_down: c_down_bg color_focus: #x0000 color_disabled: #x0000
                            border_color: #x0000 border_color_hover: c_accent border_color_down: c_accent
                            border_color_focus: #x0000 border_color_disabled: #x0000}
                        draw_text +: {color: #x0000 color_hover: #x0000 color_down: #x0000
                            color_focus: #x0000 color_disabled: #x0000}}
                    ButtonFlat{text: "" width: Fill height: 52.0 margin: 0 padding: 0 on_click: || pick_cell(4)
                        draw_bg +: {border_radius: 0.0 border_size: 1.0 color: #x0000 color_hover: c_hover_bg
                            color_down: c_down_bg color_focus: #x0000 color_disabled: #x0000
                            border_color: #x0000 border_color_hover: c_accent border_color_down: c_accent
                            border_color_focus: #x0000 border_color_disabled: #x0000}
                        draw_text +: {color: #x0000 color_hover: #x0000 color_down: #x0000
                            color_focus: #x0000 color_disabled: #x0000}}
                    ButtonFlat{text: "" width: Fill height: 52.0 margin: 0 padding: 0 on_click: || pick_cell(5)
                        draw_bg +: {border_radius: 0.0 border_size: 1.0 color: #x0000 color_hover: c_hover_bg
                            color_down: c_down_bg color_focus: #x0000 color_disabled: #x0000
                            border_color: #x0000 border_color_hover: c_accent border_color_down: c_accent
                            border_color_focus: #x0000 border_color_disabled: #x0000}
                        draw_text +: {color: #x0000 color_hover: #x0000 color_down: #x0000
                            color_focus: #x0000 color_disabled: #x0000}}
                    ButtonFlat{text: "" width: Fill height: 52.0 margin: 0 padding: 0 on_click: || pick_cell(6)
                        draw_bg +: {border_radius: 0.0 border_size: 1.0 color: #x0000 color_hover: c_hover_bg
                            color_down: c_down_bg color_focus: #x0000 color_disabled: #x0000
                            border_color: #x0000 border_color_hover: c_accent border_color_down: c_accent
                            border_color_focus: #x0000 border_color_disabled: #x0000}
                        draw_text +: {color: #x0000 color_hover: #x0000 color_down: #x0000
