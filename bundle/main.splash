                        on_click: || goal_step_toggle(2, 2)
                        draw_bg +: {border_radius: 5.0 color: c_card color_hover: c_paper color_down: c_paper
                            color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                        draw_text +: {color: c_ink3 color_hover: c_accent color_down: c_accent color_focus: c_ink3
                            text_style: theme.font_code{font_size: 10}}}
                    gs_t22 := Label{width: Fill text: "" draw_text.color: c_ink
                        draw_text.text_style: theme.font_regular{font_size: 11}}
                }
            }
        }
    }

    // ══ 小知识分区（2026-10-01 第三轮改造）════════════════════════════
    // 用户原话（第三轮反馈）：
    //   - 「节日」部分重做：「历史上的今天」应该是偏技术/探索的内容；
    //   - 每天**只出现一个**（中国特别日 > 国际节日 > 节气 > 历史上的今天）；
    //   - **中国特殊日子要专门写**（九一八、国庆等，对中国有特定意义）；
    //   - **没有就不要改**（无内容时整张卡不渲染，不显示「暂无」占位）；
    //   - 改名为「小知识」（不再是「彩蛋」）。
    // 卡片结构 —— 2 张：
    //   1. 「今日」卡 —— 单卡多义，按上述优先级挑一条；挑不到整张不渲染
    //      （选编数据边界写在卡内 hint，参见 CHINA_FIXED / INTL_FIXED / SOLAR_TERMS / HISTORY）。
    //   2. 「时间胶囊」卡 —— 写给未来的信，独立功能，与展示无关，保留。
    sec_egg := RoundedView{width: Fill height: Fit flow: Down
        draw_bg +: {color: c_paper}
        RoundedView{width: Fill height: Fit flow: Down spacing: 8
            padding: Inset{left: 20 right: 20 top: 4 bottom: 10} draw_bg +: {color: c_card}
            RoundedView{width: Fill height: Fit flow: Right spacing: 6 draw_bg +: {color: c_card}
                Label{text: "小知识" draw_text.color: c_ink
                    draw_text.text_style: theme.font_bold{font_size: 15}}
                Label{width: Fill text: "" draw_text.color: c_ink3}
                ButtonFlat{text: "前一天" height: 24.0 padding: Inset{left: 10 right: 10}
                    on_click: || egg_roll_by(-1)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 10}}}
                ButtonFlat{text: "回到关注日" height: 24.0 padding: Inset{left: 10 right: 10}
                    on_click: || egg_reset()
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 10}}}
                ButtonFlat{text: "后一天" height: 24.0 padding: Inset{left: 10 right: 10}
                    on_click: || egg_roll_by(1)
                    draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 10}}}
            }
            // ── 今日卡（按 egg_today_pick 返回的内容挑；tag 非空才渲染）──
            //   三种背景：
            //     中国 / 国际      → c_accent_s（节日、信息密度）
            //     节气             → c_ok_s（节气、绿色系）
            //     历史上的今天     → c_card + 1px 描边（中性）
            //   用 set_visible 控制：挑不到就让整张卡消失，不显示占位文字。
            egg_today_card := RoundedView{width: Fill height: Fit flow: Down spacing: 3
                padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
                draw_bg +: {color: c_card border_radius: 8.0 border_size: 1.0 border_color: c_line}
                egg_date_l := Label{width: Fill text: "" draw_text.color: c_ink3
                    draw_text.text_style: theme.font_bold{font_size: 13}}
                egg_today_tag := Label{width: Fill text: "" draw_text.color: c_accent
                    draw_text.text_style: theme.font_bold{font_size: 12}}
                egg_today_title := Label{width: Fill text: "" draw_text.color: c_ink
                    draw_text.text_style: theme.font_bold{font_size: 16}}
                egg_today_hint := Label{width: Fill text: "" draw_text.color: c_ink3
                    draw_text.text_style: theme.font_regular{font_size: 10}}
            }
            // ── 时间胶囊 ──
            RoundedView{width: Fill height: Fit flow: Down spacing: 6
                padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
                draw_bg +: {color: c_card border_radius: 8.0 border_size: 1.0 border_color: c_line}
                Label{width: Fill text: "时间胶囊" draw_text.color: c_ink
                    draw_text.text_style: theme.font_bold{font_size: 13}}
                cap_where := Label{width: Fill text: "" draw_text.color: c_ink3
                    draw_text.text_style: theme.font_regular{font_size: 10}}
                RoundedView{width: Fill height: 34.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                    cap_in := TextInput{width: Fill height: 30 empty_text: "写一句给未来的自己"
                        draw_bg +: {color: c_card color_hover: c_card color_focus: c_card color_empty: c_card
                            border_radius: 8.0 border_size: 1.0 border_color: c_line2}
                        draw_text +: {color: c_ink color_hover: c_ink color_focus: c_ink
                            color_empty: c_ink3 color_empty_hover: c_ink3}}
                    ButtonFlat{text: "封存" height: 28.0 padding: Inset{left: 12 right: 12}
                        on_click: || cap_add()
                        draw_bg +: {border_radius: 7.0 color: c_ink color_hover: #x000000 color_down: #x333333
                            color_focus: c_ink border_size: 1.0 border_color: c_ink border_color_focus: c_ink}
                        draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff
                            text_style: theme.font_regular{font_size: 11}}}
                }
                cp_r0 := RoundedView{width: Fill height: 26.0 flow: Right spacing: 6 draw_bg +: {color: c_card}
                    cp_t0 := Label{width: Fill text: "" draw_text.color: c_ink2
                        draw_text.text_style: theme.font_regular{font_size: 11}}
                    cp_b0 := ButtonFlat{text: "开启" height: 24.0 padding: Inset{left: 10 right: 10}
                        on_click: || cap_open_it(0)
                        draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                            color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                        draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                            color_disabled: c_ink3 text_style: theme.font_regular{font_size: 10}}}
                    cp_x0 := ButtonFlat{text: "删除" height: 24.0 padding: Inset{left: 10 right: 10}
                        on_click: || cap_del(0)
                        draw_bg +: {border_radius: 6.0 color: c_card color_hover: #xfdecec color_down: #xfdecec
                            color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                        draw_text +: {color: #xb91c1c color_hover: #xb91c1c color_down: #xb91c1c color_focus: #xb91c1c
                            text_style: theme.font_regular{font_size: 10}}}
                }
                cp_r1 := RoundedView{width: Fill height: 26.0 flow: Right spacing: 6 draw_bg +: {color: c_card}
                    cp_t1 := Label{width: Fill text: "" draw_text.color: c_ink2
                        draw_text.text_style: theme.font_regular{font_size: 11}}
                    cp_b1 := ButtonFlat{text: "开启" height: 24.0 padding: Inset{left: 10 right: 10}
                        on_click: || cap_open_it(1)
                        draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                            color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                        draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                            color_disabled: c_ink3 text_style: theme.font_regular{font_size: 10}}}
                    cp_x1 := ButtonFlat{text: "删除" height: 24.0 padding: Inset{left: 10 right: 10}
                        on_click: || cap_del(1)
                        draw_bg +: {border_radius: 6.0 color: c_card color_hover: #xfdecec color_down: #xfdecec
                            color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                        draw_text +: {color: #xb91c1c color_hover: #xb91c1c color_down: #xb91c1c color_focus: #xb91c1c
                            text_style: theme.font_regular{font_size: 10}}}
                }
                cp_r2 := RoundedView{width: Fill height: 26.0 flow: Right spacing: 6 draw_bg +: {color: c_card}
                    cp_t2 := Label{width: Fill text: "" draw_text.color: c_ink2
                        draw_text.text_style: theme.font_regular{font_size: 11}}
                    cp_b2 := ButtonFlat{text: "开启" height: 24.0 padding: Inset{left: 10 right: 10}
                        on_click: || cap_open_it(2)
                        draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                            color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                        draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                            color_disabled: c_ink3 text_style: theme.font_regular{font_size: 10}}}
                    cp_x2 := ButtonFlat{text: "删除" height: 24.0 padding: Inset{left: 10 right: 10}
                        on_click: || cap_del(2)
                        draw_bg +: {border_radius: 6.0 color: c_card color_hover: #xfdecec color_down: #xfdecec
                            color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                        draw_text +: {color: #xb91c1c color_hover: #xb91c1c color_down: #xb91c1c color_focus: #xb91c1c
                            text_style: theme.font_regular{font_size: 10}}}
                }
            }
        }
    }

    // ══ 导入面板（点「导入」才展开；设计稿未画，按同一设计语言补）═══
    // ⚠️ 输入框必须**静态声明**：放 on_render 里就没有稳定的 `ui.entry` 引用，
    //    `ui.entry.text()` / `set_text()` 全部失效。显隐用 `set_visible()`。
    // ⚠️ 高度必须算够：padding 4+12 + 提示 24 + 间距 8 + 输入框 116 + 间距 8 + 按钮行 32 = 204。
    //    给 186 会把按钮压成 11px（实测）。
    import_panel := RoundedView{width: Fill height: 204.0 flow: Down
        draw_bg +: {color: c_paper}
        RoundedView{width: Fill height: 204.0 flow: Down padding: Inset{left: 20 right: 20 top: 4 bottom: 12} spacing: 8
            draw_bg +: {color: c_paper}
            // ⚠️ 这行**必须控制在一行内**（可用宽 ≈372px）：面板高度是写死的 204，
            //    文案一旦折行，Label 变高就会把下面的输入框压扁。
            //    实测「粘贴 .ics 内容 · 重复日程只显示首个实例」≈319px，安全。
            //    这里承担「重复日程」的告知职责 —— 状态条是设计稿的单行固定版式，
            //    往上面加字会换行并被容器裁掉（已踩过），所以信息放在导入前。
            Label{text: "粘贴 .ics 内容 · 重复日程只显示首个实例"
                draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 11}}
            entry := TextInput{width: Fill height: 116 empty_text: "BEGIN:VCALENDAR …"
                draw_bg +: {color: c_card color_hover: c_card color_focus: c_card color_empty: c_card
                    border_radius: 8.0 border_size: 1.0 border_color: c_line2}
                draw_text +: {color: c_ink color_hover: c_ink color_focus: c_ink color_empty: c_ink3 color_empty_hover: c_ink3}}
            RoundedView{width: Fill height: 32.0 flow: Right spacing: 8 draw_bg +: {color: c_paper}
                Label{width: Fill text: "" draw_text.color: c_ink3}
                ButtonFlat{text: "取消" height: H_TAP padding: Inset{left: 14 right: 14} on_click: || toggle_import()
                    draw_bg +: {border_radius: 8.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3}}
                ButtonFlat{text: "解析" height: H_TAP padding: Inset{left: 14 right: 14} on_click: || start_import()
                    draw_bg +: {border_radius: 8.0 color: c_ink color_hover: #x000000 color_down: #x333333
                        color_focus: c_ink border_size: 1.0 border_color: c_ink border_color_focus: c_ink}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
            }
        }
    }

    // ══ 新建日程面板（点月历格子 / 点工具条「+ 新建」展开）════════════
    // 用户需求原话（2026-09-30）：「为什么那些日期不能点开，我在具体的日期里面去写下
    //   我这一天要做些什么事情」+「专门有一个界面：选择日期，然后可以选择重复这个日期，
    //   比如说每年我的生日……到那天就提醒我」。
    // 接线：pick_cell()/toggle_new() → open_new_on() 预填日期 → 这里保存。
    //
    // ⚠️ 与 import_panel 同一套路：**静态声明 + set_visible 控制显隐**。
    //    输入框若放进 on_render，就没有稳定的 `ui.nt_input` 引用，
    //    text() / set_text() 全部失效。
    // ⚠️ 每个 ButtonFlat 必须写全 color_focus / border_color_focus / draw_text.color_focus。
    //    漏了会触发本项目最重的那个缺陷：点一下按钮整块变白、**看起来像消失了**
    //    （button.rs 的 Hit::FingerDown 会 set_key_focus，而填充色是
    //     color → color_focus → color_hover → color_down 四态混色，只写前者就落到
    //     浅色的 theme.color_outset_focus）。tools/btnfocus.py 会静态拦这一条。
    // ⚠️ 显隐必须走 sync_panels() —— 不要自己 set_visible。三个面板抢同一块竖向空间。
    //
    // ⚠️ 高度用 Fit（内部全是静态子节点，没有 on_render，Fit 是安全的）：
    //    padding 4+12 + 标题 20 + 8 + 标题输入 42 + 8 + 日期行 44 + 8 + 按钮行 32 ≈ 178。
    //    竖向预算（实测）：new_open 时 metrics(39) + fest_bar(44) 一起让位，
    //    所以「头顶 121 + 月历 405 + 工具条 56 + 本面板 178 + 状态条 52 ≈ 812」< 892 视口，
    //    按钮全在上半屏，不需要滚动就点得到。
    new_panel := RoundedView{width: Fill height: Fit flow: Down
        draw_bg +: {color: c_paper}
        RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 4 bottom: 12} spacing: 8
            draw_bg +: {color: c_paper}
            Label{text: "新建日程 · 写在这一天" draw_text.color: c_ink
                draw_text.text_style: theme.font_bold{font_size: 13}}
            // 「这天要做什么」
            // ⚠️ empty_text 走 draw_text 的 color_empty，必须写，否则占位符是黑的。
            nt_input := TextInput{width: Fill height: 42 empty_text: "这天要做什么？例如「妈妈生日」"
                draw_bg +: {color: c_card color_hover: c_card color_focus: c_card color_empty: c_card
                    border_radius: 8.0 border_size: 1.0 border_color: c_line2}
                draw_text +: {color: c_ink color_hover: c_ink color_focus: c_ink color_empty: c_ink3 color_empty_hover: c_ink3}}
            // 日期行：[日期] [输入框 Fill] [重复按钮]
            RoundedView{width: Fill height: 44.0 flow: Right spacing: 8 align: Align{x: 0.0 y: 0.5}
                draw_bg +: {color: c_paper}
                Label{text: "日期" draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 11}}
                nd_input := TextInput{width: Fill height: 36 empty_text: "2026-10-01"
                    draw_bg +: {color: c_card color_hover: c_card color_focus: c_card color_empty: c_card
                        border_radius: 8.0 border_size: 1.0 border_color: c_line2}
                    draw_text +: {color: c_ink color_hover: c_ink color_focus: c_ink color_empty: c_ink3 color_empty_hover: c_ink3}}
                // 重复：点一下循环 不重复 → 每天 → 每周 → 每月 → 每年。
                //   不做下拉框 —— 脚本里没有 select/popup；而「每年」（生日、纪念日）
                //   是这个控件存在的全部理由，循环点按**一次点击**就能到位，更省事。
                nr_btn := ButtonFlat{text: "不重复" height: 32.0 padding: Inset{left: 12 right: 12} on_click: || cycle_repeat()
                    draw_bg +: {border_radius: 8.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3}}
            }
            RoundedView{width: Fill height: 32.0 flow: Right spacing: 8 draw_bg +: {color: c_paper}
                Label{width: Fill text: "" draw_text.color: c_ink3}
                ButtonFlat{text: "取消" height: H_TAP padding: Inset{left: 14 right: 14} on_click: || cancel_new()
                    draw_bg +: {border_radius: 8.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3}}
                ButtonFlat{text: "保存" height: H_TAP padding: Inset{left: 14 right: 14} on_click: || save_new()
                    draw_bg +: {border_radius: 8.0 color: c_ink color_hover: #x000000 color_down: #x333333
                        color_focus: c_ink border_size: 1.0 border_color: c_ink border_color_focus: c_ink}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
            }
        }
    }
    // ══ 写入确认条（有预览时出现）═══
    // ⚠️ 按钮必须**静态声明**：放进 on_render 建出的按钮，on_click 在重建后不会重绑，
    //    点了没反应（实测）。所以这里静态建好，用 set_visible 控制显隐。
    confirm_bar := RoundedView{width: Fill height: 54.0 flow: Down
        draw_bg +: {color: c_paper}
        RoundedView{width: Fill height: 46.0 flow: Right spacing: 8 margin: Inset{left: 20 right: 20 bottom: 8} padding: Inset{top: 9 bottom: 9 left: 12 right: 12}
            draw_bg +: {color: c_accent_s border_radius: 8.0 border_size: 1.0 border_color: #xf0d9c9}
            preview_label := Label{width: Fill text: "" draw_text.color: #x8a3f16 draw_text.text_style: theme.font_regular{font_size: 12}}
            ButtonFlat{text: "取消" height: 28.0 padding: Inset{left: 12 right: 12} on_click: || cancel_import()
                draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3}}
            ButtonFlat{text: "写入" height: 28.0 padding: Inset{left: 12 right: 12} on_click: || confirm_import()
                draw_bg +: {border_radius: 7.0 color: c_ink color_hover: #x000000 color_down: #x333333
                    color_focus: c_ink border_size: 1.0 border_color: c_ink border_color_focus: c_ink}
                draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
        }
    }

    // ══ 冲突面板 ═════════════════════════════════════
    // ⚠️ 与 confirm_bar 同一套路：**静态容器** + set_visible 控制显隐。
    //    原因：① `height: Fit` + on_render 零产出会让节点从布局树消失并扰乱
    //    后续兄弟的 Fill 分配；② on_render 里建出的按钮，重建后 on_click 不重绑 → 点击失效。
    conflict_panel := RoundedView{width: Fill height: Fit flow: Down
        draw_bg +: {color: c_paper}
        conflict_bar := RoundedView{width: Fill height: 44.0 flow: Right spacing: 8 margin: Inset{left: 20 right: 20 top: 4 bottom: 4} padding: Inset{left: 12 right: 12}
            draw_bg +: {color: c_warn_s border_radius: 8.0 border_size: 1.0 border_color: #xf0dfc0}
            conflict_label := Label{width: Fill text: "" draw_text.color: c_warn draw_text.text_style: theme.font_bold{font_size: 13}}
            more_btn := ButtonFlat{text: "详情" height: 26.0 padding: Inset{left: 10 right: 10} on_click: || toggle_more()
                draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: #xf0dfc0 border_color_focus: #xf0dfc0}
                draw_text +: {color: c_warn color_hover: c_warn color_down: c_warn color_focus: c_warn}}
            ButtonFlat{text: "回滚" height: 26.0 padding: Inset{left: 10 right: 10} on_click: || undo_last()
                draw_bg +: {border_radius: 6.0 color: c_card color_hover: c_paper color_down: c_paper
                    color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2 color_disabled: c_ink3}}
            ButtonFlat{text: "应用建议" height: 26.0 padding: Inset{left: 10 right: 10} on_click: || apply_advice()
                draw_bg +: {border_radius: 6.0 color: c_ink color_hover: #x000000 color_down: #x333333
                    color_focus: c_ink border_size: 1.0 border_color: c_ink border_color_focus: c_ink}
                draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
        }
    }

    // 冲突详情（展开态，静态容器 + 动态文字）
    conflict_detail := RoundedView{width: Fill height: Fit flow: Down
        draw_bg +: {color: c_paper}
        RoundedView{width: Fill height: Fit flow: Down margin: Inset{left: 20 right: 20 top: 4 bottom: 4} padding: 12 spacing: 6
            draw_bg +: {color: c_warn_s border_radius: 8.0 border_size: 1.0 border_color: #xf0dfc0}
            advice_line := Label{width: Fill text: "" draw_text.color: c_ink draw_text.text_style: theme.font_regular{font_size: 13}}
            advice_line2 := Label{width: Fill text: "" draw_text.color: c_ink draw_text.text_style: theme.font_regular{font_size: 13}}
            advice_why := Label{width: Fill text: "" draw_text.color: c_ok draw_text.text_style: theme.font_regular{font_size: 11}}
            Label{width: Fill text: "" draw_text.color: c_ink3}
        }
    }

    // ══ 关于面板 ═════════════════════════════════════
    // ⚠️ 静态容器 + set_visible（同 confirm_bar 套路）：on_render 里的按钮点击不重绑。
    about_panel := RoundedView{width: Fill height: Fit flow: Down
        draw_bg +: {color: c_paper}
        // ⚠️ 里面那几行署名的换行数取决于宿主字体宽度（比浏览器宽约 40%），
        //    写死高度必然算错 —— 实测写 192 时「CC BY 4.0」那行和两个按钮
        //    全被挤到窗口外。用 Fit 让内容自己撑开。
        RoundedView{width: Fill height: Fit flow: Down margin: Inset{left: 20 right: 20 top: 4 bottom: 4} padding: 14 spacing: 10
            draw_bg +: {color: c_card border_radius: 10.0 border_size: 1.0 border_color: c_line}
            RoundedView{width: Fill height: 76.0 flow: Right spacing: 12 draw_bg +: {color: c_card}
                Image{width: 72.0 height: 72.0 src: http_resource("{{assets}}/octo-mascot-96.webp") fit: ImageFit.CropToFill}
                RoundedView{width: Fill height: 72.0 flow: Down spacing: 3 draw_bg +: {color: c_card}
                    Label{text: "OctoSense 日历" draw_text.color: c_ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    Label{width: Fill text: "队伍 OMA · ody-cai / mark-liuzh" draw_text.color: c_ink2 draw_text.text_style: theme.font_regular{font_size: 12}}
                    Label{width: Fill text: "版本 0.2.0 · Apache-2.0" draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 11}}
                }
            }
            Hr{draw_bg +: {color: c_line border_size: 0.0 height: 1.0}}
            Label{width: Fill text: "吉祥物来自 Noto Animated Emoji（U+1F419），依 CC BY 4.0 使用，已逐帧重压为本地 WebP。"
                draw_text.color: c_ink2 draw_text.text_style: theme.font_regular{font_size: 11}}
            Label{width: Fill text: "© Google LLC · Noto Animated Emoji · CC BY 4.0"
                draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 11}}
            Label{width: Fill text: "本应用只申请 storage 能力，数据全部留在本机，不联网。"
                draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 11}}
            // ── 共享范围（2026-10-01 新增）──────────────────────────────
            // ⚠️ 必须把边界写在**界面上**，不能只写 README：真正的实时共享要有后端，
            //    本应用只申请 storage、没有网络出口，做不到。这里给的是「离线能做
            //    的最大诚实版本」—— 标记哪些事件愿意分享，导出共享包时只带这些，
            //    私密事件留在本机。把「做不到什么」写在按钮旁边，比含糊其辞强。
            Hr{draw_bg +: {color: c_line border_size: 0.0 height: 1.0}}
            Label{width: Fill text: "共享范围" draw_text.color: c_ink
                draw_text.text_style: theme.font_bold{font_size: 12}}
            share_line := Label{width: Fill text: "" draw_text.color: c_ink2
                draw_text.text_style: theme.font_regular{font_size: 11}}
            Label{width: Fill text: "没有网络出口，所以做不了实时互通；这里只标记「哪些事件愿意分享」，导出共享包时只带这些。"
                draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
            RoundedView{width: Fill height: 30.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                ButtonFlat{text: "全部共享" height: 28.0 padding: Inset{left: 12 right: 12}
                    on_click: || share_all()
                    draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                ButtonFlat{text: "取消共享" height: 28.0 padding: Inset{left: 12 right: 12}
                    on_click: || share_none()
                    draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                ButtonFlat{text: "导出共享包" height: 28.0 padding: Inset{left: 12 right: 12}
                    on_click: || export_shared()
                    draw_bg +: {border_radius: 7.0 color: c_card color_hover: c_paper color_down: c_paper
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: c_ink2 color_hover: c_ink color_down: c_ink color_focus: c_ink2
                        color_disabled: c_ink3 text_style: theme.font_regular{font_size: 11}}}
                Label{width: Fill text: "" draw_text.color: c_ink3}
            }
            RoundedView{width: Fill height: 30.0 flow: Right spacing: 8 draw_bg +: {color: c_card}
                Label{width: Fill text: "" draw_text.color: c_ink3}
                ButtonFlat{text: "清空事件库" height: 28.0 padding: Inset{left: 12 right: 12} on_click: || clear_all()
                    draw_bg +: {border_radius: 7.0 color: c_card color_hover: #xfdecec color_down: #xfdecec
                        color_focus: c_card border_size: 1.0 border_color: c_line2 border_color_focus: c_line2}
                    draw_text +: {color: #xb91c1c color_hover: #xb91c1c color_down: #xb91c1c color_focus: #xb91c1c}}
                ButtonFlat{text: "收起" height: 28.0 padding: Inset{left: 12 right: 12} on_click: || toggle_about()
                    draw_bg +: {border_radius: 7.0 color: c_ink color_hover: #x000000 color_down: #x333333
                        color_focus: c_ink border_size: 1.0 border_color: c_ink border_color_focus: c_ink}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
            }
        }
    }

    // ══ 主列表 .list{padding:0 20px 20px} ═══════════════════
    // ⚠️ height: Fit（不是 Fill）—— 整页由外层 ScrollYView 滚动，
    //    用 Fill 会让 makepad 的 Fill 分配在多兄弟场景下算错并让节点消失（实测）。
    // ══ 主列表 .list{padding:0 20px 20px} ═══════════════════
    // 外层已是 ScrollYView（整页滚动），所以 list 用 Fit 自然高度即可。
    // ⚠️ on_render 必须**必产出内容**（面板打开时给 0.5 占位），
    //    否则 `Fit` 零产出会让节点从布局树消失并扰乱兄弟布局（实测）。
    list := RoundedView{width: Fill height: Fit flow: Down
        draw_bg +: {color: c_paper}
        on_render: || {
            let dl = display_list()
            if about_open || import_open || tab != 0 {
                // 面板打开 / 切到别的分区时列表让位：给一个极矮占位，保证节点不消失
                RoundedView{width: Fill height: 0.5 draw_bg +: {color: c_paper}}
            } else if dl.len() == 0 {
                // .empty{padding:52px 20px;text-align:center;color:ink3}
                //   .big{34px;mono;opacity .28;margin-bottom:12px}  h3{14px ink2 500;mb 6px}
                //   p{12px;line-height 1.8}
                // 设计稿文案：
                //   还没有任何日程
                //   把其他日历导出的 .ics 文件内容
                //   粘贴进来，点「导入」即可
                // ⚠️ 不用 `align:` 容器（align 会接管子项排布、导致容器高度算不对，
                //    实测三个 Label 被压成 132px）。改成每行 width: Fill + Label.align 居中。
                RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 52 bottom: 40}
                    draw_bg +: {color: c_paper}
                    // ⚠️ 原设计稿是字符「◌」，但 font_code(LiberationMono) 无此字形 →
                    //    豆腐块。改用 draw_bg 画的空心圆环（透明填充 + 描边），完全等价且可靠。
                    RoundedView{width: Fill height: 46.0 flow: Right align: Align{x: 0.5 y: 0.0}
                        draw_bg +: {color: c_paper}
                        RoundedView{width: 36.0 height: 36.0 margin: Inset{top: 4}
                            draw_bg +: {color: #x0000 border_radius: 18.0 border_size: 2.0 border_color: c_line2}}
                    }
                    Label{width: Fill height: 22.0 text: "还没有任何日程" align: Align{x: 0.5 y: 0.0}
                        draw_text.color: c_ink2 draw_text.text_style: theme.font_bold{font_size: 14}}
                    Label{width: Fill height: 21.0 text: "把其他日历导出的 .ics 文件内容" align: Align{x: 0.5 y: 0.0}
                        draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 12}}
                    Label{width: Fill height: 21.0 text: "粘贴进来，点「导入」即可" align: Align{x: 0.5 y: 0.0}
                        draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 12}}
                }
            } else {
                // .list{padding:0 20px 20px}
                // ⭐ 容器一律 `height: Fit`（官方铁律 splash.md:8）。
                //    纠正一条先前写反的结论：**写死像素高度**才是把 Label 裁掉的原因
                //    （Label 在固定高容器里被压扁）；`Fit` 让高度按内容自然撑开。
                // 注意 font_code(LiberationMono) 无 CJK 字形，故时间列改用 font_regular。
                RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 bottom: 20}
                    draw_bg +: {color: c_paper}
                    for r in build_rows(dl) {
                        if r.t == "day" {
                            // .daygroup{margin-top:18px}
                            // .dayhead{gap:9px;padding-bottom:7px;border-bottom:1px line}
                            //    .dn{mono 12/600 ink}  .dw{11 ink3}  .dc{mono 10 ink3;margin-left:auto}
                            // 高度靠 Fit 自然撑开（官方 splash.md:8：容器一律 height: Fit）
                            RoundedView{width: Fill height: Fit flow: Right spacing: 9
                                align: Align{x: 0.0 y: 0.5} padding: Inset{top: 18 bottom: 7}
                                draw_bg +: {color: c_paper}
                                // ⚠️ r.dl 含中文（「10 月 4 日」）→ 不能用 font_code；r.cnt 含「项」同理。
                                Label{width: Fit text: r.dl align: Align{x: 0.0 y: 0.5} draw_text.color: c_ink
                                    draw_text.text_style: theme.font_bold{font_size: 12}}
                                Label{width: Fit text: r.wd align: Align{x: 0.0 y: 0.5} draw_text.color: c_ink3
                                    draw_text.text_style: theme.font_regular{font_size: 11}}
                                Label{width: Fill text: "" draw_text.color: c_ink3}
                                Label{width: Fit text: r.cnt align: Align{x: 1.0 y: 0.5} draw_text.color: c_ink3
                                    draw_text.text_style: theme.font_regular{font_size: 10}}
                            }
                            Hr{width: Fill height: 1.0 draw_bg +: {color: c_line}}
                        } else {
                            // .ev{gap:12px;padding:11px 0;border-bottom:1px line}
                            // 高度 = 11 + 44(内容) + 11
                            // ⭐ 官方铁律（makepad/splash.md:8）：
                            //    "Every container MUST have `height: Fit`"
                            //    之前给容器写死像素高度（44/56/68/90 试了 6 轮）→ 内部 Label
                            //    一律被裁（「11:00」和「@ 线上 · UTC」只露上半）。改 Fit 即解。
                            //    官方范例里 Label 也**从不**写 height，行高由 font_size 自然撑开。
                            RoundedView{width: Fill height: Fit flow: Right spacing: 12
                                align: Align{x: 0.0 y: 0.0} padding: Inset{top: 11 bottom: 11}
                                draw_bg +: {color: c_paper}
                                // .ev-flag{flex:0 0 3px;radius:2px;align-self:stretch}
                                //   Makepad 无 align-self；用固定高 + 顶部偏移近似「撑满」。
                                RoundedView{width: 3.0 height: 40.0 margin: Inset{top: 1}
                                    draw_bg +: {color: r.fc border_radius: 2.0}}
                                // .ev-time{flex:0 0 52px} —— 设计稿宽度
                                // ⚠️ 时间列**不能**用 font_code：全天事件的 r.tm 是「全天」（中文），
                                //    LiberationMono 无 CJK → 豆腐块。改用 font_regular（含 CJK）。
                                RoundedView{width: 52.0 height: Fit flow: Down
                                    draw_bg +: {color: c_paper}
                                    // 字号按设计稿 .ev-time（11.5px）/ .end（10.5px）取整。
                                    // 「10:00」在 11px 下实测约 49.5px < 52px ✓ 不会裁。
                                    Label{width: Fill text: r.tm align: Align{x: 0.0 y: 0.0}
                                        draw_text.color: c_ink2 draw_text.text_style: theme.font_regular{font_size: 11}}
                                    if r.te != "" {
                                        Label{width: Fill text: r.te align: Align{x: 0.0 y: 0.0}
                                            draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 10}}
                                    }
                                }
                                // .ev-body{flex:1}
                                RoundedView{width: Fill height: Fit flow: Down spacing: 2
                                    draw_bg +: {color: c_paper}
                                    // .ev-title{13.5px ink;line-height 1.4}
                                    Label{width: Fill text: r.sm align: Align{x: 0.0 y: 0.0}
                                        draw_text.color: c_ink draw_text.text_style: theme.font_regular{font_size: 14}}
                                    // .ev-meta{11px ink3;margin-top:2px;gap:10px;flex-wrap:wrap}
                                    //   ⚠️ Splash 的 Flow 枚举**没有** Wrap 变体（实测
                                    //     `flow: RightWrap` 报 variable RightWrap not found），
                                    //     故用 `Right`，并靠收紧宽度让内容自己不溢出。
                                    RoundedView{width: Fill height: Fit flow: Right spacing: 10
                                        draw_bg +: {color: c_paper}
                                        for m in r.mi {
                                            if m.tag {
                                                // .tag{mono 9.5px;paper bg;line border;radius 4;padding:1.5px 6px}
                                                RoundedView{width: Fit height: Fit flow: Right align: Align{x: 0.5 y: 0.5}
                                                    padding: Inset{left: 6 right: 6 top: 1 bottom: 1}
                                                    draw_bg +: {color: c_paper border_radius: 4.0 border_size: 1.0 border_color: c_line}
                                                    // 按段选字体：`VALUE=DATE` 走 font_code（贴设计稿的 mono），
                                                    // 重复规则的中文标签（「每周」）必须 font_regular ——
                                                    // LiberationMono 无 CJK 字形，会渲染成豆腐块。
                                                    for s in m.segs {
                                                        if s.mono {
                                                            Label{width: Fit text: s.v align: Align{x: 0.5 y: 0.5}
                                                                draw_text.color: c_ink3 draw_text.text_style: theme.font_code{font_size: 9.5}}
                                                        } else {
                                                            Label{width: Fit text: s.v align: Align{x: 0.5 y: 0.5}
                                                                draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 9.5}}
                                                        }
                                                    }
                                                }
                                            } else {
                                                // .m{inline-flex;gap:4px}  .m i{mono 10px}
                                                RoundedView{width: Fit height: Fit flow: Right spacing: 4 align: Align{x: 0.0 y: 0.5}
                                                    draw_bg +: {color: c_paper}
                                                    // 字号 9.0 而非设计稿的 11：宿主字体比浏览器宽很多
                                                    // （font_code≈0.8em / font_regular≈0.9em，中文≈1.35em；
                                                    //  浏览器约 0.5em）。正文区可用 ≈287px，11px 下这一行
                                                    // 要 300+px，尾部「Asia/Shanghai」会被裁。
                                                    // 等比例缩字号是失真最小的适配：间距/颜色/层次全保留。
                                                    if m.ic != "" {
                                                        Label{width: Fit text: m.ic align: Align{x: 0.0 y: 0.5}
                                                            draw_text.color: c_ink3 draw_text.text_style: theme.font_code{font_size: 9.0}}
                                                    }
                                                    // 按段选字体：ASCII 段窄、中文段宽 —— 见 loc_segs 注释
                                                    for s in m.segs {
                                                        if s.mono {
                                                            Label{width: Fit text: s.v align: Align{x: 0.0 y: 0.5}
                                                                draw_text.color: c_ink3 draw_text.text_style: theme.font_code{font_size: 9.0}}
                                                        } else {
                                                            Label{width: Fit text: s.v align: Align{x: 0.0 y: 0.5}
                                                                draw_text.color: c_ink3 draw_text.text_style: theme.font_regular{font_size: 9.0}}
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Hr{width: Fill height: 1.0 draw_bg +: {color: c_line}}
                        }
                    }
                }
            }
        }
    }
}
}
